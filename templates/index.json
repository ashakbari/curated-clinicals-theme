        "custom_liquid": "<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Sans:wght@0,300;0,400;0,500&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .cc-trust {\n    background: #f5f2eb;\n    border-top: 1px solid rgba(201,168,76,0.18);\n    border-bottom: 1px solid rgba(201,168,76,0.18);\n    padding: 0;\n  }\n\n  .cc-trust__inner {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    max-width: 1320px;\n    margin: 0 auto;\n  }\n\n  .cc-trust__item {\n    display: flex;\n    align-items: center;\n    gap: 1rem;\n    padding: 1.6rem 2rem;\n    position: relative;\n    transition: background 0.3s ease;\n  }\n\n    .cc-trust__item + .cc-trust__item::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    top: 25%;\n    height: 50%;\n    width: 1px;\n    background: rgba(201,168,76,0.22);\n  }\n\n  .cc-trust__icon {\n    flex-shrink: 0;\n    width: 32px;\n    height: 32px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    opacity: 0.65;\n  }\n\n  .cc-trust__icon svg {\n    width: 22px;\n    height: 22px;\n    stroke: #a8893d;\n    fill: none;\n    stroke-width: 1.4;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .cc-trust__text {\n    display: flex;\n    flex-direction: column;\n    gap: 0.18rem;\n  }\n\n  .cc-trust__label {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 0.7rem;\n    font-weight: 500;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: #3a3530;\n  }\n\n  .cc-trust__sub {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    font-size: 0.85rem;\n    font-weight: 300;\n    font-style: italic;\n    color: #8a7f72;\n    line-height: 1.3;\n  }\n\n    @media (max-width: 900px) {\n    .cc-trust__inner {\n      grid-template-columns: repeat(2, 1fr);\n    }\n\n        .cc-trust__item + .cc-trust__item::before {\n      display: none;\n    }\n\n    .cc-trust__item:nth-child(2n)::before {\n      display: block;\n    }\n\n        .cc-trust__item:nth-child(3),\n    .cc-trust__item:nth-child(4) {\n      border-top: 1px solid rgba(201,168,76,0.18);\n    }\n  }\n\n    @media (max-width: 520px) {\n    .cc-trust__inner {\n      grid-template-columns: 1fr;\n    }\n\n    .cc-trust__item + .cc-trust__item {\n      border-top: 1px solid rgba(201,168,76,0.15);\n    }\n\n    .cc-trust__item:nth-child(2n)::before { display: none; }\n\n    .cc-trust__item {\n      padding: 1.2rem 1.5rem;\n    }\n  }\n</style>\n\n<section class=\"cc-trust\">\n  <div class=\"cc-trust__inner\">\n\n    <div class=\"cc-trust__item\">\n      <div class=\"cc-trust__icon\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n        </svg>\n      </div>\n      <div class=\"cc-trust__text\">\n        <span class=\"cc-trust__label\">Genuine Products</span>\n        <span class=\"cc-trust__sub\">Sourced through our distributors</span>\n      </div>\n    </div>\n\n    <div class=\"cc-trust__item\">\n      <div class=\"cc-trust__icon\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n        </svg>\n      </div>\n      <div class=\"cc-trust__text\">\n        <span class=\"cc-trust__label\">Free Shipping</span>\n        <span class=\"cc-trust__sub\">On all orders over $150</span>\n      </div>\n    </div>\n\n    <div class=\"cc-trust__item\">\n      <div class=\"cc-trust__icon\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M9 12l2 2 4-4\"/>\n          <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n        </svg>\n      </div>\n      <div class=\"cc-trust__text\">\n        <span class=\"cc-trust__label\">Sealed &amp; Authentic</span>\n        <span class=\"cc-trust__sub\">Genuine, properly stored stock</span>\n      </div>\n    </div>\n\n    <div class=\"cc-trust__item\">\n      <div class=\"cc-trust__icon\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n        </svg>\n      </div>\n      <div class=\"cc-trust__text\">\n        <span class=\"cc-trust__label\">Clinical-Grade Only</span>\n        <span class=\"cc-trust__sub\">No filler brands, ever</span>\n      </div>\n    </div>\n\n  </div>\n</section>",
