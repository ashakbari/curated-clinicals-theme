        "custom_liquid": "{% comment %}\n  ============================================================================\n  HOMEPAGE LOWER, Luxury Brand Ticker + Featured Product\n  ============================================================================\n{% endcomment %}\n\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .cc-lower *, .cc-lower *::before, .cc-lower *::after { box-sizing: border-box; margin: 0; padding: 0; }\n  .cc-lower {\n    --gold: #c9a84c;\n    --gold-light: #d4ba6a;\n    --gold-dark: #a8893d;\n    --ink: #0e0e0e;\n    --ink-soft: #3a3a3a;\n    --ink-muted: #6b6b6b;\n    --paper: #fdfcf9;\n    --surface: #f5f2eb;\n    --border: #e0dbd2;\n    --ff-display: 'Cormorant Garamond', 'Georgia', serif;\n    --ff-body: 'DM Sans', 'Helvetica Neue', sans-serif;\n    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);\n    --ease-quart: cubic-bezier(0.25, 1, 0.5, 1);\n    font-family: var(--ff-body);\n    color: var(--ink);\n    line-height: 1.5;\n  }\n  .cc-lower img { display: block; max-width: 100%; }\n  .cc-lower a { text-decoration: none; color: inherit; }\n\n  /* Scroll reveal */\n  .cc-rv {\n    opacity: 0; transform: translateY(22px);\n    transition: opacity .8s var(--ease-expo), transform .8s var(--ease-expo);\n  }\n  .cc-rv.is-vis { opacity: 1; transform: translateY(0); }\n\n\n  /* =========================================================\n     BRAND TICKER\n     ========================================================= */\n  .cc-ticker {\n    position: relative;\n    background: #0a0907;\n    height: 56px;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    border-top: 1px solid rgba(201,168,76,0.18);\n    border-bottom: 1px solid rgba(201,168,76,0.18);\n  }\n\n  /* Fade vignette edges */\n  .cc-ticker::before,\n  .cc-ticker::after {\n    content: '';\n    position: absolute;\n    top: 0; bottom: 0;\n    width: clamp(60px, 8vw, 130px);\n    z-index: 2;\n    pointer-events: none;\n  }\n  .cc-ticker::before {\n    left: 0;\n    background: linear-gradient(to right, #0a0907 20%, transparent 100%);\n  }\n  .cc-ticker::after {\n    right: 0;\n    background: linear-gradient(to left, #0a0907 20%, transparent 100%);\n  }\n\n  .cc-ticker__track {\n    display: flex;\n    width: max-content;\n    align-items: center;\n    height: 100%;\n    animation: ccTickerScroll 55s linear infinite;\n  }\n\n  .cc-ticker__group {\n    display: flex;\n    align-items: center;\n  }\n\n  .cc-ticker__item {\n    display: flex;\n    align-items: center;\n    gap: 2rem;\n    padding: 0 2.4rem;\n    height: 56px;\n    white-space: nowrap;\n    user-select: none;\n    position: relative;\n  }\n\n  /* Gold rule separator */\n  .cc-ticker__item::after {\n    content: '';\n    position: absolute;\n    right: 0;\n    top: 50%;\n    transform: translateY(-50%);\n    width: 1px;\n    height: 16px;\n    background: rgba(201,168,76,0.3);\n    flex-shrink: 0;\n  }\n\n  .cc-ticker__name {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    font-size: 0.88rem;\n    font-weight: 400;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: rgba(253,252,249,0.5);\n    transition: color 0.3s ease;\n  }\n\n  /* Subtle gold dot accent before name */\n  .cc-ticker__dot {\n    width: 3px;\n    height: 3px;\n    border-radius: 50%;\n    background: var(--gold);\n    opacity: 0.5;\n    flex-shrink: 0;\n  }\n\n  @keyframes ccTickerScroll {\n    from { transform: translateX(0); }\n    to   { transform: translateX(-50%); }\n  }\n\n\n  /* =========================================================\n     FEATURED PRODUCT\n     ========================================================= */\n  .cc-featured-product {\n    position: relative;\n    width: 100%;\n    min-height: 600px;\n    overflow: hidden;\n    background: var(--ink);\n  }\n\n  .cc-fp__bg {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n  }\n\n  .cc-fp__bg img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: 70% center;\n  }\n\n  /* Left dark fade, keeps product image visible on right */\n  .cc-fp__bg::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(\n      to right,\n      rgba(14,14,14,0.97) 0%,\n      rgba(14,14,14,0.90) 22%,\n      rgba(14,14,14,0.66) 46%,\n      rgba(14,14,14,0.22) 70%,\n      transparent 100%\n    );\n    z-index: 2;\n  }\n\n  /* Subtle gold warmth overlay */\n  .cc-fp__bg::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(135deg, rgba(201,168,76,0.06) 0%, transparent 55%);\n    z-index: 3;\n    pointer-events: none;\n  }\n\n  /* Grain texture */\n  .cc-fp__grain {\n    position: absolute;\n    inset: 0;\n    z-index: 4;\n    pointer-events: none;\n    opacity: 0.03;\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E\");\n    background-size: 200px;\n  }\n\n  .cc-fp__inner {\n    position: relative;\n    z-index: 5;\n    max-width: 1320px;\n    margin: 0 auto;\n    padding: clamp(3.5rem, 7vw, 5.5rem) clamp(2rem, 5vw, 5rem);\n    display: flex;\n    align-items: center;\n    min-height: 600px;\n  }\n\n  .cc-fp__content { max-width: 560px; }\n\n  /* Thin gold rule above eyebrow */\n  .cc-fp__rule {\n    width: 32px;\n    height: 1px;\n    background: var(--gold);\n    margin-bottom: 1.1rem;\n    opacity: 0.7;\n  }\n\n  .cc-fp__eyebrow {\n    font-family: var(--ff-body);\n    font-size: 0.62rem;\n    font-weight: 500;\n    letter-spacing: 0.38em;\n    text-transform: uppercase;\n    color: var(--gold);\n    margin-bottom: 1rem;\n  }\n\n  .cc-fp__name {\n    font-family: var(--ff-display);\n    font-weight: 300;\n    font-size: clamp(2.6rem, 4.8vw, 4.2rem);\n    line-height: 0.96;\n    color: var(--paper);\n    margin-bottom: 0.5rem;\n    letter-spacing: -0.01em;\n  }\n  .cc-fp__name em {\n    font-style: italic;\n    font-weight: 400;\n    color: var(--gold-light);\n  }\n\n  .cc-fp__brand {\n    font-family: var(--ff-body);\n    font-size: 0.68rem;\n    font-weight: 400;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: rgba(253,252,249,0.38);\n    margin-bottom: 1.6rem;\n  }\n\n  .cc-fp__desc {\n    font-family: var(--ff-body);\n    font-size: 0.88rem;\n    font-weight: 300;\n    line-height: 1.9;\n    color: rgba(253,252,249,0.65);\n    margin-bottom: 2rem;\n    max-width: 480px;\n  }\n\n  /* Stat cards */\n  .cc-fp__stats {\n    display: flex;\n    gap: 0.65rem;\n    flex-wrap: wrap;\n    margin-bottom: 1.8rem;\n  }\n  .cc-fp__stat {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 1.1rem 1.2rem;\n    min-width: 130px;\n    background: rgba(253,252,249,0.06);\n    border: 1px solid rgba(201,168,76,0.2);\n    backdrop-filter: blur(10px);\n    -webkit-backdrop-filter: blur(10px);\n    position: relative;\n    overflow: hidden;\n  }\n\n  /* Corner accent on stat cards */\n  .cc-fp__stat::before {\n    content: '';\n    position: absolute;\n    top: 0; left: 0;\n    width: 14px; height: 1px;\n    background: var(--gold);\n    opacity: 0.6;\n  }\n  .cc-fp__stat::after {\n    content: '';\n    position: absolute;\n    top: 0; left: 0;\n    width: 1px; height: 14px;\n    background: var(--gold);\n    opacity: 0.6;\n  }\n\n  .cc-fp__stat-num {\n    font-family: var(--ff-display);\n    font-size: 2rem;\n    font-weight: 300;\n    color: var(--gold-light);\n    line-height: 1;\n    margin-bottom: 0.35rem;\n    letter-spacing: -0.02em;\n  }\n  .cc-fp__stat-label {\n    font-family: var(--ff-body);\n    font-size: 0.55rem;\n    font-weight: 400;\n    letter-spacing: 0.13em;\n    text-transform: uppercase;\n    color: rgba(253,252,249,0.5);\n    text-align: center;\n    line-height: 1.5;\n  }\n\n  /* Ingredients */\n  .cc-fp__ingredients {\n    display: flex;\n    flex-direction: column;\n    gap: 0.7rem;\n    margin-bottom: 1.8rem;\n    padding-left: 0;\n  }\n  .cc-fp__ingredient {\n    display: flex;\n    align-items: flex-start;\n    gap: 0.8rem;\n  }\n  .cc-fp__ingredient-dot {\n    width: 1px;\n    height: 100%;\n    min-height: 18px;\n    background: var(--gold);\n    opacity: 0.4;\n    flex-shrink: 0;\n    margin-top: 5px;\n    align-self: stretch;\n  }\n  .cc-fp__ingredient-text {\n    font-family: var(--ff-body);\n    font-size: 0.78rem;\n    font-weight: 300;\n    color: rgba(253,252,249,0.6);\n    line-height: 1.6;\n  }\n  .cc-fp__ingredient-text strong {\n    font-weight: 500;\n    color: rgba(253,252,249,0.88);\n  }\n\n  /* Price */\n  .cc-fp__price-wrap {\n    display: flex;\n    align-items: baseline;\n    gap: 1rem;\n    flex-wrap: wrap;\n    margin-bottom: 0.6rem;\n  }\n  .cc-fp__price-current {\n    font-family: var(--ff-display);\n    font-size: clamp(2.2rem, 3vw, 2.8rem);\n    font-weight: 300;\n    line-height: 1;\n    color: var(--paper);\n    letter-spacing: -0.01em;\n  }\n  .cc-fp__price-compare {\n    font-family: var(--ff-display);\n    font-size: 1.6rem;\n    font-weight: 300;\n    line-height: 1;\n    color: rgba(253,252,249,0.35);\n    text-decoration: line-through;\n    text-decoration-color: rgba(253,252,249,0.25);\n  }\n  .cc-fp__price-save {\n    display: inline-flex;\n    align-items: center;\n    padding: 0.28rem 0.65rem;\n    background: rgba(201,168,76,0.12);\n    border: 1px solid rgba(201,168,76,0.28);\n    color: var(--gold-light);\n    font-family: var(--ff-body);\n    font-size: 0.58rem;\n    font-weight: 500;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n  .cc-fp__price-meta {\n    display: flex;\n    align-items: center;\n    gap: 1rem;\n    flex-wrap: wrap;\n    margin-bottom: 2rem;\n  }\n  .cc-fp__price-size {\n    font-family: var(--ff-body);\n    font-size: 0.65rem;\n    font-weight: 400;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: rgba(253,252,249,0.35);\n  }\n  .cc-fp__price-note {\n    font-family: var(--ff-body);\n    font-size: 0.7rem;\n    font-weight: 400;\n    color: rgba(253,252,249,0.55);\n  }\n\n  /* CTA */\n  .cc-fp__actions {\n    display: flex;\n    align-items: center;\n    gap: 1rem;\n    flex-wrap: wrap;\n    margin-bottom: 2rem;\n  }\n  .cc-fp__btn {\n    display: inline-block;\n    font-family: var(--ff-body);\n    font-size: 0.65rem;\n    font-weight: 500;\n    letter-spacing: 0.26em;\n    text-transform: uppercase;\n    padding: 1.05rem 2.6rem;\n    background: var(--gold);\n    color: var(--ink);\n    border: none;\n    cursor: pointer;\n    transition: all 0.3s var(--ease-quart);\n  }\n  .cc-fp__btn:hover {\n    background: var(--gold-light);\n    transform: translateY(-1px);\n    box-shadow: 0 6px 28px rgba(201,168,76,0.22);\n  }\n\n  /* Review block */\n  .cc-fp__reviews {\n    display: flex;\n    flex-direction: column;\n    gap: 0.65rem;\n    max-width: 520px;\n  }\n  .cc-fp__review {\n    padding: 0.9rem 1.1rem 0.9rem 1.2rem;\n    background: rgba(255,255,255,0.05);\n    border-left: 1px solid rgba(201,168,76,0.35);\n  }\n  .cc-fp__review-label {\n    display: block;\n    font-family: var(--ff-body);\n    font-size: 0.55rem;\n    font-weight: 600;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: var(--gold);\n    margin-bottom: 0.3rem;\n    opacity: 0.8;\n  }\n  .cc-fp__review-text {\n    font-family: var(--ff-body);\n    font-size: 0.76rem;\n    font-weight: 300;\n    line-height: 1.6;\n    color: rgba(253,252,249,0.78);\n    font-style: italic;\n  }\n\n\n  /* =========================================================\n     RESPONSIVE\n     ========================================================= */\n  @media (max-width: 1024px) {\n    .cc-fp__content { max-width: 480px; }\n    .cc-fp__bg img { object-position: 75% center; }\n  }\n\n  @media (max-width: 768px) {\n    .cc-featured-product { min-height: auto; }\n\n    .cc-fp__bg {\n      position: relative;\n      height: 50vh;\n      max-height: 400px;\n    }\n\n    .cc-fp__bg::after {\n      background: linear-gradient(\n        to bottom,\n        transparent 20%,\n        rgba(14,14,14,0.7) 65%,\n        rgba(14,14,14,1) 100%\n      );\n    }\n\n    .cc-fp__bg img { object-position: center center; }\n\n    .cc-fp__inner {\n      min-height: auto;\n      padding: 0 1.5rem 3rem;\n      margin-top: -3rem;\n    }\n\n    .cc-fp__content { max-width: 100%; }\n\n    .cc-fp__stat {\n      min-width: 0;\n      flex: 1 1 calc(33.333% - 0.65rem);\n      padding: 0.85rem 0.6rem;\n    }\n  }\n\n  @media (max-width: 520px) {\n    .cc-fp__stat { flex: 1 1 calc(50% - 0.65rem); }\n    .cc-fp__price-save { transform: none; }\n  }\n\n  @media (max-width: 420px) {\n    .cc-fp__actions { flex-direction: column; align-items: stretch; }\n    .cc-fp__btn { text-align: center; }\n  }\n</style>\n\n\n<div class=\"cc-lower\">\n\n  <!-- ═══════════ BRAND TICKER ═══════════ -->\n  <section class=\"cc-ticker\" aria-hidden=\"true\">\n    <div class=\"cc-ticker__track\">\n      {% for i in (1..2) %}\n      <div class=\"cc-ticker__group\">\n\n        <div class=\"cc-ticker__item\">\n          <span class=\"cc-ticker__dot\"></span>\n          <span class=\"cc-ticker__name\">SkinCeuticals</span>\n        </div>\n        <div class=\"cc-ticker__item\">\n          <span class=\"cc-ticker__dot\"></span>\n          <span class=\"cc-ticker__name\">ZO Skin Health</span>\n        </div>\n        <div class=\"cc-ticker__item\">\n          <span class=\"cc-ticker__dot\"></span>\n          <span class=\"cc-ticker__name\">Skinbetter Science</span>\n        </div>\n        <div class=\"cc-ticker__item\">\n          <span class=\"cc-ticker__dot\"></span>\n          <span class=\"cc-ticker__name\">SkinMedica</span>\n        </div>\n        <div class=\"cc-ticker__item\">\n          <span class=\"cc-ticker__dot\"></span>\n          <span class=\"cc-ticker__name\">Alastin Skincare</span>\n        </div>\n        <div class=\"cc-ticker__item\">\n          <span class=\"cc-ticker__dot\"></span>\n          <span class=\"cc-ticker__name\">Colorescience</span>\n        </div>\n        <div class=\"cc-ticker__item\">\n          <span class=\"cc-ticker__dot\"></span>\n          <span class=\"cc-ticker__name\">Hydrinity</span>\n        </div>\n        <div class=\"cc-ticker__item\">\n          <span class=\"cc-ticker__dot\"></span>\n          <span class=\"cc-ticker__name\">Omnilux</span>\n        </div>\n\n      </div>\n      {% endfor %}\n    </div>\n  </section>\n\n\n  <!-- ═══════════ FEATURED PRODUCT ═══════════ -->\n  <section class=\"cc-featured-product\">\n    <div class=\"cc-fp__bg\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0785/2530/0958/files/Untitled_design_1.png?v=1775022516\"\n        alt=\"ZO Skin Health Growth Factor Serum\"\n        loading=\"lazy\"\n      >\n    </div>\n    <div class=\"cc-fp__grain\"></div>\n\n    <div class=\"cc-fp__inner\">\n      <div class=\"cc-fp__content cc-rv\">\n\n        <div class=\"cc-fp__rule\"></div>\n        <p class=\"cc-fp__eyebrow\">Most Popular</p>\n        <h2 class=\"cc-fp__name\">Growth Factor <em>Serum</em></h2>\n        <p class=\"cc-fp__brand\">ZO Skin Health</p>\n\n        <p class=\"cc-fp__desc\">A lightweight gel combining plant and enzymatically derived growth factors with ZO's exclusive ZPRO complex. Formulated to support the appearance of firmer skin and the look of smoother fine lines over time.</p>\n\n        <div class=\"cc-fp__stats\">\n          <div class=\"cc-fp__stat\">\n            <span class=\"cc-fp__stat-num\">93%</span>\n            <span class=\"cc-fp__stat-label\">Saw improvement in<br>fine lines &amp; wrinkles</span>\n          </div>\n          <div class=\"cc-fp__stat\">\n            <span class=\"cc-fp__stat-num\">12</span>\n            <span class=\"cc-fp__stat-label\">Week clinical<br>study period</span>\n          </div>\n          <div class=\"cc-fp__stat\">\n            <span class=\"cc-fp__stat-num\">All</span>\n            <span class=\"cc-fp__stat-label\">Skin types<br>including sensitive</span>\n          </div>\n        </div>\n\n        <p style=\"font-family:var(--ff-body);font-size:0.6rem;color:rgba(253,252,249,0.42);margin:-0.8rem 0 1.6rem;letter-spacing:0.04em;line-height:1.5;\">Clinical figures are from ZO Skin Health manufacturer studies.</p>\n\n        <div class=\"cc-fp__ingredients\">\n          <div class=\"cc-fp__ingredient\">\n            <div class=\"cc-fp__ingredient-dot\"></div>\n            <span class=\"cc-fp__ingredient-text\"><strong>ZPRO Complex</strong>, supports the look of plump, hydrated skin</span>\n          </div>\n          <div class=\"cc-fp__ingredient\">\n            <div class=\"cc-fp__ingredient-dot\"></div>\n            <span class=\"cc-fp__ingredient-text\"><strong>Fermented Red Ginseng</strong>, helps skin look hydrated and supple</span>\n          </div>\n          <div class=\"cc-fp__ingredient\">\n            <div class=\"cc-fp__ingredient-dot\"></div>\n            <span class=\"cc-fp__ingredient-text\"><strong>Beta-Glucan</strong>, calms and soothes for all skin types</span>\n          </div>\n        </div>\n\n        <div class=\"cc-fp__price-wrap\">\n          <span class=\"cc-fp__price-current\">$187.00</span>\n          <span class=\"cc-fp__price-compare\">$220.00</span>\n          <span class=\"cc-fp__price-save\">15% Off</span>\n        </div>\n\n        <div class=\"cc-fp__price-meta\">\n          <span class=\"cc-fp__price-size\">30 mL / 1 Fl. Oz.</span>\n          <span class=\"cc-fp__price-note\">In stock · ships in 1–2 business days</span>\n        </div>\n\n        <div class=\"cc-fp__actions\">\n          <a href=\"/products/zo-growth-factor-serum\" class=\"cc-fp__btn\">Shop Now</a>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n</div>\n\n<script>\n(function(){\n  var els = document.querySelectorAll('.cc-lower .cc-rv');\n  if (!els.length) return;\n  if ('IntersectionObserver' in window) {\n    var io = new IntersectionObserver(function(entries) {\n      entries.forEach(function(e) {\n        if (e.isIntersecting) {\n          e.target.classList.add('is-vis');\n          io.unobserve(e.target);\n        }\n      });\n    }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });\n    els.forEach(function(el) { io.observe(el); });\n  } else {\n    els.forEach(function(el) { el.classList.add('is-vis'); });\n  }\n})();\n</script>",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "custom_liquid_GwHtP6": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  Trust Strip, paste between the dark ZO section and the light TNS section.\n  Sits on --surface tone, bridging dark above and light below.\n{% endcomment %}\n\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Sans:wght@0,300;0,400;0,500&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .cc-trust {\n    background: #f5f2eb;\n    border-top: 1px solid rgba(201,168,76,0.18);\n    border-bottom: 1px solid rgba(201,168,76,0.18);\n    padding: 0;\n  }\n\n  .cc-trust__inner {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    max-width: 1320px;\n    margin: 0 auto;\n  }\n\n  .cc-trust__item {\n    display: flex;\n    align-items: center;\n    gap: 1rem;\n    padding: 1.6rem 2rem;\n    position: relative;\n    transition: background 0.3s ease;\n  }\n\n  /* Vertical rule between items */\n  .cc-trust__item + .cc-trust__item::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    top: 25%;\n    height: 50%;\n    width: 1px;\n    background: rgba(201,168,76,0.22);\n  }\n\n  .cc-trust__icon {\n    flex-shrink: 0;\n    width: 32px;\n    height: 32px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    opacity: 0.65;\n  }\n\n  .cc-trust__icon svg {\n    width: 22px;\n    height: 22px;\n    stroke: #a8893d;\n    fill: none;\n    stroke-width: 1.4;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .cc-trust__text {\n    display: flex;\n    flex-direction: column;\n    gap: 0.18rem;\n  }\n\n  .cc-trust__label {\n    font-family: 'DM Sans', sans-serif;\n    font-size: 0.7rem;\n    font-weight: 500;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: #3a3530;\n  }\n\n  .cc-trust__sub {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    font-size: 0.85rem;\n    font-weight: 300;\n    font-style: italic;\n    color: #8a7f72;\n    line-height: 1.3;\n  }\n\n  /* Tablet: 2 cols */\n  @media (max-width: 900px) {\n    .cc-trust__inner {\n      grid-template-columns: repeat(2, 1fr);\n    }\n\n    /* Reset vertical dividers and re-add for 2-col */\n    .cc-trust__item + .cc-trust__item::before {\n      display: none;\n    }\n\n    .cc-trust__item:nth-child(2n)::before {\n      display: block;\n    }\n\n    /* Horizontal rule between rows */\n    .cc-trust__item:nth-child(3),\n    .cc-trust__item:nth-child(4) {\n      border-top: 1px solid rgba(201,168,76,0.18);\n    }\n  }\n\n  /* Mobile: stacked, hide and just show ticker-style */\n  @media (max-width: 520px) {\n    .cc-trust__inner {\n      grid-template-columns: 1fr;\n    }\n\n    .cc-trust__item + .cc-trust__item {\n      border-top: 1px solid rgba(201,168,76,0.15);\n    }\n\n    .cc-trust__item:nth-child(2n)::before { display: none; }\n\n    .cc-trust__item {\n      padding: 1.2rem 1.5rem;\n    }\n  }\n</style>\n\n<section class=\"cc-trust\">\n  <div class=\"cc-trust__inner\">\n\n    <div class=\"cc-trust__item\">\n      <div class=\"cc-trust__icon\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n        </svg>\n      </div>\n      <div class=\"cc-trust__text\">\n        <span class=\"cc-trust__label\">Genuine Products</span>\n        <span class=\"cc-trust__sub\">Sourced through our distributors</span>\n      </div>\n    </div>\n\n    <div class=\"cc-trust__item\">\n      <div class=\"cc-trust__icon\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n        </svg>\n      </div>\n      <div class=\"cc-trust__text\">\n        <span class=\"cc-trust__label\">Free Shipping</span>\n        <span class=\"cc-trust__sub\">On all orders over $150</span>\n      </div>\n    </div>\n\n    <div class=\"cc-trust__item\">\n      <div class=\"cc-trust__icon\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M9 12l2 2 4-4\"/>\n          <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n        </svg>\n      </div>\n      <div class=\"cc-trust__text\">\n        <span class=\"cc-trust__label\">Sealed &amp; Authentic</span>\n        <span class=\"cc-trust__sub\">Genuine, properly stored stock</span>\n      </div>\n    </div>\n\n    <div class=\"cc-trust__item\">\n      <div class=\"cc-trust__icon\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n        </svg>\n      </div>\n      <div class=\"cc-trust__text\">\n        <span class=\"cc-trust__label\">Clinical-Grade Only</span>\n        <span class=\"cc-trust__sub\">No filler brands, ever</span>\n      </div>\n    </div>\n\n  </div>\n</section>",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
