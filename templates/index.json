    "custom_liquid_mrAbwB": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  ============================================================================\n  FEATURED PRODUCT SECTION - SkinMedica TNS Advanced+ Serum\n  Paste into a Custom Liquid section\n  Swap the product URL if your handle is different\n  ============================================================================\n{% endcomment %}\n\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .cc-tns *, .cc-tns *::before, .cc-tns *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n  .cc-tns {\n    --gold: #c9a84c;\n    --gold-light: #d8bf72;\n    --gold-dark: #a8872e;\n    --ink: #111111;\n    --ink-soft: #404040;\n    --ink-muted: #6f6f6f;\n    --paper: #fbfaf8;\n    --paper-strong: rgba(255,255,255,0.88);\n    --paper-soft: rgba(255,255,255,0.72);\n    --border: rgba(17,17,17,0.08);\n    --shadow: 0 24px 60px rgba(0,0,0,0.12);\n    --ff-display: 'Cormorant Garamond', 'Georgia', serif;\n    --ff-body: 'DM Sans', 'Helvetica Neue', sans-serif;\n    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);\n    font-family: var(--ff-body);\n    width: 100%;\n    overflow: hidden;\n    background: #f6f4f1;\n    color: var(--ink);\n  }\n\n  .cc-tns img {\n    display: block;\n    max-width: 100%;\n  }\n\n  .cc-tns a {\n    color: inherit;\n    text-decoration: none;\n  }\n\n  .cc-tns-feature {\n    position: relative;\n    min-height: 760px;\n    isolation: isolate;\n  }\n\n  .cc-tns__bg {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n  }\n\n  .cc-tns__bg img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center center;\n  }\n\n  /* Keep the product area in the middle bright and clean */\n  .cc-tns__bg::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(\n        to right,\n        rgba(255,255,255,0.96) 0%,\n        rgba(255,255,255,0.84) 16%,\n        rgba(255,255,255,0.36) 30%,\n        rgba(255,255,255,0.08) 39%,\n        rgba(255,255,255,0) 49%\n      );\n    z-index: 2;\n    pointer-events: none;\n  }\n\n  .cc-tns__bg::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(\n        to top,\n        rgba(255,255,255,0.62) 0%,\n        rgba(255,255,255,0.20) 14%,\n        rgba(255,255,255,0.03) 24%,\n        rgba(255,255,255,0) 34%\n      );\n    z-index: 3;\n    pointer-events: none;\n  }\n\n  .cc-tns__inner {\n    position: relative;\n    z-index: 4;\n    max-width: 1440px;\n    min-height: 760px;\n    margin: 0 auto;\n    padding: clamp(2rem, 4vw, 3rem);\n    display: flex;\n    align-items: center;\n  }\n\n  .cc-tns__panel {\n    width: min(100%, 540px);\n    padding: clamp(1.4rem, 2vw, 1.9rem);\n    background: rgba(255,255,255,0.64);\n    border: 1px solid rgba(255,255,255,0.55);\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n    box-shadow: var(--shadow);\n  }\n\n  .cc-tns__eyebrow {\n    font-family: var(--ff-body);\n    font-size: 0.68rem;\n    font-weight: 600;\n    letter-spacing: 0.34em;\n    text-transform: uppercase;\n    color: var(--gold-dark);\n    margin-bottom: 0.85rem;\n  }\n\n  .cc-tns__title {\n    font-family: var(--ff-display);\n    font-size: clamp(2.6rem, 4.6vw, 4.2rem);\n    font-weight: 300;\n    line-height: 0.95;\n    letter-spacing: -0.01em;\n    color: var(--ink);\n    margin-bottom: 0.45rem;\n    text-wrap: balance;\n  }\n\n  .cc-tns__title em {\n    font-style: italic;\n    font-weight: 400;\n    color: var(--gold-dark);\n  }\n\n  .cc-tns__brand {\n    font-family: var(--ff-body);\n    font-size: 0.76rem;\n    font-weight: 600;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: rgba(17,17,17,0.52);\n    margin-bottom: 1.15rem;\n  }\n\n  .cc-tns__claim {\n    padding: 1rem 1rem 1.05rem;\n    background: rgba(255,255,255,0.78);\n    border: 1px solid rgba(17,17,17,0.08);\n    margin-bottom: 1.15rem;\n  }\n\n  .cc-tns__claim-kicker {\n    display: block;\n    font-family: var(--ff-body);\n    font-size: 0.62rem;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: var(--gold-dark);\n    margin-bottom: 0.45rem;\n  }\n\n  .cc-tns__claim-main {\n    font-family: var(--ff-display);\n    font-size: clamp(1.7rem, 2.7vw, 2.4rem);\n    font-weight: 500;\n    line-height: 1.02;\n    color: var(--ink);\n    margin-bottom: 0.3rem;\n    text-wrap: balance;\n  }\n\n  .cc-tns__claim-note {\n    font-family: var(--ff-body);\n    font-size: 0.82rem;\n    font-weight: 500;\n    line-height: 1.55;\n    color: rgba(17,17,17,0.68);\n  }\n\n  .cc-tns__claim-link {\n    margin-top: 0.55rem;\n  }\n\n  .cc-tns__claim-link a {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.4rem;\n    font-family: var(--ff-body);\n    font-size: 0.68rem;\n    font-weight: 700;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: var(--gold-dark);\n    border-bottom: 1px solid rgba(168,135,46,0.28);\n    padding-bottom: 0.15rem;\n    transition: opacity 0.25s ease, border-color 0.25s ease;\n  }\n\n  .cc-tns__claim-link a:hover {\n    opacity: 0.78;\n    border-color: rgba(168,135,46,0.8);\n  }\n\n  .cc-tns__desc {\n    font-family: var(--ff-body);\n    font-size: 0.94rem;\n    font-weight: 400;\n    line-height: 1.8;\n    color: rgba(17,17,17,0.72);\n    margin-bottom: 1.2rem;\n    max-width: 48ch;\n  }\n\n  .cc-tns__chips {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.6rem;\n    margin-bottom: 1.35rem;\n  }\n\n  .cc-tns__chip {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0.55rem 0.8rem;\n    background: rgba(255,255,255,0.74);\n    border: 1px solid rgba(17,17,17,0.08);\n    font-family: var(--ff-body);\n    font-size: 0.66rem;\n    font-weight: 600;\n    letter-spacing: 0.13em;\n    text-transform: uppercase;\n    color: rgba(17,17,17,0.74);\n    white-space: nowrap;\n  }\n\n  .cc-tns__actions {\n    display: flex;\n    align-items: center;\n    gap: 1rem;\n    flex-wrap: wrap;\n  }\n\n  .cc-tns__btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 190px;\n    padding: 1rem 2.15rem;\n    background: var(--gold);\n    color: var(--ink);\n    border: 1px solid transparent;\n    font-family: var(--ff-body);\n    font-size: 0.68rem;\n    font-weight: 700;\n    letter-spacing: 0.23em;\n    text-transform: uppercase;\n    transition:\n      transform 0.3s ease,\n      box-shadow 0.3s ease,\n      background 0.3s ease;\n  }\n\n  .cc-tns__btn:hover {\n    background: var(--gold-light);\n    transform: translateY(-1px);\n    box-shadow: 0 10px 24px rgba(201,168,76,0.24);\n  }\n\n  .cc-tns__micro {\n    font-family: var(--ff-body);\n    font-size: 0.72rem;\n    font-weight: 500;\n    line-height: 1.6;\n    color: rgba(17,17,17,0.58);\n    max-width: 24ch;\n  }\n\n  .cc-tns-rv {\n    opacity: 0;\n    transform: translateY(24px);\n    transition:\n      opacity 0.8s var(--ease-expo),\n      transform 0.8s var(--ease-expo);\n  }\n\n  .cc-tns-rv.is-vis {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  @media (max-width: 1200px) {\n    .cc-tns-feature,\n    .cc-tns__inner {\n      min-height: 690px;\n    }\n\n    .cc-tns__panel {\n      width: min(100%, 500px);\n    }\n  }\n\n  @media (max-width: 860px) {\n    .cc-tns-feature {\n      min-height: auto;\n    }\n\n    .cc-tns__bg {\n      position: relative;\n      height: 78vw;\n      min-height: 420px;\n      max-height: 620px;\n    }\n\n    .cc-tns__bg::before {\n      background:\n        linear-gradient(\n          to bottom,\n          rgba(255,255,255,0.10) 0%,\n          rgba(255,255,255,0.02) 52%,\n          rgba(255,255,255,0.78) 100%\n        );\n    }\n\n    .cc-tns__bg::after {\n      background: none;\n    }\n\n    .cc-tns__inner {\n      min-height: auto;\n      display: block;\n      margin-top: -2.8rem;\n      padding: 0 1.2rem 2rem;\n    }\n\n    .cc-tns__panel {\n      width: 100%;\n      background: rgba(255,255,255,0.88);\n    }\n  }\n\n  @media (max-width: 520px) {\n    .cc-tns__panel {\n      padding: 1.1rem;\n    }\n\n    .cc-tns__actions {\n      flex-direction: column;\n      align-items: stretch;\n    }\n\n    .cc-tns__btn {\n      width: 100%;\n      min-width: 0;\n    }\n\n    .cc-tns__micro {\n      max-width: none;\n      text-align: center;\n    }\n\n    .cc-tns__chips {\n      gap: 0.45rem;\n    }\n\n    .cc-tns__chip {\n      font-size: 0.6rem;\n      padding: 0.5rem 0.65rem;\n    }\n  }\n</style>\n\n<section class=\"cc-tns\">\n  <div class=\"cc-tns-feature\">\n    <div class=\"cc-tns__bg\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0785/2530/0958/files/comment_FEATURED_PRODUCT_SECTION_-_SkinMedica_TNS_Advanced_Serum_Paste_into_a_Custom_Liquid_section_Swap_the_pro_2.png?v=1775024520\"\n        alt=\"SkinMedica TNS Advanced+ Serum on a bright marble surface\"\n        loading=\"lazy\"\n      >\n    </div>\n\n    <div class=\"cc-tns__inner\">\n      <div class=\"cc-tns__panel cc-tns-rv\">\n        <p class=\"cc-tns__eyebrow\">Featured Product</p>\n\n        <h2 class=\"cc-tns__title\">TNS Advanced+ <em>Serum</em></h2>\n        <p class=\"cc-tns__brand\">SkinMedica</p>\n\n        <div class=\"cc-tns__claim\">\n          <span class=\"cc-tns__claim-kicker\">Clinical Highlight</span>\n          <div class=\"cc-tns__claim-main\">Skin that looks up to 6 years younger</div>\n          <div class=\"cc-tns__claim-note\">In SkinMedica's manufacturer clinical study, subjects' skin appeared up to 6 years younger after 12 weeks of twice-daily use.</div>\n          <div class=\"cc-tns__claim-link\">\n            <a\n              href=\"https://www.skinmedica.com/us/growth_factors.html\"\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              aria-label=\"View SkinMedica clinical results for TNS Advanced Plus Serum\"\n            >\n              View Clinical Results\n            </a>\n          </div>\n        </div>\n\n        <p class=\"cc-tns__desc\">\n          Over 110 growth factors. One dual-chamber serum. TNS Advanced+ delivers SkinMedica's proprietary Tissue Nutrient Solution alongside a peptide and antioxidant complex.\n        </p>\n\n        <div class=\"cc-tns__actions\">\n          <a href=\"/products/skinmedica-tns-advanced-serum\" class=\"cc-tns__btn\">Shop Now</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<script>\n(function () {\n  var els = document.querySelectorAll('.cc-tns .cc-tns-rv');\n  if (!els.length) return;\n\n  if ('IntersectionObserver' in window) {\n    var io = new IntersectionObserver(function(entries) {\n      entries.forEach(function(entry) {\n        if (entry.isIntersecting) {\n          entry.target.classList.add('is-vis');\n          io.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });\n\n    els.forEach(function(el) {\n      io.observe(el);\n    });\n  } else {\n    els.forEach(function(el) {\n      el.classList.add('is-vis');\n    });\n  }\n})();\n</script>",
