    "custom_liquid_mrAbwB": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .cc-tns *, .cc-tns *::before, .cc-tns *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n  .cc-tns {\n    --gold: #c9a84c;\n    --gold-light: #d8bf72;\n    --gold-dark: #a8872e;\n    --ink: #111111;\n    --ink-soft: #404040;\n    --ink-muted: #6f6f6f;\n    --paper: #fbfaf8;\n    --paper-strong: rgba(255,255,255,0.88);\n    --paper-soft: rgba(255,255,255,0.72);\n    --border: rgba(17,17,17,0.08);\n    --shadow: 0 24px 60px rgba(0,0,0,0.12);\n    --ff-display: 'Cormorant Garamond', 'Georgia', serif;\n    --ff-body: 'DM Sans', 'Helvetica Neue', sans-serif;\n    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);\n    font-family: var(--ff-body);\n    width: 100%;\n    overflow: hidden;\n    background: #f6f4f1;\n    color: var(--ink);\n  }\n\n  .cc-tns img {\n    display: block;\n    max-width: 100%;\n  }\n\n  .cc-tns a {\n    color: inherit;\n    text-decoration: none;\n  }\n\n  .cc-tns-feature {\n    position: relative;\n    min-height: 760px;\n    isolation: isolate;\n  }\n\n  .cc-tns__bg {\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n  }\n\n  .cc-tns__bg img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center center;\n  }\n\n    .cc-tns__bg::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(\n        to right,\n        rgba(255,255,255,0.96) 0%,\n        rgba(255,255,255,0.84) 16%,\n        rgba(255,255,255,0.36) 30%,\n        rgba(255,255,255,0.08) 39%,\n        rgba(255,255,255,0) 49%\n      );\n    z-index: 2;\n    pointer-events: none;\n  }\n\n  .cc-tns__bg::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background:\n      linear-gradient(\n        to top,\n        rgba(255,255,255