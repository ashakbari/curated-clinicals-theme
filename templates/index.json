      "settings": {
        "custom_liquid": "{% comment %}\n  ============================================================================\n  HERO SECTION, Split-Fade Portrait Layout (Compact)\n  ============================================================================\n{% endcomment %}\n\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .cc-hero-wrap *, .cc-hero-wrap *::before, .cc-hero-wrap *::after {\n    box-sizing: border-box; margin: 0; padding: 0;\n  }\n  .cc-hero-wrap {\n    --gold: #c9a84c;\n    --gold-light: #d4ba6a;\n    --gold-dark: #a8893d;\n    --ink: #0e0e0e;\n    --ink-soft: #3a3a3a;\n    --ink-muted: #6b6b6b;\n    --paper: #fdfcf9;\n    --surface: #f5f2eb;\n    --border: #e0dbd2;\n    --ff-display: 'Cormorant Garamond', 'Georgia', serif;\n    --ff-body: 'DM Sans', 'Helvetica Neue', sans-serif;\n    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);\n    --ease-quart: cubic-bezier(0.25, 1, 0.5, 1);\n    font-family: var(--ff-body);\n  }\n  .cc-hero-wrap a { text-decoration: none; }\n  .cc-hero-wrap img { display: block; }\n\n  /* ── HERO ── */\n  .cc-hero {\n    position: relative;\n    width: 100%;\n    height: 88vh;\n    max-height: 860px;\n    min-height: 600px;\n    background-color: var(--paper);\n    overflow: hidden;\n    display: flex;\n    align-items: stretch;\n  }\n\n  /* ── IMAGE SIDE ── */\n  .cc-hero__media {\n    position: relative;\n    width: 56%;\n    flex-shrink: 0;\n    overflow: hidden;\n  }\n\n  .cc-hero__media img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: 55% 35%;  /* centers face vertically, prevents top/bottom crop */\n    opacity: 0;\n    transform: scale(1.03);\n    transition: opacity 1.2s var(--ease-expo), transform 1.8s var(--ease-expo);\n  }\n\n  .cc-hero.is-loaded .cc-hero__media img {\n    opacity: 1;\n    transform: scale(1);\n  }\n\n  .cc-hero__media::after {\n    content: '';\n    position: absolute;\n    top: 0; right: 0;\n    width: 45%; height: 100%;\n    background: linear-gradient(\n      to right,\n      rgba(253,252,249,0) 0%,\n      rgba(253,252,249,0.25) 30%,\n      rgba(253,252,249,0.7) 65%,\n      rgba(253,252,249,1) 100%\n    );\n    pointer-events: none;\n    z-index: 2;\n  }\n\n  .cc-hero__media::before {\n    content: '';\n    position: absolute;\n    bottom: 0; left: 0; right: 0;\n    height: 25%;\n    background: linear-gradient(to top, rgba(253,252,249,0.35) 0%, transparent 100%);\n    pointer-events: none;\n    z-index: 2;\n  }\n\n  /* ── TEXT SIDE ── */\n  .cc-hero__content {\n    position: relative;\n    z-index: 3;\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 2.5rem 4vw 2.5rem 0;   /* tighter vertical padding */\n    margin-left: -6%;\n    max-width: 500px;\n  }\n\n  .cc-hero__eyebrow {\n    font-family: var(--ff-body);\n    font-size: 0.62rem;\n    font-weight: 500;\n    letter-spacing: 0.35em;\n    text-transform: uppercase;\n    color: var(--gold);\n    margin-bottom: 1rem;\n    opacity: 0; transform: translateY(14px);\n    animation: ccHeroUp 0.8s var(--ease-expo) 0.4s forwards;\n  }\n\n  .cc-hero__heading {\n    font-family: var(--ff-display);\n    font-weight: 300;\n    font-size: clamp(2rem, 3.4vw, 3.6rem);   /* slightly smaller than before */\n    line-height: 1.08;\n    color: var(--ink);\n    letter-spacing: -0.01em;\n    margin-bottom: 1rem;\n    opacity: 0; transform: translateY(20px);\n    animation: ccHeroUp 0.9s var(--ease-expo) 0.6s forwards;\n  }\n\n  .cc-hero__heading em {\n    font-style: italic;\n    font-weight: 400;\n    color: var(--gold-dark);\n  }\n\n  .cc-hero__sub {\n    font-family: var(--ff-body);\n    font-size: clamp(0.8rem, 1vw, 0.92rem);\n    font-weight: 300;\n    line-height: 1.75;\n    color: var(--ink-muted);\n    margin-bottom: 1.8rem;\n    max-width: 360px;\n    opacity: 0; transform: translateY(14px);\n    animation: ccHeroUp 0.8s var(--ease-expo) 0.85s forwards;\n  }\n\n  .cc-hero__btns {\n    display: flex;\n    gap: 0.75rem;\n    flex-wrap: wrap;\n    opacity: 0; transform: translateY(14px);\n    animation: ccHeroUp 0.8s var(--ease-expo) 1.05s forwards;\n  }\n\n  .cc-hbtn {\n    display: inline-block;\n    font-family: var(--ff-body);\n    font-size: 0.65rem;\n    font-weight: 500;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    padding: 0.85rem 2rem;    /* slightly less padding than before */\n    cursor: pointer;\n    border: none;\n    transition: all 0.3s var(--ease-quart);\n  }\n  .cc-hbtn--gold {\n    background: var(--gold);\n    color: var(--ink);\n  }\n  .cc-hbtn--gold:hover {\n    background: var(--gold-light);\n    transform: translateY(-1px);\n    box-shadow: 0 4px 20px rgba(201,168,76,0.25);\n  }\n  .cc-hbtn--outline {\n    background: transparent;\n    color: var(--ink);\n    border: 1px solid var(--border);\n  }\n  .cc-hbtn--outline:hover {\n    border-color: var(--gold);\n    color: var(--gold-dark);\n  }\n\n  @keyframes ccHeroUp {\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  /* ── TABLET ── */\n  @media (max-width: 1080px) {\n    .cc-hero { height: 72vh; }\n    .cc-hero__media { width: 52%; }\n    .cc-hero__content { margin-left: -8%; padding-right: 3vw; }\n  }\n\n  /* ── MOBILE ── */\n  @media (max-width: 768px) {\n    .cc-hero {\n      flex-direction: column;\n      height: auto;\n      min-height: auto;\n      max-height: none;\n    }\n\n    .cc-hero__media {\n      width: 100%;\n      aspect-ratio: 4 / 3;   /* less tall than 4/5 was, shows more but doesn't dominate */\n      max-height: 52vw;\n    }\n\n    .cc-hero__media img { object-position: center 35%; }\n\n    .cc-hero__media::after {\n      top: auto; bottom: 0; left: 0;\n      width: 100%; height: 40%;\n      background: linear-gradient(to bottom, rgba(253,252,249,0) 0%, rgba(253,252,249,0.5) 50%, rgba(253,252,249,1) 100%);\n    }\n    .cc-hero__media::before { display: none; }\n\n    .cc-hero__content {\n      margin-left: 0;\n      margin-top: -2.5rem;\n      padding: 0 1.5rem 2.5rem;\n      max-width: 100%;\n      text-align: center;\n      align-items: center;\n    }\n\n    .cc-hero__sub { max-width: 320px; }\n    .cc-hero__btns { justify-content: center; }\n  }\n\n  @media (max-width: 420px) {\n    .cc-hero__btns { flex-direction: column; align-items: center; width: 100%; }\n    .cc-hbtn { width: 100%; max-width: 280px; text-align: center; }\n  }\n</style>\n\n<div class=\"cc-hero-wrap\">\n  <section class=\"cc-hero\" id=\"ccHeroSplit\">\n\n    <div class=\"cc-hero__media\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0785/2530/0958/files/454cea19-659a-4ea0-bcaf-df0579c64a23.png?v=1775008019\"\n        alt=\"Radiant, healthy skin\"\n        loading=\"eager\"\n        fetchpriority=\"high\"\n      >\n    </div>\n\n    <div class=\"cc-hero__content\">\n      <p class=\"cc-hero__eyebrow\">Curated Clinicals Skincare</p>\n      <h1 class=\"cc-hero__heading\">Your Path to Better Skin Starts <em>Here</em></h1>\n      <p class=\"cc-hero__sub\">Professional-grade formulations from the world's most trusted clinical skincare brands, delivered to your door.</p>\n      <div class=\"cc-hero__btns\">\n        <a href=\"/collections/all\" class=\"cc-hbtn cc-hbtn--gold\">Shop All</a>\n        <a href=\"#\" class=\"cc-hbtn cc-hbtn--outline\">Create Your Routine</a>\n      </div>\n    </div>\n\n  </section>\n</div>\n\n<script>\n  (function(){\n    var hero = document.getElementById('ccHeroSplit');\n    if (!hero) return;\n    var img = hero.querySelector('.cc-hero__media img');\n    if (!img) { hero.classList.add('is-loaded'); return; }\n    if (img.complete) {\n      hero.classList.add('is-loaded');\n    } else {\n      img.addEventListener('load', function(){ hero.classList.add('is-loaded'); });\n      setTimeout(function(){ hero.classList.add('is-loaded'); }, 3000);\n    }\n  })();\n</script>",
