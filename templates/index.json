sultsInner');\n\n  /* ── BUILD SLIDES ── */\n  questions.forEach((q, qi) => {\n    const slide = document.createElement('div');\n    slide.className = 'ccq__slide';\n    slide.id = `ccqS${qi}`;\n    const opts = q.options.map((o, oi) => `\n      <button class=\"ccq__option\" data-qi=\"${qi}\" data-oi=\"${oi}\" type=\"button\">\n        <span class=\"ccq__option-num\">0${oi + 1}</span>\n        <span class=\"ccq__option-body\">\n          <span class=\"ccq__option-text\">${o.text}</span>\n          <span class=\"ccq__option-desc\">${o.desc}</span>\n        </span>\n        <span class=\"ccq__option-check\"><svg viewBox=\"0 0 10 8\"><path d=\"M1 4l3 3 5-6\"/></svg></span>\n      </button>`).join('');\n    slide.innerHTML = `\n      <div class=\"ccq__slide-inner\">\n        <div>\n          <div class=\"ccq__q-num\">${q.num}</div>\n          <h3 class=\"ccq__q-text\">${q.q.join('<br>')}</h3>\n          <div class=\"ccq__q-divider\"></div>\n          <p class=\"ccq__q-hint\">${q.hint}</p>\n        </div>\n        <div class=\"ccq__options\">${opts}</div>\n      </div>`;\n    $slides.appendChild(slide);\n    slide.querySelectorAll('.ccq__option').forEach(btn => {\n      btn.addEventListener('click', function() { pick(+this.dataset.qi, +this.dataset.oi, this); });\n    });\n  });\n\n  /* ── NAVIGATION ── */\n  function go(qi) {\n    $intro.classList.add('is-hidden');\n    const $cur = $slides.querySelector('.ccq__slide.is-active');\n    if ($cur) { $cur.classList.add('is-exiting'); $cur.classList.remove('is-active'); setTimeout(() => $cur.classList.remove('is-exiting'), 350); }\n    const $nxt = document.getElementById(`ccqS${qi}`);\n    setTimeout(() => $nxt.classList.add('is-active'), $cur ? 280 : 0);\n    currentQ = qi;\n    $fill.style.width = ((qi + 1) / questions.length * 100) + '%';\n    $stepLbl.textContent = questions[qi].num + ' of ' + questions[qi].total;\n    $stepLbl.classList.add('is-vis');\n    $backBtn.classList.toggle('is-vis', qi > 0);\n  }\n\n  function pick(qi, oi, el) {\n    document.getElementById(`ccqS${qi}`).querySelectorAll('.ccq__option').forEach(b => b.classList.remove('is-selected'));\n    el.classList.add('is-selected');\n    history[qi] = { qi, oi };\n    const s = questions[qi].options[oi].s;\n    Object.keys(s).forEach(k => scores[k] += s[k]);\n    setTimeout(() => { qi < questions.length - 1 ? go(qi + 1) : showResults(); }, 380);\n  }\n\n  $backBtn.addEventListener('click', () => {\n    if (currentQ <= 0) return;\n    [currentQ, currentQ - 1].forEach(i => {\n      const h = history[i];\n      if (h) { const s = questions[h.qi].options[h.oi].s; Object.keys(s).forEach(k => scores[k] -= s[k]); delete history[i]; }\n    });\n    const $c = document.getElementById(`ccqS${currentQ}`);\n    $c.classList.add('is-exiting'); $c.classList.remove('is-active');\n    $c.querySelectorAll('.ccq__option').forEach(b => b.classList.remove('is-selected'));\n    setTimeout(() => $c.classList.remove('is-exiting'), 350);\n    currentQ--;\n    setTimeout(() => document.getElementById(`ccqS${currentQ}`).classList.add('is-active'), 280);\n    $fill.style.width = ((currentQ + 1) / questions.length * 100) + '%';\n    $stepLbl.textContent = questions[currentQ].num + ' of ' + questions[currentQ].total;\n    $backBtn.classList.toggle('is-vis', currentQ > 0);\n  });\n\n  document.getElementById('ccqStartBtn').addEventListener('click', () => go(0));\n\n  /* ── RESULTS ── */\n  function showResults() {\n    const winner = Object.keys(scores).reduce((a, b) => scores[a] >= scores[b] ? a : b);\n    const p = profiles[winner];\n    const $last = $slides.querySelector('.ccq__slide.is-active');\n    if ($last) { $last.classList.add('is-exiting'); $last.classList.remove('is-active'); setTimeout(() => $last.classList.remove('is-exiting'), 350); }\n\n    const prods = p.products.map(pr => `\n      <div class=\"ccq__rec-card\">\n        <div class=\"ccq__rec-rank\">${pr.rank}</div>\n        <span class=\"ccq__rec-brand\">${pr.brand}</span>\n        <h4 class=\"ccq__rec-name\">${pr.name}</h4>\n        <p class=\"ccq__rec-why\">${pr.why}</p>\n        <div class=\"ccq__rec-key\">${pr.keys.map(k => `<span class=\"ccq__rec-key-item\">${k}</span>`).join('')}</div>\n        <a href=\"/products/${pr.handle}\" class=\"ccq__rec-btn\">\n          Shop now <svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg>\n        </a>\n      </div>`).join('');\n\n    $resIn.innerHTML = `\n      <div class=\"ccq__res-ghost\">${p.ghost}</div>\n      <span class=\"ccq__res-eyebrow\">${p.eyebrow}</span>\n      <h2 class=\"ccq__res-profile\">${p.name[0]}<br>${p.name[1]}</h2>\n      <p class=\"ccq__res-tagline\">${p.tagline}</p>\n      <div class=\"ccq__res-rule\"></div>\n      <p class=\"ccq__res-desc\">${p.desc}</p>\n      <span class=\"ccq__recs-label\">Your Recommended Protocol</span>\n      <div class=\"ccq__recs\">${prods}</div>\n      <button class=\"ccq__restart\" id=\"ccqRestartBtn\" type=\"button\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M1 4v6h6M23 20v-6h-6\"/><path d=\"M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15\"/></svg>\n        Retake the quiz\n      </button>`;\n\n    $fill.style.width = '100%';\n    $stepLbl.textContent = 'Your Results';\n    $backBtn.classList.remove('is-vis');\n    setTimeout(() => $results.classList.add('is-active'), 350);\n    document.getElementById('ccqRestartBtn').addEventListener('click', restart);\n  }\n\n  function restart() {\n    scores = { antiage:0, hydrate:0, brighten:0, clarify:0, soothe:0 };\n    history = []; currentQ = -1;\n    $results.classList.remove('is-active');\n    $slides.querySelectorAll('.ccq__slide').forEach(s => {\n      s.classList.remove('is-active', 'is-exiting');\n      s.querySelectorAll('.ccq__option').forEach(b => b.classList.remove('is-selected'));\n    });\n    $fill.style.width = '0%';\n    $stepLbl.classList.remove('is-vis');\n    $backBtn.classList.remove('is-vis');\n    setTimeout(() => $intro.classList.remove('is-hidden'), 400);\n  }\n\n})();\n</script>",
