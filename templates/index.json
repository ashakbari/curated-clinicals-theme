      "settings": {
        "custom_liquid": "{% comment %}\n  SKINCARE QUIZ, Curated Clinicals\n  Fully researched. Accurate product data. Expert-grade recommendations.\n{% endcomment %}\n\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,200;0,300;0,400;0,500;1,200;1,300;1,400;1,500&family=DM+Sans:wght@200;300;400;500&display=swap\" rel=\"stylesheet\">\n\n<style>\n.ccq *, .ccq *::before, .ccq *::after { box-sizing: border-box; margin: 0; padding: 0; }\n.ccq {\n  --cream:  #faf7f2;\n  --cream2: #f3ede3;\n  --cream3: #ece4d6;\n  --gold:   #b8962e;\n  --gold-l: #c9a84c;\n  --gold-d: #8a6f1e;\n  --ink:    #1a1714;\n  --ink2:   #3d3730;\n  --muted:  #8a7f72;\n  --ff-d: 'Cormorant Garamond', Georgia, serif;\n  --ff-b: 'DM Sans', sans-serif;\n  --ease: cubic-bezier(0.16,1,0.3,1);\n}\n.ccq a { text-decoration: none; color: inherit; }\n.ccq button { font-family: inherit; cursor: pointer; border: none; background: none; }\n\n.ccq {\n  position: relative;\n  width: 100%;\n  min-height: 100vh;\n  background:\n    radial-gradient(circle at 14% 18%, rgba(201,168,76,0.14) 0%, rgba(201,168,76,0.05) 20%, transparent 44%),\n    radial-gradient(circle at 86% 82%, rgba(184,150,46,0.10) 0%, transparent 38%),\n    linear-gradient(135deg, #fbf8f3 0%, #f7f1e7 48%, #f2eadf 100%);\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n}\n.ccq::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\");\n  background-size: 220px;\n  opacity: 0.018;\n  pointer-events: none;\n  z-index: 0;\n}\n\n/* PROGRESS */\n.ccq__progress { position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--cream3); z-index: 10; }\n.ccq__progress-fill { height: 100%; background: linear-gradient(to right, var(--gold-d), var(--gold-l)); width: 0%; transition: width 0.7s var(--ease); }\n\n/* HEADER */\n.ccq__header {\n  position: relative; z-index: 5;\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 1.8rem clamp(1.5rem, 5vw, 4rem);\n  border-bottom: 1px solid rgba(184,150,46,0.12);\n  background: linear-gradient(to bottom, rgba(255,255,255,0.34), rgba(255,255,255,0.08));\n  backdrop-filter: blur(10px);\n}\n.ccq__logo { font-family: var(--ff-d); font-size: 0.75rem; font-weight: 300; letter-spacing: 0.28em; text-transform: uppercase; color: var(--muted); }\n.ccq__step-label { font-family: var(--ff-b); font-size: 0.58rem; font-weight: 400; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); opacity: 0; transition: opacity 0.4s ease; }\n.ccq__step-label.is-vis { opacity: 1; }\n.ccq__back-btn { display: flex; align-items: center; gap: 0.5rem; font-family: var(--ff-b); font-size: 0.58rem; font-weight: 400; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); opacity: 0; pointer-events: none; transition: opacity 0.3s ease, color 0.3s ease; }\n.ccq__back-btn.is-vis { opacity: 1; pointer-events: all; }\n.ccq__back-btn:hover { color: var(--gold); }\n.ccq__back-btn svg { width: 13px; height: 13px; stroke: currentColor; fill: none; stroke-width: 1.5; stroke-linecap: round; }\n\n/* BODY */\n.ccq__body { position: relative; z-index: 5; flex: 1; display: flex; align-items: center; }\n\n/* SLIDES */\n.ccq__slide {\n  position: absolute; inset: 0;\n  display: flex; align-items: center;\n  padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4rem);\n  opacity: 0; pointer-events: none;\n  transform: translateY(24px);\n  transition: opacity 0.55s var(--ease), transform 0.55s var(--ease);\n}\n.ccq__slide.is-active { opacity: 1; pointer-events: all; transform: translateY(0); }\n.ccq__slide.is-exiting { opacity: 0; transform: translateY(-16px); transition: opacity 0.32s ease, transform 0.32s ease; }\n\n.ccq__slide-inner {\n  width: 100%; max-width: 1100px; margin: 0 auto;\n  display: grid; grid-template-columns: 1fr 1fr;\n  gap: clamp(3rem, 7vw, 8rem); align-items: center;\n}\n\n.ccq__q-num { font-family: var(--ff-d); font-size: clamp(5rem, 14vw, 10rem); font-weight: 200; line-height: 0.85; color: rgba(184,150,46,0.12); letter-spacing: -0.04em; margin-bottom: -0.8rem; user-select: none; }\n.ccq__q-text { font-family: var(--ff-d); font-weight: 300; font-size: clamp(2rem, 3.8vw, 3.4rem); line-height: 1.1; color: var(--ink); letter-spacing: -0.01em; margin-bottom: 1.5rem; }\n.ccq__q-text em { font-style: italic; font-weight: 300; color: var(--gold); }\n.ccq__q-divider { width: 32px; height: 1px; background: var(--gold-l); opacity: 0.5; margin-bottom: 1.2rem; transition: width 0.8s var(--ease) 0.2s; }\n.ccq__slide.is-active .ccq__q-divider { width: 48px; }\n.ccq__q-hint { font-family: var(--ff-b); font-size: 0.76rem; font-weight: 300; line-height: 1.75; color: var(--muted); max-width: 280px; }\n\n/* OPTIONS */\n.ccq__options { display: flex; flex-direction: column; border: 1px solid rgba(184,150,46,0.12); background: rgba(255,255,255,0.46); backdrop-filter: blur(10px); box-shadow: 0 20px 60px rgba(26,23,20,0.05); }\n.ccq__option {\n  position: relative; display: flex; align-items: center; gap: 1.2rem;\n  padding: 1.2rem 1.4rem; border-bottom: 1px solid rgba(184,150,46,0.10);\n  cursor: pointer; background: transparent; text-align: left; width: 100%;\n  overflow: hidden; opacity: 0; transform: translateX(12px);\n  transition: opacity 0.4s var(--ease), transform 0.4s var(--ease), background 0.22s ease;\n}\n.ccq__option:last-child { border-bottom: none; }\n.ccq__option::after { content: ''; position: absolute; inset: 0; background: rgba(243,237,227,0.88); transform: translateX(-101%); transition: transform 0.3s var(--ease); z-index: 0; }\n.ccq__option:hover::after { transform: translateX(0); }\n.ccq__option.is-selected::after { transform: translateX(0); background: rgba(243,237,227,0.94); }\n.ccq__option::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: var(--gold); z-index: 1; transition: width 0.25s var(--ease); }\n.ccq__option:hover::before, .ccq__option.is-selected::before { width: 2px; }\n\n.ccq__slide.is-active .ccq__option { opacity: 1; transform: translateX(0); }\n.ccq__slide.is-active .ccq__option:nth-child(1) { transition-delay: 0.08s; }\n.ccq__slide.is-active .ccq__option:nth-child(2) { transition-delay: 0.15s; }\n.ccq__slide.is-active .ccq__option:nth-child(3) { transition-delay: 0.22s; }\n.ccq__slide.is-active .ccq__option:nth-child(4) { transition-delay: 0.29s; }\n.ccq__slide.is-active .ccq__option:nth-child(5) { transition-delay: 0.36s; }\n\n.ccq__option-num { font-family: var(--ff-d); font-size: 0.9rem; font-weight: 300; color: rgba(184,150,46,0.28); flex-shrink: 0; min-width: 1.6rem; position: relative; z-index: 1; transition: color 0.22s ease; }\n.ccq__option:hover .ccq__option-num, .ccq__option.is-selected .ccq__option-num { color: var(--gold); }\n.ccq__option-body { flex: 1; position: relative; z-index: 1; }\n.ccq__option-text { display: block; font-family: var(--ff-d); font-size: clamp(0.95rem, 1.6vw, 1.15rem); font-weight: 400; color: var(--ink2); line-height: 1.3; transition: color 0.22s ease; }\n.ccq__option:hover .ccq__option-text, .ccq__option.is-selected .ccq__option-text { color: var(--ink); }\n.ccq__option-desc { display: block; font-family: var(--ff-b); font-size: 0.66rem; font-weight: 300; color: var(--muted); margin-top: 0.15rem; }\n.ccq__option-check { flex-shrink: 0; width: 18px; height: 18px; border: 1px solid rgba(184,150,46,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; position: relative; z-index: 1; transition: border-color 0.22s ease, background 0.22s ease; }\n.ccq__option:hover .ccq__option-check { border-color: var(--gold-l); }\n.ccq__option.is-selected .ccq__option-check { border-color: var(--gold); background: var(--gold); }\n.ccq__option-check svg { width: 9px; height: 9px; stroke: white; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; opacity: 0; transition: opacity 0.2s ease; }\n.ccq__option.is-selected .ccq__option-check svg { opacity: 1; }\n\n/* INTRO */\n.ccq__intro { position: absolute; inset: 0; display: flex; align-items: center; padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4rem); z-index: 3; opacity: 1; transition: opacity 0.45s ease, transform 0.45s ease; }\n.ccq__intro.is-hidden { opacity: 0; pointer-events: none; transform: translateY(-16px); }\n.ccq__intro-inner { width: 100%; max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: minmax(0,1.05fr) minmax(0,0.95fr); gap: clamp(2.5rem, 6vw, 7rem); align-items: center; }\n.ccq__intro-eyebrow { display: flex; align-items: center; gap: 0.8rem; font-family: var(--ff-b); font-size: 0.58rem; font-weight: 500; letter-spacing: 0.34em; text-transform: uppercase; color: var(--gold); margin-bottom: 1.35rem; }\n.ccq__intro-eyebrow::before { content: ''; display: block; width: 20px; height: 1px; background: var(--gold); opacity: 0.6; }\n.ccq__intro-h { font-family: var(--ff-d); font-size: clamp(2.9rem, 5.4vw, 5.2rem); font-weight: 300; line-height: 1.02; color: var(--ink); letter-spacing: -0.02em; margin-bottom: 1.25rem; }\n.ccq__intro-h em { font-style: italic; color: var(--gold); }\n.ccq__intro-p { font-family: var(--ff-b); font-size: 0.86rem; font-weight: 300; line-height: 1.9; color: var(--muted); max-width: 410px; }\n\n/* Intro panel */\n.ccq__intro-panel { position: relative; background: linear-gradient(180deg, rgba(255,255,255,0.68) 0%, rgba(255,255,255,0.42) 100%); border: 1px solid rgba(184,150,46,0.14); padding: clamp(1.6rem, 3vw, 2.4rem); box-shadow: 0 25px 70px rgba(26,23,20,0.08); backdrop-filter: blur(14px); }\n.ccq__intro-panel::before { content: ''; position: absolute; inset: 0; border-top: 2px solid rgba(201,168,76,0.45); pointer-events: none; }\n.ccq__intro-panel-kicker { display: block; font-family: var(--ff-b); font-size: 0.56rem; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.9rem; }\n.ccq__intro-panel-title { font-family: var(--ff-d); font-size: clamp(1.8rem, 3.2vw, 2.5rem); font-weight: 300; line-height: 1.08; color: var(--ink); margin-bottom: 0.8rem; }\n.ccq__intro-panel-text { font-family: var(--ff-b); font-size: 0.8rem; font-weight: 300; line-height: 1.8; color: var(--muted); margin-bottom: 1.6rem; }\n.ccq__intro-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(184,150,46,0.12); margin-bottom: 1.5rem; }\n.ccq__intro-stat { background: rgba(250,247,242,0.9); padding: 1.1rem 1rem; }\n.ccq__intro-stat-n { font-family: var(--ff-d); font-size: 1.5rem; font-weight: 300; color: var(--gold); line-height: 1; margin-bottom: 0.2rem; }\n.ccq__intro-stat-l { font-family: var(--ff-b); font-size: 0.53rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); line-height: 1.5; }\n.ccq__intro-cta-row { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }\n\n/* START BUTTON */\n#ccQuiz button.ccq__start-btn {\n  -webkit-appearance: none; appearance: none;\n  display: inline-flex !important; align-items: center !important;\n  gap: 0.8rem; min-height: 52px;\n  padding: 0.95rem 1.4rem;\n  background: #111111 !important; color: #ffffff !important;\n  border: 1px solid rgba(255,255,255,0.08) !important;\n  border-radius: 999px;\n  box-shadow: 0 16px 34px rgba(17,17,17,0.18);\n  cursor: pointer;\n  transition: background 0.25s ease, transform 0.25s var(--ease), box-shadow 0.25s ease, border-color 0.25s ease;\n}\n#ccQuiz button.ccq__start-btn:hover { background: #2b2b2b !important; border-color: rgba(201,168,76,0.32) !important; transform: translateY(-2px); box-shadow: 0 20px 40px rgba(17,17,17,0.26); }\n.ccq__start-btn-label { font-family: var(--ff-b); font-size: 0.66rem; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: #ffffff; }\n.ccq__start-btn-icon { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: rgba(201,168,76,0.16); color: var(--gold-l); flex-shrink: 0; transition: transform 0.25s var(--ease), background 0.25s ease; }\n#ccQuiz button.ccq__start-btn:hover .ccq__start-btn-icon { transform: translateX(2px); background: rgba(201,168,76,0.24); }\n.ccq__start-btn-icon svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; }\n.ccq__start-note { font-family: var(--ff-b); font-size: 0.7rem; font-weight: 300; color: var(--muted); }\n\n/* RESULTS */\n.ccq__results { position: absolute; inset: 0; overflow-y: auto; padding: clamp(2rem, 4vw, 4rem) clamp(1.5rem, 5vw, 4rem); opacity: 0; pointer-events: none; transform: translateY(28px); transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); z-index: 4; background: radial-gradient(circle at 14% 18%, rgba(201,168,76,0.12) 0%, rgba(201,168,76,0.03) 20%, transparent 44%), linear-gradient(135deg, #fbf8f3 0%, #f5efe4 100%); }\n.ccq__results.is-active { opacity: 1; pointer-events: all; transform: translateY(0); }\n.ccq__results-inner { max-width: 1100px; margin: 0 auto; }\n.ccq__res-ghost { font-family: var(--ff-d); font-size: clamp(4rem, 13vw, 10rem); font-weight: 200; line-height: 0.85; color: rgba(184,150,46,0.12); letter-spacing: -0.03em; margin-bottom: -1.6rem; user-select: none; }\n.ccq__res-eyebrow { display: block; font-family: var(--ff-b); font-size: 0.58rem; font-weight: 500; letter-spacing: 0.34em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.8rem; }\n.ccq__res-profile { font-family: var(--ff-d); font-size: clamp(2.4rem, 5vw, 4.4rem); font-weight: 300; line-height: 1.04; color: var(--ink); letter-spacing: -0.015em; margin-bottom: 0.5rem; }\n.ccq__res-profile em { font-style: italic; color: var(--gold); }\n.ccq__res-tagline { font-family: var(--ff-d); font-size: 1rem; font-weight: 300; font-style: italic; color: var(--muted); margin-bottom: 1.4rem; }\n.ccq__res-rule { width: 40px; height: 1px; background: var(--gold-l); opacity: 0.6; margin-bottom: 1.4rem; }\n.ccq__res-desc { font-family: var(--ff-b); font-size: 0.84rem; font-weight: 300; line-height: 1.9; color: var(--muted); max-width: 580px; margin-bottom: 3.5rem; }\n.ccq__recs-label { display: block; font-family: var(--ff-b); font-size: 0.56rem; font-weight: 500; letter-spacing: 0.32em; text-transform: uppercase; color: var(--muted); margin-bottom: 1.4rem; }\n.ccq__recs { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1px; background: rgba(184,150,46,0.12); margin-bottom: 3rem; }\n.ccq__rec-card { background: rgba(250,247,242,0.92); padding: 2rem 1.8rem; position: relative; display: flex; flex-direction: column; transition: background 0.25s ease; }\n.ccq__rec-card:hover { background: rgba(243,237,227,0.95); }\n.ccq__rec-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(to right, var(--gold), transparent); opacity: 0; transition: opacity 0.3s ease; }\n.ccq__rec-card:hover::before { opacity: 0.6; }\n.ccq__rec-rank { font-family: var(--ff-d); font-size: 3rem; font-weight: 200; color: rgba(184,150,46,0.14); line-height: 1; letter-spacing: -0.03em; margin-bottom: 0.6rem; }\n.ccq__rec-brand { display: block; font-family: var(--ff-b); font-size: 0.55rem; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.5rem; }\n.ccq__rec-name { font-family: var(--ff-d); font-size: clamp(1.15rem, 2vw, 1.45rem); font-weight: 400; color: var(--ink); line-height: 1.2; margin-bottom: 0.5rem; }\n.ccq__rec-name em { font-style: italic; color: var(--gold); }\n.ccq__rec-why { font-family: var(--ff-b); font-size: 0.74rem; font-weight: 300; line-height: 1.8; color: var(--muted); flex: 1; margin-bottom: 1.6rem; }\n.ccq__rec-key { display: flex; flex-direction: column; gap: 0.28rem; margin-bottom: 1.4rem; }\n.ccq__rec-key-item { display: flex; align-items: baseline; gap: 0.5rem; font-family: var(--ff-b); font-size: 0.66rem; font-weight: 300; color: var(--muted); line-height: 1.5; }\n.ccq__rec-key-item::before { content: '·'; color: var(--gold); opacity: 0.6; flex-shrink: 0; font-size: 0.6rem; }\n.ccq__rec-btn { display: inline-flex; align-items: center; gap: 0.6rem; align-self: flex-start; font-family: var(--ff-b); font-size: 0.58rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink); border-bottom: 1px solid var(--ink); padding-bottom: 0.2rem; transition: color 0.22s ease, border-color 0.22s ease, gap 0.25s var(--ease); }\n.ccq__rec-btn:hover { color: var(--gold); border-color: var(--gold); gap: 0.9rem; }\n.ccq__rec-btn svg { width: 12px; height: 12px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; }\n.ccq__restart { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--ff-b); font-size: 0.6rem; font-weight: 400; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 3rem; transition: color 0.22s ease; }\n.ccq__restart:hover { color: var(--gold); }\n.ccq__restart svg { width: 13px; height: 13px; stroke: currentColor; fill: none; stroke-width: 1.5; stroke-linecap: round; }\n\n/* RESPONSIVE */\n@media (max-width: 900px) {\n  .ccq__slide-inner, .ccq__intro-inner { grid-template-columns: 1fr; gap: 2rem; }\n  .ccq__q-num { font-size: clamp(4rem, 18vw, 7rem); }\n  .ccq__res-ghost { font-size: clamp(3rem, 14vw, 7rem); }\n}\n@media (max-width: 600px) {\n  .ccq__slide, .ccq__results { padding: 1.5rem; }\n  .ccq__q-text { font-size: 1.85rem; }\n  .ccq__option { padding: 1rem; }\n  .ccq__res-profile { font-size: 2rem; }\n  .ccq__intro-stats { grid-template-columns: 1fr; }\n  .ccq__intro-panel { padding: 1.35rem; }\n  .ccq__rec-card { padding: 1.5rem 1.3rem; }\n}\n</style>\n\n<section class=\"ccq\" id=\"ccQuiz\">\n  <div class=\"ccq__progress\"><div class=\"ccq__progress-fill\" id=\"ccqProgressFill\"></div></div>\n\n  <header class=\"ccq__header\">\n    <span class=\"ccq__logo\">Curated Clinicals</span>\n    <span class=\"ccq__step-label\" id=\"ccqStepLabel\"></span>\n    <button class=\"ccq__back-btn\" id=\"ccqBackBtn\" type=\"button\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M19 12H5M12 5l-7 7 7 7\"/></svg>\n      Back\n    </button>\n  </header>\n\n  <div class=\"ccq__body\">\n    <div class=\"ccq__intro\" id=\"ccqIntro\">\n      <div class=\"ccq__intro-inner\">\n        <div>\n          <p class=\"ccq__intro-eyebrow\">Skin Finder</p>\n          <h2 class=\"ccq__intro-h\">Find your<br><em>perfect</em><br>protocol.</h2>\n          <p class=\"ccq__intro-p\">Five questions. A personalized recommendation from our full clinical catalogue, matched to your skin, your goals, and where you are right now.</p>\n        </div>\n        <div class=\"ccq__intro-panel\">\n          <span class=\"ccq__intro-panel-kicker\">Personalized Skin Quiz</span>\n          <h3 class=\"ccq__intro-panel-title\">Your clinical match in 1 minute.</h3>\n          <p class=\"ccq__intro-panel-text\">Answer a few questions and we'll match you with the exact products, and the reasons why, from ZO, SkinCeuticals, SkinMedica, Alastin, Skinbetter Science, Hydrinity, and Colorescience.</p>\n          <div class=\"ccq__intro-stats\">\n            <div class=\"ccq__intro-stat\"><div class=\"ccq__intro-stat-n\">5</div><div class=\"ccq__intro-stat-l\">Questions</div></div>\n            <div class=\"ccq__intro-stat\"><div class=\"ccq__intro-stat-n\">7</div><div class=\"ccq__intro-stat-l\">Brands</div></div>\n            <div class=\"ccq__intro-stat\"><div class=\"ccq__intro-stat-n\">1 min</div><div class=\"ccq__intro-stat-l\">To complete</div></div>\n          </div>\n          <div class=\"ccq__intro-cta-row\">\n            <button type=\"button\" class=\"ccq__start-btn\" id=\"ccqStartBtn\">\n              <span class=\"ccq__start-btn-label\">Start Quiz</span>\n              <span class=\"ccq__start-btn-icon\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg></span>\n            </button>\n            <span class=\"ccq__start-note\">Takes about 1 minute</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"ccqSlides\"></div>\n\n    <div class=\"ccq__results\" id=\"ccqResults\">\n      <div class=\"ccq__results-inner\" id=\"ccqResultsInner\"></div>\n    </div>\n  </div>\n</section>\n\n<script>\n(function() {\n\n  /* ── QUESTIONS ─────────────────────────────────────────────────────────── */\n  const questions = [\n    {\n      num:'01', total:'05',\n      q:[\"What's your skin's\",\"greatest <em>challenge?</em>\"],\n      hint:\"Choose the one that resonates most right now\",\n      options:[\n        { text:\"Fine lines & loss of firmness\",  desc:\"Skin that's lost its lift and bounce\",        s:{ antiage:3 } },\n        { text:\"Dullness & uneven tone\",         desc:\"Tired, lacklustre, or pigmented complexion\",  s:{ brighten:3 } },\n        { text:\"Dryness & dehydration\",          desc:\"Tight, thirsty, or rough-feeling skin\",       s:{ hydrate:3 } },\n        { text:\"Breakouts & rough texture\",      desc:\"Congestion, bumps, or enlarged pores\",        s:{ clarify:3 } },\n        { text:\"Redness & sensitivity\",          desc:\"Reactive, easily irritated, or compromised\",  s:{ soothe:3 } },\n      ]\n    },\n    {\n      num:'02', total:'05',\n      q:[\"How does your skin\",\"<em>behave</em> day to day?\"],\n      hint:\"Think mid-afternoon, without any products on\",\n      options:[\n        { text:\"Dry\",         desc:\"Feels tight, flakes occasionally, rarely shiny\",   s:{ hydrate:2 } },\n        { text:\"Oily\",        desc:\"Shines by midday, prone to clogging\",              s:{ clarify:2 } },\n        { text:\"Combination\", desc:\"Oily T-zone, normal to dry cheeks\",                s:{ clarify:1, brighten:1 } },\n        { text:\"Normal\",      desc:\"Balanced, minimal concerns day to day\",           s:{ antiage:1 } },\n        { text:\"Sensitive\",   desc:\"Flushes easily, reacts to new products\",           s:{ soothe:2 } },\n      ]\n    },\n    {\n      num:'03', total:'05',\n      q:[\"What decade are\",\"you <em>in?</em>\"],\n      hint:\"Age shapes what your skin needs most\",\n      options:[\n        { text:\"20s\",   desc:\"Prevention is the highest-ROI investment\",  s:{ brighten:1, clarify:1 } },\n        { text:\"30s\",   desc:\"The first visible changes are appearing\",    s:{ antiage:1, brighten:1 } },\n        { text:\"40s\",   desc:\"Firmness, tone, and volume are all shifting\", s:{ antiage:2 } },\n        { text:\"50s+\",  desc:\"Deep repair, restoration, and rebuilding\",   s:{ antiage:2, hydrate:1 } },\n      ]\n    },\n    {\n      num:'04', total:'05',\n      q:[\"If you could change\",\"one thing, <em>what is it?</em>\"],\n      hint:\"Your single most desired outcome\",\n      options:[\n        { text:\"Look measurably younger\",     desc:\"Turn back the clock with clinical data\",      s:{ antiage:2 } },\n        { text:\"A genuine, healthy glow\",     desc:\"Luminosity that reads as true vitality\",      s:{ brighten:2 } },\n        { text:\"Deep, lasting hydration\",     desc:\"Plump, supple, dewy skin from within\",        s:{ hydrate:2 } },\n        { text:\"Clear, perfectly smooth skin\",desc:\"Pores minimized, texture perfected\",          s:{ clarify:2 } },\n        { text:\"Calm and comfortable skin\",   desc:\"No more reactive, red, or inflamed days\",     s:{ soothe:2 } },\n      ]\n    },\n    {\n      num:'05', total:'05',\n      q:[\"How do you approach\",\"your <em>routine?</em>\"],\n      hint:\"Be honest, there's no wrong answer\",\n      options:[\n        { text:\"One or two hero products\",     desc:\"Efficient and intentional\",           s:{} },\n        { text:\"A layered AM and PM routine\",  desc:\"Steps that each earn their place\",    s:{} },\n        { text:\"The full clinical protocol\",   desc:\"Layered, targeted, results-driven\",   s:{} },\n        { text:\"Building from scratch\",        desc:\"Starting with what matters most\",     s:{} },\n      ]\n    }\n  ];\n\n  /* ── PROFILES ──────────────────────────────────────────────────────────── */\n  const profiles = {\n\n    antiage: {\n      ghost: 'Restore',\n      eyebrow: 'Your Skin Profile',\n      name: ['The', '<em>Regenerationist</em>'],\n      tagline: 'Your skin is ready for clinical-grade transformation.',\n      desc: 'Your profile points to growth factor technology and proven anti-aging actives as your highest-leverage investment. The products below don\\'t just slow aging, they actively reverse visible signs that are already there, with clinical data to back every claim.',\n      products: [\n        {\n          rank: '01', brand: 'SkinMedica', name: 'TNS Advanced+<em> Serum</em>',\n          why: 'The most advanced anti-aging formula SkinMedica has ever made. A dual-chamber pump delivers over 110 growth factors, cytokines, and matrix proteins from human fibroblast conditioned media.',\n          keys: ['110+ growth factors in a single formula', 'SkinMedica study: skin appeared up to 6 years younger after 12 weeks'],\n          handle: 'skinmedica-tns-advanced-serum'\n        },\n        {\n          rank: '02', brand: 'ZO Skin Health', name: 'Growth Factor<em> Serum</em>',\n          why: 'ZO\\'s proprietary ZPRO complex pairs fermented Panax ginseng root extract with beta-glucan and dipeptides to support cellular repair. Firms, smooths fine lines, and restores elasticity.',\n          keys: ['ZPRO complex supports a firmer, smoother look', 'Lightweight gel, layers under everything'],\n          handle: 'zo-growth-factor-serum'\n        },\n        {\n          rank: '03', brand: 'Skinbetter Science', name: 'AlphaRet<em> Overnight Cream</em>',\n          why: 'A patented retinoid + lactic acid conjugate that releases retinoic acid gradually to minimize irritation while maximizing efficacy.',\n          keys: ['Patented AlphaRet technology: retinoid + AHA combined', 'Reduces wrinkle appearance in 4 weeks'],\n          handle: 'skinbetter-science-alpharet-overnight-cream'\n        },\n        {\n          rank: '04', brand: 'SkinCeuticals', name: 'A.G.E. Interrupter<em> Advanced</em>',\n          why: 'A potent corrective cream targeting visible aging caused by advanced glycation end-products (A.G.E.s). Restores firmness and smooths deep wrinkles.',\n          keys: ['18% concentrated Proxylane for skin firmness', 'Wild fruit flavonoids target visible signs of aging'],\n          handle: 'skinceuticals-a-g-e-interrupter-advanced'\n        },\n        {\n          rank: '05', brand: 'Alastin Skincare', name: 'Regenerating Skin<em> Nectar</em>',\n          why: 'Designed with TriHex Technology® to help clear out damaged elastin and collagen, making room for new, healthy proteins.',\n          keys: ['Maximizes procedure results and speeds recovery', 'High antioxidant activity calms skin'],\n          handle: 'alastin-regenerating-skin-nectar'\n        }\n      ]\n    },\n\n    brighten: {\n      ghost: 'Illuminate',\n      eyebrow: 'Your Skin Profile',\n      name: ['The', '<em>Luminous</em>'],\n      tagline: 'Your skin is craving radiance and even tone.',\n      desc: 'Your profile calls for antioxidant protection layered with targeted brightening actives. Dullness and uneven tone have multiple root causes, oxidative damage, melanin overproduction, and sluggish cell turnover.',\n      products: [\n        {\n          rank: '01', brand: 'SkinCeuticals', name: 'CE<em> Ferulic</em>',\n          why: 'The gold standard antioxidant. 15% pure L-ascorbic acid + 1% vitamin E + 0.5% ferulic acid, the exact ratio shown to increase photoprotection 8-fold versus vitamin C alone.',\n   