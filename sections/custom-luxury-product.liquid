<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{%- assign desc_raw = product.description -%}
{%- assign para_split = desc_raw | replace: '<p>', '' | split: '</p>' -%}
{%- assign p_overview   = para_split[0] | strip -%}
{%- assign p_science    = para_split[1] | strip -%}
{%- assign p_how_to_raw = para_split[2] | strip -%}
{%- assign p_best_raw   = para_split[3] | strip -%}
{%- assign p_how_to = p_how_to_raw | replace: '<strong>How to use:</strong>', '' | strip -%}
{%- assign p_best   = p_best_raw   | replace: '<strong>Best for:</strong>',   '' | strip -%}
{%- assign has_structured = false -%}
{%- if p_how_to_raw contains 'How to use:' and p_best_raw contains 'Best for:' -%}
  {%- assign has_structured = true -%}
{%- endif -%}

{%- assign product_concerns_raw = '' -%}
{%- for tag in product.tags -%}
  {%- if tag contains 'concern:' -%}
    {%- assign cslug = tag | remove: 'concern:' -%}
    {%- assign product_concerns_raw = product_concerns_raw | append: cslug | append: '|' -%}
  {%- endif -%}
{%- endfor -%}
{%- assign concerns_list = product_concerns_raw | split: '|' -%}

