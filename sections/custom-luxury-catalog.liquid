{% comment %}
  ============================================================================
  CUSTOM LUXURY CATALOG / COLLECTION PAGE
  ============================================================================
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

<style>
  .lux-catalog *, .lux-catalog *::before, .lux-catalog *::after { box-sizing: border-box; }
  .lux-catalog {
    --gold: #b8923a;
    --gold-light: #d4ba6a;
    --gold-deep: #8a6c1e;
    --ink: #0a0a0a;
    --ink-soft: #4a4a4a;
    --ink-faint: #8a8a8a;
    --paper: #faf8f3;
    --paper-warm: #f4f0e6;
    --border: #e3ddd0;
    --ff-display: 'Cormorant Garamond', 'Times New Roman', serif;
    --ff-body: 'DM Sans', system-ui, sans-serif;

    background: var(--paper);
    color: var(--ink);
    padding: 6rem 2rem 5rem;
    font-family: var(--ff-body);
  }

  /* ===== HEADER ===== */
  .lux-catalog__header {
    text-align: center;
    margin: 0 auto 5rem;
    max-width: 880px;
  }

  .lux-catalog__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.75rem;
  }
  .lux-catalog__eyebrow::before,
  .lux-catalog__eyebrow::after {
    content: "";
    display: block;
    width: 3rem;
    height: 1px;
    background: var(--gold);
    opacity: 0.7;
  }

  .lux-catalog__title {
    font-family: var(--ff-display);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 300;
    font-style: italic;
    margin: 0;
    color: var(--ink);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .lux-catalog__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin: 2rem 0 1.25rem;
  }
  .lux-catalog__divider::before,
  .lux-catalog__divider::after {
    content: "";
    width: 4rem;
    height: 1px;
    background: var(--gold);
  }
  .lux-catalog__divider-dot {
    width: 6px;
    height: 6px;
    background: var(--gold);
    transform: rotate(45deg);
  }

  .lux-catalog__count {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--ink-soft);
    letter-spacing: 0.05em;
  }

  /* ===== GRID ===== */
  .lux-catalog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 4rem 2.5rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* ===== CARD ===== */
  .lux-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    padding-top: 1.25rem;
  }
  .lux-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--gold);
    transform: translateX(-50%);
    transition: width 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .lux-card:hover::before { width: 100%; }

  .lux-card__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    background: #fff;
    overflow: hidden;
    margin-bottom: 1.75rem;
  }
  .lux-card__image-wrapper::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid rgba(0, 0, 0, 0.06);
    pointer-events: none;
    transition: border-color 0.4s ease;
    z-index: 1;
  }
  .lux-card:hover .lux-card__image-wrapper::after {
    border-color: var(--gold);
  }

  .lux-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .lux-card:hover .lux-card__image { transform: scale(1.06); }

  .lux-card__badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    padding: 0.5rem 0.9rem;
    z-index: 2;
  }
  .lux-card__badge--sale {
    background: var(--gold);
    color: var(--ink);
  }

  .lux-card__vendor {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.6rem;
  }

  .lux-card__title {
    font-family: var(--ff-display);
    font-size: 1.65rem;
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 1rem 0;
    color: var(--ink);
    letter-spacing: -0.005em;
  }

  /* ===== PRICE ===== */
  .lux-card__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-family: var(--ff-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }
  .lux-card__price--on-sale .lux-card__price-current {
    color: var(--gold-deep);
    font-weight: 600;
  }
  .lux-card__price-compare {
    color: var(--ink-faint);
    text-decoration: line-through;
    font-weight: 400;
    font-size: 0.85rem;
  }
  .lux-card__price-from {
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 600;
  }
  .lux-card__price-save {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: 0.9rem;
    color: var(--gold-deep);
  }

  /* ===== BUTTON ===== */
  .lux-card__btn {
    position: relative;
    display: block;
    width: 100%;
    text-align: center;
    padding: 1.05rem 1rem;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--ink);
    font-family: var(--ff-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    margin-top: auto;
    overflow: hidden;
    z-index: 0;
    transition: color 0.4s ease;
  }
  .lux-card__btn::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: translateY(101%);
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
    z-index: -1;
  }
  .lux-card:hover .lux-card__btn { color: var(--paper); }
  .lux-card:hover .lux-card__btn::before { transform: translateY(0); }

  /* ===== EMPTY STATE ===== */
  .lux-catalog__empty {
    grid-column: 1 / -1;
    text-align: center;
    font-family: var(--ff-display);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--ink-soft);
    padding: 4rem 0;
  }

  /* ===== PAGINATION ===== */
  .lux-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    max-width: 1400px;
    margin: 5rem auto 0;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .lux-pagination__nav {
    font-family: var(--ff-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding: 0.75rem 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.35s ease, color 0.35s ease;
  }
  .lux-pagination__nav:hover {
    border-bottom-color: var(--gold);
    color: var(--gold-deep);
  }
  .lux-pagination__nav--disabled {
    color: var(--ink-faint);
    opacity: 0.4;
    cursor: not-allowed;
  }
  .lux-pagination__nav--disabled:hover {
    border-bottom-color: transparent;
    color: var(--ink-faint);
  }
  .lux-pagination__pages {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .lux-pagination__page {
    font-family: var(--ff-display);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--ink-soft);
    text-decoration: none;
    min-width: 1.5rem;
    text-align: center;
    transition: color 0.3s ease;
  }
  .lux-pagination__page:hover {
    color: var(--gold-deep);
  }
  .lux-pagination__page--current {
    color: var(--ink);
    font-weight: 500;
    font-size: 1.4rem;
    position: relative;
  }
  .lux-pagination__page--current::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -0.5rem;
    transform: translateX(-50%);
    width: 6px;
    height: 6px;
    background: var(--gold);
    transform: translateX(-50%) rotate(45deg);
  }
  .lux-pagination__page--ellipsis {
    color: var(--ink-faint);
    cursor: default;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .lux-catalog { padding: 4rem 1rem 3rem; }
    .lux-catalog__header { margin-bottom: 3.5rem; }
    .lux-catalog__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 1rem;
    }
    .lux-card__title { font-size: 1.2rem; }
    .lux-card__btn { letter-spacing: 0.25em; padding: 0.9rem 0.5rem; }
    .lux-catalog__eyebrow::before,
    .lux-catalog__eyebrow::after { width: 1.5rem; }
  }
  @media (max-width: 480px) {
    .lux-catalog__grid { grid-template-columns: 1fr; gap: 3rem; }
  }
  @media (max-width: 600px) {
    .lux-pagination { gap: 1.5rem; margin-top: 3.5rem; padding-top: 2rem; }
    .lux-pagination__pages { gap: 0.85rem; }
    .lux-pagination__page { font-size: 1rem; }
    .lux-pagination__page--current { font-size: 1.2rem; }
  }
</style>

<div class="lux-catalog">
  <div class="lux-catalog__header">
    <span class="lux-catalog__eyebrow">{{ section.settings.eyebrow_text | default: 'Medical-Grade Skincare' }}</span>
    <h1 class="lux-catalog__title">{{ collection.title | default: 'Our Curated Collection' }}</h1>
    <div class="lux-catalog__divider" aria-hidden="true">
      <span class="lux-catalog__divider-dot"></span>
    </div>
    <p class="lux-catalog__count">
      {{ collection.products_count | default: 0 }}
      {% if collection.products_count == 1 %}Selection{% else %}Selections{% endif %}
    </p>
  </div>

  {% paginate collection.products by 24 %}
    <div class="lux-catalog__grid">
      {% for product in collection.products %}
        {%- assign on_sale = false -%}
        {%- if product.compare_at_price > product.price -%}
          {%- assign on_sale = true -%}
        {%- endif -%}

        <a href="{{ product.url }}" class="lux-card">
          <div class="lux-card__image-wrapper">
            {% if on_sale %}
              <span class="lux-card__badge lux-card__badge--sale">Sale</span>
            {% elsif product.tags contains 'new' %}
              <span class="lux-card__badge">New</span>
            {% endif %}
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | img_url: '600x' }}"
                alt="{{ product.title | escape }}"
                class="lux-card__image"
                loading="lazy"
                width="600"
                height="750"
              >
            {% endif %}
          </div>

          {% if product.vendor != blank %}
            <div class="lux-card__vendor">{{ product.vendor }}</div>
          {% endif %}

          <h3 class="lux-card__title">{{ product.title }}</h3>

          <div class="lux-card__price{% if on_sale %} lux-card__price--on-sale{% endif %}">
            {% if product.price_varies and on_sale == false %}
              <span class="lux-card__price-from">From</span>
            {% endif %}
            <span class="lux-card__price-current">{{ product.price | money }}</span>
            {% if on_sale %}
              <span class="lux-card__price-compare">{{ product.compare_at_price | money }}</span>
              {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
              <span class="lux-card__price-save">Save {{ savings }}%</span>
            {% endif %}
          </div>

          <span class="lux-card__btn">View Product</span>
        </a>
      {% else %}
        <p class="lux-catalog__empty">No products found in this collection.</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <nav class="lux-pagination" aria-label="Pagination">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="lux-pagination__nav lux-pagination__nav--prev">&larr; Previous</a>
        {% else %}
          <span class="lux-pagination__nav lux-pagination__nav--disabled">&larr; Previous</span>
        {% endif %}

        <div class="lux-pagination__pages">
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="lux-pagination__page">{{ part.title }}</a>
            {% else %}
              {% if part.title == paginate.current_page %}
                <span class="lux-pagination__page lux-pagination__page--current" aria-current="page">{{ part.title }}</span>
              {% else %}
                <span class="lux-pagination__page lux-pagination__page--ellipsis">{{ part.title }}</span>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>

        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="lux-pagination__nav lux-pagination__nav--next">Next &rarr;</a>
        {% else %}
          <span class="lux-pagination__nav lux-pagination__nav--disabled">Next &rarr;</span>
        {% endif %}
      </nav>
    {% endif %}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "Luxury Catalog Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "Medical-Grade Skincare",
      "info": "Small label shown above the collection title."
    }
  ],
  "presets": [
    {
      "name": "Luxury Catalog Grid",
      "category": "Collection"
    }
  ]
}
{% endschema %}
