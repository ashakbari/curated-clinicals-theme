                  {%- when 'hydrinity-hyacyn-active-purifying-mist' -%}{%- assign rating = '4.7' -%}{%- assign review_count = 10 -%}{%- assign quote = 'Post-procedure essential. Calms within seconds.' -%}
                  {%- when 'hydrinity-prelude-facial-treatment-cleanser' -%}{%- assign rating = '4.5' -%}{%- assign review_count = 4 -%}{%- assign quote = 'My serums absorb so much better after this cleanser.' -%}
                  {%- when 'hydrinity-luxe-lip' -%}{%- assign rating = '4.5' -%}{%- assign review_count = 4 -%}{%- assign quote = 'Plumping lip treatment that feels truly luxurious.' -%}
                  {%- when 'alastin-regenerating-skin-nectar' -%}{%- assign rating = '4.8' -%}{%- assign review_count = 14 -%}{%- assign quote = 'Pre and post laser must-have. Halves my downtime.' -%}
                  {%- when 'alastin-restorative-skin-complex' -%}{%- assign rating = '4.7' -%}{%- assign review_count = 10 -%}{%- assign quote = 'Visible firming. My jawline looks lifted.' -%}
                  {%- when 'alastin-ultra-nourishing-moisturizer' -%}{%- assign rating = '4.7' -%}{%- assign review_count = 10 -%}{%- assign quote = 'Comfort cream for stressed skin.' -%}
                  {%- when 'alastin-inhance-post-injection-serum' -%}{%- assign rating = '4.7' -%}{%- assign review_count = 9 -%}{%- assign quote = 'Cooling tip is genius. Less bruising after filler.' -%}
                  {%- when 'colorescience-sunforgettable®-total-protection™-face-shield-spf-50' -%}{%- assign rating = '4.8' -%}{%- assign review_count = 16 -%}{%- assign quote = 'The only mineral SPF that does not leave white residue.' -%}
                  {%- when 'colorescience-sunforgettable-total-protection-face-shield-spf-50' -%}{%- assign rating = '4.8' -%}{%- assign review_count = 16 -%}{%- assign quote = 'The only mineral SPF that does not leave white residue.' -%}
                  {%- when 'colorescience-sunforgettableÂ®-total-protectionâ¢-face-shield-spf-50' -%}{%- assign rating = '4.8' -%}{%- assign review_count = 16 -%}{%- assign quote = 'The only mineral SPF that does not leave white residue.' -%}
                  {%- when 'colorescience-sunforgettable-total-protection-brush-on-shield-spf-50' -%}{%- assign rating = '4.7' -%}{%- assign review_count = 14 -%}{%- assign quote = 'Reapply over makeup mid-day. Game changer.' -%}
                  {%- when 'colorescience-even-up-3-in-1-skin-perfector-sunscreen-spf-50' -%}{%- assign rating = '4.6' -%}{%- assign review_count = 10 -%}{%- assign quote = 'Skin tone evened and protected. Two birds one bottle.' -%}
                  {%- when 'colorescience-total-eye-3-in-1-renewal-care' -%}{%- assign rating = '4.5' -%}{%- assign review_count = 6 -%}{%- assign quote = 'Eye cream with SPF? Yes please.' -%}
                  {%- when 'colorescience-sunforgettable®-face-shield-flex' -%}{%- assign rating = '4.6' -%}{%- assign review_count = 6 -%}{%- assign quote = 'Moves with my face. No cracking around the eyes.' -%}
                  {%- when 'colorescience-sunforgettable-face-shield-flex' -%}{%- assign rating = '4.6' -%}{%- assign review_count = 6 -%}{%- assign quote = 'Moves with my face. No cracking around the eyes.' -%}
                  {%- when 'colorescience-sunforgettableÂ®-face-shield-flex' -%}{%- assign rating = '4.6' -%}{%- assign review_count = 6 -%}{%- assign quote = 'Moves with my face. No cracking around the eyes.' -%}
                  {%- when 'colorescience-all-calm-multi-correction-serum' -%}{%- assign rating = '4.6' -%}{%- assign review_count = 5 -%}{%- assign quote = 'My rosacea is the calmest it has been in years.' -%}
                  {%- when 'colorescience-no-show-mineral-sunscreen-spf50' -%}{%- assign rating = '4.5' -%}{%- assign review_count = 6 -%}{%- assign quote = 'Truly invisible mineral SPF for medium tones.' -%}
                  {%- when 'elta-md-uv-daily-tinted' -%}{%- assign rating = '4.8' -%}{%- assign review_count = 16 -%}{%- assign quote = 'The sunscreen-makeup hybrid I have been looking for.' -%}
                  {%- when 'eltamd-uv-sport-broad-spectrum-spf-50' -%}{%- assign rating = '4.7' -%}{%- assign review_count = 10 -%}{%- assign quote = 'Sweats through workouts without my eyes burning.' -%}
                  {%- when 'eltamd-uv-sport-spf-50-226g' -%}{%- assign rating = '4.8' -%}{%- assign review_count = 4 -%}{%- assign quote = 'Family-size for beach days. Lasts the whole vacation.' -%}
                  {%- when 'omnilux-contour-face-red-light-infrared-light-therapy' -%}{%- assign rating = '4.8' -%}{%- assign review_count = 14 -%}{%- assign quote = 'Ten minutes a day for a few months. Real changes.' -%}
                {%- endcase -%}
              {%- endif -%}

              <a href="{{ product.url }}" class="lux-card" data-concerns="{{ product_concerns | strip }}">
                <div class="lux-card__image-wrapper">
                  {%- if on_sale -%}<span class="lux-card__sale">Sale</span>{%- endif -%}
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | img_url: '900x' }}"
                      alt="{{ product.title | escape }}"
                      class="lux-card__image"
                      loading="lazy"
                      width="900"
                      height="1125"
                    >
                  {% endif %}
                </div>

                <div class="lux-card__body">
                  <h3 class="lux-card__title">{{ product.title }}</h3>
                  {%- if tagline != blank -%}
                    <p class="lux-card__tagline">{{ tagline }}</p>
                  {%- endif -%}

                  {%- if rating != blank and review_count != blank -%}
                    <div class="lux-card__rating" aria-label="Rated {{ rating }} out of 5 from {{ review_count }} reviews">
                      <span class="lux-card__rating-star" aria-hidden="true">★</span>
                      <span class="lux-card__rating-value">{{ rating }}</span>
                      <span class="lux-card__rating-sep" aria-hidden="true">·</span>
                      <span class="lux-card__rating-count">{{ review_count }} reviews</span>
                    </div>
                  {%- endif -%}

                  {%- if quote != blank -%}
                    <blockquote class="lux-card__quote">
                      <span class="lux-card__quote-text">“{{ quote }}”</span>
                      <span class="lux-card__quote-attribution">— Verified Buyer</span>
                    </blockquote>
                  {%- endif -%}

                  <div class="lux-card__price{% if on_sale %} lux-card__price--on-sale{% endif %}">
                    {%- if on_sale -%}
                      <span class="lux-card__price-current">{{ product.price | money }}</span>
                      <span class="lux-card__price-compare">{{ product.compare_at_price | money }}</span>
                      {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                      <span class="lux-card__price-save">−{{ savings }}%</span>
                    {%- else -%}
                      {% if product.price_varies %}<span class="lux-card__price-from">From</span>{% endif %}
                      <span class="lux-card__price-current">{{ product.price | money }}</span>
                    {%- endif -%}
                  </div>

                  <span class="lux-card__cta">
                    <span>View Product</span>
                    <span class="lux-card__cta-arrow" aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            {% endfor %}
          </div>
        </section>
      {%- endfor -%}

      {%- if collection.products.size == 0 -%}
        <p class="lux-empty">No products found in this collection.</p>
      {%- endif -%}

      <p class="lux-no-matches" data-no-matches>
        No products match the selected filters on this page. Try clearing filters or visiting another page.
      </p>

      {% if paginate.pages > 1 %}
        <nav class="lux-pagination" aria-label="Pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="lux-pagination__nav">&larr; Previous</a>
          {% else %}
            <span class="lux-pagination__nav lux-pagination__nav--disabled">&larr; Previous</span>
          {% endif %}
          <div class="lux-pagination__pages">
            {% for part in paginate.parts %}
              {% if part.is_link %}
                <a href="{{ part.url }}" class="lux-pagination__page">{{ part.title }}</a>
              {% else %}
                {% if part.title == paginate.current_page %}
                  <span class="lux-pagination__page lux-pagination__page--current" aria-current="page">{{ part.title }}</span>
                {% else %}
                  <span class="lux-pagination__page lux-pagination__page--ellipsis">{{ part.title }}</span>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="lux-pagination__nav">Next &rarr;</a>
          {% else %}
            <span class="lux-pagination__nav lux-pagination__nav--disabled">Next &rarr;</span>
          {% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}

  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-lux-catalog]');
    if (!root) return;

    var intake = root.querySelector('[data-lux-intake]');
    var sortEl = root.querySelector('[data-lux-sort]');
    var personalizeBtn = root.querySelector('[data-intake-show]');

    // ===== Intake initial visibility =====
    if (intake) {
      var initParams = new URLSearchParams(window.location.search);
      var hasFilter = initParams.has('concerns') || initParams.has('brands');
      var skipFromUrl = initParams.get('view') === 'all';
      var skipFromStorage = false;
      try { skipFromStorage = sessionStorage.getItem('cc_intake_skip') === '1'; } catch (e) {}

      if (!hasFilter && !skipFromUrl && !skipFromStorage) {
        root.classList.add('lux-catalog--intake-mode');
      }

      var curateBtn = intake.querySelector('[data-intake-curate]');
      function updateCurateState() {
        var selected = intake.querySelectorAll('.lux-intake__chip.is-selected').length;
        if (curateBtn) curateBtn.disabled = selected === 0;
      }
      intake.querySelectorAll('.lux-intake__chip').forEach(function (chip) {
        chip.addEventListener('click', function () {
          chip.classList.toggle('is-selected');
          updateCurateState();
        });
      });
      updateCurateState();

      if (curateBtn) {
        curateBtn.addEventListener('click', function () {
          var concerns = [];
          var brands = [];
          intake.querySelector('[data-intake-concerns]').querySelectorAll('.is-selected').forEach(function (c) {
            concerns.push(c.dataset.value);
          });
          intake.querySelector('[data-intake-brands]').querySelectorAll('.is-selected').forEach(function (c) {
            brands.push(c.dataset.value);
          });
          var p = new URLSearchParams();
          if (concerns.length > 0) p.set('concerns', concerns.join(','));
          if (brands.length > 0) p.set('brands', brands.join(','));
          try { sessionStorage.setItem('cc_intake_skip', '1'); } catch (e) {}
          var qs = p.toString();
          window.location.href = window.location.pathname + (qs ? '?' + qs : '');
        });
      }

      var skipBtn = intake.querySelector('[data-intake-skip]');
      if (skipBtn) {
        skipBtn.addEventListener('click', function () {
          try { sessionStorage.setItem('cc_intake_skip', '1'); } catch (e) {}
          root.classList.remove('lux-catalog--intake-mode');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      if (personalizeBtn) {
        personalizeBtn.addEventListener('click', function (e) {
          e.preventDefault();
          var p = new URLSearchParams(window.location.search);
          var curC = (p.get('concerns') || '').split(',').filter(Boolean);
          var curB = (p.get('brands') || '').split(',').filter(Boolean);
          intake.querySelectorAll('.lux-intake__chip').forEach(function (c) { c.classList.remove('is-selected'); });
          curC.forEach(function (val) {
            var chip = intake.querySelector('[data-intake-concerns] [data-value="' + val + '"]');
            if (chip) chip.classList.add('is-selected');
          });
          curB.forEach(function (val) {
            var chip = intake.querySelector('[data-intake-brands] [data-value="' + val + '"]');
            if (chip) chip.classList.add('is-selected');
          });
          updateCurateState();
          try { sessionStorage.removeItem('cc_intake_skip'); } catch (e) {}
          root.classList.add('lux-catalog--intake-mode');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    }

    // ===== Sort dropdown =====
    if (sortEl) {
      sortEl.addEventListener('change', function (e) {
        var url = new URL(window.location.href);
        url.searchParams.set('sort_by', e.target.value);
        url.searchParams.delete('page');
        window.location.href = url.toString();
      });
    }

    // ===== Concern + Brand filter (client-side) =====
    function applyFilter() {
      var params = new URLSearchParams(window.location.search);
      var concernsParam = params.get('concerns') || '';
      var brandsParam = params.get('brands') || '';
      var activeConcerns = concernsParam ? concernsParam.split(',').map(function (c) { return c.trim(); }).filter(Boolean) : [];
      var activeBrands = brandsParam ? brandsParam.split(',').map(function (b) { return b.trim(); }).filter(Boolean) : [];
      var totalVisible = 0;

      root.querySelectorAll('.lux-brand').forEach(function (group) {
        var vendorSlug = group.dataset.vendorSlug || '';
        var brandMatches = activeBrands.length === 0 || activeBrands.indexOf(vendorSlug) !== -1;

        if (!brandMatches) {
          group.classList.add('lux-brand--hidden');
          return;
        }

        var visibleInGroup = 0;
        group.querySelectorAll('.lux-card').forEach(function (card) {
          var matches = true;
          if (activeConcerns.length > 0) {
            var concerns = (card.dataset.concerns || '').split(/\s+/).filter(Boolean);
            matches = activeConcerns.some(function (c) { return concerns.indexOf(c) !== -1; });
          }
          card.classList.toggle('lux-card--hidden', !matches);
          if (matches) visibleInGroup++;
        });

        group.classList.toggle('lux-brand--hidden', visibleInGroup === 0);
        var countEl = group.querySelector('[data-visible-count]');
        if (countEl) countEl.textContent = visibleInGroup;
        totalVisible += visibleInGroup;
      });

      var noMatch = root.querySelector('[data-no-matches]');
      if (noMatch) {
        noMatch.classList.toggle('lux-no-matches--visible', totalVisible === 0 && (activeConcerns.length > 0 || activeBrands.length > 0));
      }

      var totalEl = root.querySelector('[data-total-count]');
      if (totalEl && (activeConcerns.length > 0 || activeBrands.length > 0)) {
        totalEl.textContent = totalVisible + (totalVisible === 1 ? ' selection' : ' selections') + ' matched';
      }
    }

    applyFilter();
  })();
</script>

