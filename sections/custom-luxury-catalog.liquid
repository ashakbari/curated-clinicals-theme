
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

{%- assign current_concerns = request.params.concerns | default: '' -%}
{%- assign current_concerns_list = current_concerns | split: ',' -%}
{%- assign current_brands = request.params.brands | default: '' -%}
{%- assign current_brands_list = current_brands | split: ',' -%}
{%- assign current_sort = request.params.sort_by | default: collection.default_sort_by | default: 'manual' -%}

{%- assign sort_fragment = '' -%}
{%- if current_sort != 'manual' and current_sort != blank -%}
  {%- assign sort_fragment = '&sort_by=' | append: current_sort -%}
{%- endif -%}

{%- assign available_concerns_raw = '' -%}
{%- for tag in collection.all_tags -%}
  {%- if tag contains 'concern:' -%}
    {%- assign concern_slug = tag | remove: 'concern:' -%}
    {%- assign available_concerns_raw = available_concerns_raw | append: concern_slug | append: '|' -%}
  {%- endif -%}
{%- endfor -%}
{%- assign available_concerns_list = available_concerns_raw | split: '|' | uniq | sort -%}

{%- assign known_brands_str = 'Alastin Skincare|Colorescience|EltaMD|Hydrinity|Omnilux|Skinbetter Science|SkinCeuticals|SkinMedica|ZO Skin Health' -%}
{%- assign known_brands = known_brands_str | split: '|' -%}

<style>
  .lux-catalog *, .lux-catalog *::before, .lux-catalog *::after { box-sizing: border-box; }
  .lux-catalog {
    --gold: #c19a3d;
    --gold-light: #d8b865;
    --gold-deep: #8a6c1e;
    --gold-glow: rgba(193, 154, 61, 0.22);
    --ink: #0d0a08;
    --ink-rich: #1a1411;
    --ink-soft: #3a342f;
    --ink-muted: #6b635c;
    --ink-faint: #9a928a;
    --paper: #faf6ed;
    --paper-warm: #f1ebda;
    --paper-deep: #e8e0c9;
    --border: #d9d0bb;
    --border-strong: #b8ab8e;
    --shadow-card: 0 28px 60px -30px rgba(13, 10, 8, 0.35);
    --shadow-card-hover: 0 40px 80px -28px rgba(13, 10, 8, 0.5);
    --ff-display: 'Cormorant Garamond', 'Times New Roman', serif;
    --ff-body: 'DM Sans', system-ui, sans-serif;

    background: var(--paper);
    color: var(--ink);
    font-family: var(--ff-body);
    padding: 0;
    margin: 0;
  }

    .lux-hero {
    position: relative;
    background: var(--ink-rich);
    color: var(--paper);
    padding: 8rem 2rem 7rem;
    text-align: center;
    overflow: hidden;
  }
  .lux-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at top, rgba(193, 154, 61, 0.18), transparent 60%),
      radial-gradient(ellipse at bottom right, rgba(193, 154, 61, 0.08), transparent 50%);
    pointer-events: none;
  }
  .lux-hero__inner { position: relative; z-index: 1; max-width: 960px; margin: 0 auto; }
  .lux-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 1.4rem;
    font-family: var(--ff-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.55em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 2.25rem;
  }
  .lux-hero__eyebrow::before,
  .lux-hero__eyebrow::after {
    content: "";
    display: block;
    width: 3.5rem;
    height: 1px;
    background: var(--gold);
    opacity: 0.75;
  }
  .lux-hero__title {
    font-family: var(--ff-display);
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    font-weight: 300;
    font-style: italic;
    margin: 0;
    line-height: 0.95;
    letter-spacing: -0.015em;
    color: var(--paper);
  }
  .lux-hero__subtitle {
    margin: 2.5rem auto 0;
    font-family: var(--ff-display);
    font-style: italic;
    font-size: clamp(1.2rem, 1.6vw, 1.5rem);
    line-height: 1.55;
    color: rgba(250, 246, 237, 0.78);
    max-width: 680px;
    letter-spacing: 0.01em;
  }
  .lux-hero__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    margin: 3rem 0 0;
  }
  .lux-hero__divider::before,
  .lux-hero__divider::after {
    content: "";
    width: 4rem;
    height: 1px;
    background: var(--gold);
  }
  .lux-hero__divider-dot {
    width: 6px;
    height: 6px;
    background: var(--gold);
    transform: rotate(45deg);
  }
  .lux-hero__count {
    margin-top: 1.75rem;
    font-family: var(--ff-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: rgba(250, 246, 237, 0.6);
  }

    .lux-intake { display: none; }
  .lux-catalog--intake-mode .lux-intake { display: block; }
  .lux-catalog--intake-mode .lux-body { display: none; }

  .lux-intake {
    background: var(--paper-warm);
    border-bottom: 1px solid var(--border);
    padding: 6.5rem 2rem 6rem;
    position: relative;
  }
  .lux-intake::before {
    content: "";
    position: absolute;
    top: 0; left: 50%;
    transform: translateX(-50%);
    width: 8rem;
    height: 3px;
    background: var(--gold);
  }
  .lux-intake__inner { max-width: 920px; margin: 0 auto; text-align: center; }
  .lux-intake__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    font-family: var(--ff-body);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--gold-deep);
    margin-bottom: 1.5rem;
  }
  .lux-intake__eyebrow::before,
  .lux-intake__eyebrow::after {
    content: "";
    width: 2.5rem;
    height: 1px;
    background: var(--gold-deep);
    opacity: 0.6;
  }
  .lux-intake__title {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    font-weight: 300;
    margin: 0 0 1.5rem;
    color: var(--ink-rich);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .lux-intake__subtitle {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 620px;
    margin: 0 auto;
  }
  .lux-intake__step { margin-top: 4rem; }
  .lux-intake__step-label {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: clamp(1.3rem, 1.8vw, 1.65rem);
    font-weight: 400;
    color: var(--ink-rich);
    margin: 0 0 1.75rem;
  }
  .lux-intake__chip-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
  }
  .lux-intake__chip {
    font-family: var(--ff-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-rich);
    background: var(--paper);
    border: 1px solid var(--border-strong);
    padding: 0.85rem 1.5rem;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .lux-intake__chip:hover {
    border-color: var(--ink-rich);
    color: var(--ink-rich);
  }
  .lux-intake__chip.is-selected {
    background: var(--ink-rich);
    color: var(--paper);
    border-color: var(--ink-rich);
    box-shadow: inset 0 0 0 2px var(--gold);
  }
  .lux-intake__actions {
    margin-top: 4.5rem;
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
  }
  .lux-intake__cta {
    font-family: var(--ff-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 1.2rem 2.5rem;
    border: 1px solid var(--ink-rich);
    background: var(--ink-rich);
    color: var(--paper);
    transition: all 0.3s ease;
  }
  .lux-intake__cta--primary:hover:not(:disabled) {
    background: var(--gold-deep);
    border-color: var(--gold-deep);
  }
  .lux-intake__cta--primary:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .lux-intake__cta--secondary {
    background: transparent;
    color: var(--ink-rich);
    border: none;
    border-bottom: 1px solid var(--ink-rich);
    padding: 1.2rem 0;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    letter-spacing: 0.35em;
  }
  .lux-intake__cta--secondary:hover {
    color: var(--gold-deep);
    border-bottom-color: var(--gold-deep);
  }
  .lux-intake__cta-arrow {
    font-size: 0.95rem;
    transition: transform 0.3s ease;
  }
  .lux-intake__cta--secondary:hover .lux-intake__cta-arrow {
    transform: translateX(5px);
  }

    .lux-personalize {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--ff-body);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ink-rich);
    background: transparent;
    border: 1px solid var(--ink-rich);
    padding: 0.6rem 1.1rem;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }
  .lux-personalize:hover {
    background: var(--ink-rich);
    color: var(--paper);
  }
  .lux-personalize__icon { font-size: 0.85rem; line-height: 1; }

  .lux-active-row__right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .lux-intake { padding: 4.5rem 1rem 4rem; }
    .lux-intake__step { margin-top: 3rem; }
    .lux-intake__actions { margin-top: 3rem; gap: 1.25rem; }
    .lux-intake__chip { font-size: 0.7rem; padding: 0.7rem 1.2rem; letter-spacing: 0.15em; }
    .lux-intake__cta { padding: 1rem 2rem; font-size: 0.65rem; letter-spacing: 0.3em; }
  }

    .lux-body { padding: 6rem 2rem 6rem; }
  .lux-intro {
    max-width: 760px;
    margin: 0 auto 5rem;
    text-align: center;
    font-family: var(--ff-display);
    font-style: italic;
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    line-height: 1.7;
    color: var(--ink-soft);
  }

    .lux-filter {
    max-width: 1400px;
    margin: 0 auto 3rem;
    background: var(--paper-warm);
    border: 1px solid var(--border);
    padding: 2.25rem;
  }
  .lux-filter__main {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .lux-filter__filters { flex: 1 1 60%; min-width: 280px; display: flex; flex-direction: column; gap: 1.75rem; }
  .lux-filter__row { display: flex; flex-direction: column; gap: 1rem; }
  .lux-filter__label {
    display: block;
    font-family: var(--ff-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .lux-chip-row { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .lux-chip {
    display: inline-block;
    font-family: var(--ff-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding: 0.75rem 1.3rem;
    background: var(--paper);
    border: 1px solid var(--border-strong);
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }
  .lux-chip:hover {
    background: var(--ink-rich);
    color: var(--paper);
    border-color: var(--ink-rich);
  }
  .lux-chip--active {
    background: var(--ink-rich);
    color: var(--paper);
    border-color: var(--ink-rich);
    box-shadow: inset 0 0 0 2px var(--gold);
  }

  .lux-sort-group { flex: 0 0 auto; }
  .lux-sort-wrap { position: relative; display: inline-block; }
  .lux-sort {
    appearance: none;
    -webkit-appearance: none;
    font-family: var(--ff-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--border-strong);
    padding: 0.75rem 2.85rem 0.75rem 1.3rem;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .lux-sort:hover { background: var(--ink-rich); color: var(--paper); border-color: var(--ink-rich); }
  .lux-sort:hover + .lux-sort-caret { color: var(--paper); }
  .lux-sort-caret {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.65rem;
    pointer-events: none;
    color: var(--ink);
    transition: color 0.25s ease;
  }

    .lux-active-row {
    max-width: 1400px;
    margin: 0 auto 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .lux-active-row__left { display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap; flex: 1; }
  .lux-result-count {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }
  .lux-active-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--ff-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--paper);
    text-decoration: none;
    padding: 0.5rem 0.9rem;
    background: var(--gold-deep);
    border: 1px solid var(--gold-deep);
    transition: all 0.25s ease;
  }
  .lux-active-pill--brand {
    background: var(--ink-rich);
    border-color: var(--ink-rich);
  }
  .lux-active-pill:hover {
    background: var(--ink);
    border-color: var(--ink);
  }
  .lux-active-pill__x { font-size: 1rem; line-height: 1; font-weight: 400; }
  .lux-clear-all {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--ink-soft);
    padding-bottom: 2px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .lux-clear-all:hover { color: var(--gold-deep); border-color: var(--gold-deep); }

  .lux-top {
    position: fixed;
    left: 1.1rem;
    bottom: 1.3rem;
    z-index: 900;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 0.72rem 0.9rem;
    background: rgba(13, 10, 8, 0.86);
    color: #f3ead2;
    border: 1px solid rgba(216, 184, 101, 0.35);
    border-radius: 999px;
    font-family: var(--ff-body);
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }
  .lux-top__arr { font-size: 1rem; letter-spacing: 0; line-height: 1; }
  .lux-top.is-vis { opacity: 1; transform: none; pointer-events: auto; }
  .lux-top:hover { background: var(--ink); border-color: var(--gold); }

    .lux-brand {
    max-width: 1400px;
    margin: 0 auto 7rem;
    content-visibility: auto;
    contain-intrinsic-size: auto 1400px;
    scroll-margin-top: 5rem;
  }
  .lux-brand:last-of-type { margin-bottom: 0; }
  .lux-brand--hidden { display: none; }

  .lux-brand__header {
    margin-bottom: 3.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  .lux-brand__header::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 7rem;
    height: 2px;
    background: var(--gold);
  }
  .lux-brand__header-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  @media (min-width: 701px) {
    .lux-brand__header-top {
      position: sticky;
      top: var(--header-height, 0px);
      z-index: 7;
      background: linear-gradient(to bottom, var(--paper) 78%, rgba(250, 246, 237, 0));
      padding: 1rem 0 0.9rem;
      margin-bottom: 0.5rem;
    }
  }
  .lux-brand__name {
    font-family: var(--ff-display);
    font-size: clamp(2rem, 3.2vw, 2.9rem);
    font-weight: 300;
    margin: 0;
    color: var(--ink-rich);
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .lux-brand__count {
    font-family: var(--ff-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--gold-deep);
    flex-shrink: 0;
  }
  .lux-brand__story {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 820px;
    margin: 0;
  }

    .lux-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.5rem 2.25rem;
  }
  @media (min-width: 1500px) {
    .lux-grid { grid-template-columns: repeat(4, 1fr); gap: 3.5rem 2rem; }
  }
  @media (max-width: 1100px) {
    .lux-grid { grid-template-columns: repeat(2, 1fr); gap: 3rem 1.75rem; }
  }

    .lux-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    animation: lux-fade-up 0.5s cubic-bezier(0.25, 1, 0.5, 1) both;
  }
  @keyframes lux-fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .lux-card--hidden { display: none; }

  .lux-card__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    background: #fff;
    overflow: hidden;
    margin-bottom: 1.25rem;
    border-radius: 14px;
    box-shadow: var(--shadow-card);
    transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.45s ease;
  }
  .lux-card:hover .lux-card__image-wrapper {
    transform: translateY(-5px);
    box-shadow: var(--shadow-card-hover);
  }
  .lux-card__image-wrapper::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid rgba(0, 0, 0, 0.05);
    pointer-events: none;
    z-index: 4;
  }
  .lux-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .lux-card:hover .lux-card__image { transform: scale(1.05); }

  .lux-card__image--secondary {
    opacity: 0;
    transform: scale(1.08);
    transition: opacity 0.45s ease, transform 1.2s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 2;
  }
  .lux-card:hover .lux-card__image--secondary,
  .lux-card:focus-visible .lux-card__image--secondary {
    opacity: 1;
    transform: scale(1.02);
  }

  .lux-card__peek {
    position: absolute;
    left: 50%;
    bottom: 1.1rem;
    transform: translate(-50%, 10px);
    opacity: 0;
    z-index: 5;
    background: rgba(13, 10, 8, 0.84);
    color: #f3ead2;
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
    font-family: var(--ff-body);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
    white-space: nowrap;
  }
  .lux-card:hover .lux-card__peek {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  @media (hover: none) { .lux-card__peek { display: none; } }

  .ccr-st {
    position: relative;
    display: inline-block;
    font-size: 0.92rem;
    line-height: 1;
    color: #d9cdb6;
    letter-spacing: 0.08em;
  }
  .ccr-st__f {
    position: absolute;
    left: 0;
    top: 0;
    overflow: hidden;
    white-space: nowrap;
    color: var(--gold);
  }

  .lux-card__sale {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 3;
    background: var(--gold);
    color: var(--ink-rich);
    font-family: var(--ff-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    padding: 0.65rem 1.1rem;
  }

