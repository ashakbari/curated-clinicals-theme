{% comment %}
  ============================================================================
  CUSTOM LUXURY CATALOG / COLLECTION PAGE
  Editorial lookbook layout: two large cards per row
  ============================================================================
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

{%- comment -%} Discover available concerns from all collection tags {%- endcomment -%}
{%- assign available_concerns_raw = '' -%}
{%- for tag in collection.all_tags -%}
  {%- if tag contains 'concern:' -%}
    {%- assign concern_slug = tag | remove: 'concern:' -%}
    {%- assign available_concerns_raw = available_concerns_raw | append: concern_slug | append: '|' -%}
  {%- endif -%}
{%- endfor -%}
{%- assign available_concerns_list = available_concerns_raw | split: '|' | uniq | sort -%}

{%- comment -%} Read current state from URL {%- endcomment -%}
{%- assign current_concerns = request.params.concerns | default: '' -%}
{%- assign current_concerns_list = current_concerns | split: ',' -%}
{%- assign current_sort = request.params.sort_by | default: collection.default_sort_by | default: 'manual' -%}

{%- assign sort_fragment = '' -%}
{%- if current_sort != 'manual' and current_sort != blank -%}
  {%- assign sort_fragment = '&sort_by=' | append: current_sort -%}
{%- endif -%}

<style>
  .lux-catalog *, .lux-catalog *::before, .lux-catalog *::after { box-sizing: border-box; }
  .lux-catalog {
    --gold: #c19a3d;
    --gold-light: #d8b865;
    --gold-deep: #8a6c1e;
    --gold-glow: rgba(193, 154, 61, 0.22);
    --ink: #0d0a08;
    --ink-rich: #1a1411;
    --ink-soft: #3a342f;
    --ink-muted: #6b635c;
    --ink-faint: #9a928a;
    --paper: #faf6ed;
    --paper-warm: #f1ebda;
    --paper-deep: #e8e0c9;
    --border: #d9d0bb;
    --border-strong: #b8ab8e;
    --shadow-card: 0 28px 60px -30px rgba(13, 10, 8, 0.35);
    --shadow-card-hover: 0 40px 80px -28px rgba(13, 10, 8, 0.5);
    --ff-display: 'Cormorant Garamond', 'Times New Roman', serif;
    --ff-body: 'DM Sans', system-ui, sans-serif;

    background: var(--paper);
    color: var(--ink);
    font-family: var(--ff-body);
    padding: 0;
    margin: 0;
  }

  /* ============================================================
     HERO BAND
     ============================================================ */
  .lux-hero {
    position: relative;
    background: var(--ink-rich);
    color: var(--paper);
    padding: 8rem 2rem 7rem;
    text-align: center;
    overflow: hidden;
  }
  .lux-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at top, rgba(193, 154, 61, 0.18), transparent 60%),
      radial-gradient(ellipse at bottom right, rgba(193, 154, 61, 0.08), transparent 50%);
    pointer-events: none;
  }
  .lux-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
  }
  .lux-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 1.4rem;
    font-family: var(--ff-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.55em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 2.25rem;
  }
  .lux-hero__eyebrow::before,
  .lux-hero__eyebrow::after {
    content: "";
    display: block;
    width: 3.5rem;
    height: 1px;
    background: var(--gold);
    opacity: 0.75;
  }
  .lux-hero__title {
    font-family: var(--ff-display);
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    font-weight: 300;
    font-style: italic;
    margin: 0;
    line-height: 0.95;
    letter-spacing: -0.015em;
    color: var(--paper);
  }
  .lux-hero__subtitle {
    margin: 2.5rem auto 0;
    font-family: var(--ff-display);
    font-style: italic;
    font-size: clamp(1.2rem, 1.6vw, 1.5rem);
    line-height: 1.55;
    color: rgba(250, 246, 237, 0.78);
    max-width: 680px;
    letter-spacing: 0.01em;
  }
  .lux-hero__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    margin: 3rem 0 0;
  }
  .lux-hero__divider::before,
  .lux-hero__divider::after {
    content: "";
    width: 4rem;
    height: 1px;
    background: var(--gold);
  }
  .lux-hero__divider-dot {
    width: 6px;
    height: 6px;
    background: var(--gold);
    transform: rotate(45deg);
  }
  .lux-hero__count {
    margin-top: 1.75rem;
    font-family: var(--ff-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: rgba(250, 246, 237, 0.6);
  }

  /* ============================================================
     BODY
     ============================================================ */
  .lux-body {
    padding: 6rem 2rem 6rem;
  }

  .lux-intro {
    max-width: 760px;
    margin: 0 auto 5rem;
    text-align: center;
    font-family: var(--ff-display);
    font-style: italic;
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  /* ===== FILTER ===== */
  .lux-filter {
    max-width: 1400px;
    margin: 0 auto 3.5rem;
    background: var(--paper-warm);
    border: 1px solid var(--border);
    padding: 2.25rem 2.25rem 2rem;
  }
  .lux-filter__main {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .lux-filter__group { flex: 1 1 auto; min-width: 280px; }
  .lux-filter__label {
    display: block;
    font-family: var(--ff-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 1.1rem;
  }
  .lux-chip-row { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .lux-chip {
    display: inline-block;
    font-family: var(--ff-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding: 0.75rem 1.3rem;
    background: var(--paper);
    border: 1px solid var(--border-strong);
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }
  .lux-chip:hover {
    background: var(--ink-rich);
    color: var(--paper);
    border-color: var(--ink-rich);
  }
  .lux-chip--active {
    background: var(--ink-rich);
    color: var(--paper);
    border-color: var(--ink-rich);
    box-shadow: inset 0 0 0 2px var(--gold);
  }

  .lux-sort-group { flex: 0 0 auto; }
  .lux-sort-wrap { position: relative; display: inline-block; }
  .lux-sort {
    appearance: none;
    -webkit-appearance: none;
    font-family: var(--ff-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--border-strong);
    padding: 0.75rem 2.85rem 0.75rem 1.3rem;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .lux-sort:hover { background: var(--ink-rich); color: var(--paper); border-color: var(--ink-rich); }
  .lux-sort:hover + .lux-sort-caret { color: var(--paper); }
  .lux-sort-caret {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.65rem;
    pointer-events: none;
    color: var(--ink);
    transition: color 0.25s ease;
  }

  /* ===== ACTIVE ROW ===== */
  .lux-active-row {
    max-width: 1400px;
    margin: 0 auto 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .lux-active-row__left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    flex: 1;
  }
  .lux-result-count {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }
  .lux-active-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--ff-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--paper);
    text-decoration: none;
    padding: 0.5rem 0.9rem;
    background: var(--gold-deep);
    border: 1px solid var(--gold-deep);
    transition: all 0.25s ease;
  }
  .lux-active-pill:hover { background: var(--ink-rich); border-color: var(--ink-rich); }
  .lux-active-pill__x { font-size: 1rem; line-height: 1; font-weight: 400; }
  .lux-clear-all {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--ink-soft);
    padding-bottom: 2px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .lux-clear-all:hover { color: var(--gold-deep); border-color: var(--gold-deep); }

  /* ============================================================
     BRAND SECTION
     ============================================================ */
  .lux-brand {
    max-width: 1400px;
    margin: 0 auto 9rem;
  }
  .lux-brand:last-of-type { margin-bottom: 0; }
  .lux-brand--hidden { display: none; }

  .lux-brand__header {
    margin-bottom: 5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  .lux-brand__header::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 7rem;
    height: 2px;
    background: var(--gold);
  }
  .lux-brand__header-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .lux-brand__name {
    font-family: var(--ff-display);
    font-size: clamp(2.75rem, 5.5vw, 4.25rem);
    font-weight: 300;
    margin: 0;
    color: var(--ink-rich);
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .lux-brand__count {
    font-family: var(--ff-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--gold-deep);
    flex-shrink: 0;
  }
  .lux-brand__story {
    font-family: var(--ff-display);
    font-style: italic;
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 820px;
    margin: 0;
  }

  /* ============================================================
     GRID — 2 LARGE CARDS PER ROW
     ============================================================ */
  .lux-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 7rem 5rem;
  }

  /* ============================================================
     CARD — editorial, large, image-dominant
     ============================================================ */
  .lux-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    animation: lux-fade-up 0.8s cubic-bezier(0.25, 1, 0.5, 1) both;
  }
  @keyframes lux-fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .lux-card--hidden { display: none; }

  .lux-card__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    background: #fff;
    overflow: hidden;
    margin-bottom: 2.25rem;
    box-shadow: var(--shadow-card);
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.6s ease;
  }
  .lux-card:hover .lux-card__image-wrapper {
    transform: translateY(-8px);
    box-shadow: var(--shadow-card-hover);
  }
  .lux-card__image-wrapper::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid rgba(0, 0, 0, 0.05);
    pointer-events: none;
    z-index: 4;
  }
  .lux-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .lux-card:hover .lux-card__image { transform: scale(1.05); }

  /* Sale badge */
  .lux-card__sale {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 3;
    background: var(--gold);
    color: var(--ink-rich);
    font-family: var(--ff-body);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    padding: 0.65rem 1.1rem;
  }

  /* Card body */
  .lux-card__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0 0.5rem;
  }

  .lux-card__type {
    font-family: var(--ff-body);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--gold-deep);
    margin: 0;
  }
  .lux-card__title {
    font-family: var(--ff-display);
    font-size: clamp(1.85rem, 2.4vw, 2.6rem);
    font-weight: 400;
    line-height: 1.1;
    margin: 0;
    color: var(--ink-rich);
    letter-spacing: -0.005em;
  }
  .lux-card__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.85rem;
    font-family: var(--ff-body);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--ink-rich);
    letter-spacing: 0.02em;
    margin: 0.25rem 0 0;
  }
  .lux-card__price-current { color: var(--ink-rich); font-weight: 600; }
  .lux-card__price--on-sale .lux-card__price-current { color: var(--gold-deep); }
  .lux-card__price-compare {
    color: var(--ink-faint);
    text-decoration: line-through;
    font-weight: 400;
    font-size: 1rem;
  }
  .lux-card__price-from {
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-weight: 700;
  }
  .lux-card__price-save {
    display: inline-block;
    margin-left: auto;
    font-family: var(--ff-body);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold-deep);
    background: var(--gold-glow);
    padding: 0.4rem 0.75rem;
  }

  /* CTA — refined arrow link */
  .lux-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--ink-rich);
    font-family: var(--ff-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--ink-rich);
    align-self: flex-start;
    transition: color 0.3s ease, border-color 0.3s ease, gap 0.4s ease;
  }
  .lux-card__cta-arrow {
    font-size: 0.95rem;
    transition: transform 0.35s ease;
  }
  .lux-card:hover .lux-card__cta {
    color: var(--gold-deep);
    border-bottom-color: var(--gold-deep);
    gap: 1.4rem;
  }
  .lux-card:hover .lux-card__cta-arrow { transform: translateX(6px); }

  /* ===== EMPTY ===== */
  .lux-empty,
  .lux-no-matches {
    grid-column: 1 / -1;
    text-align: center;
    font-family: var(--ff-display);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--ink-soft);
    padding: 6rem 0;
    max-width: 1400px;
    margin: 0 auto;
  }
  .lux-no-matches { display: none; }
  .lux-no-matches--visible { display: block; }

  /* ============================================================
     PAGINATION
     ============================================================ */
  .lux-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    max-width: 1400px;
    margin: 6rem auto 0;
    padding-top: 4rem;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .lux-pagination__nav {
    font-family: var(--ff-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--ink-rich);
    text-decoration: none;
    padding: 0.75rem 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, color 0.3s ease;
  }
  .lux-pagination__nav:hover { border-bottom-color: var(--gold); color: var(--gold-deep); }
  .lux-pagination__nav--disabled { color: var(--ink-faint); opacity: 0.5; cursor: not-allowed; }
  .lux-pagination__pages { display: flex; align-items: center; gap: 1.4rem; }
  .lux-pagination__page {
    font-family: var(--ff-display);
    font-size: 1.3rem;
    font-style: italic;
    color: var(--ink-muted);
    text-decoration: none;
    min-width: 1.5rem;
    text-align: center;
    transition: color 0.3s ease;
  }
  .lux-pagination__page:hover { color: var(--gold-deep); }
  .lux-pagination__page--current {
    color: var(--ink-rich);
    font-weight: 500;
    font-size: 1.6rem;
    position: relative;
  }
  .lux-pagination__page--current::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -0.65rem;
    width: 7px;
    height: 7px;
    background: var(--gold);
    transform: translateX(-50%) rotate(45deg);
  }
  .lux-pagination__page--ellipsis { color: var(--ink-faint); cursor: default; }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 900px) {
    .lux-filter__main { flex-direction: column; align-items: stretch; }
    .lux-sort-group { align-self: flex-start; }
    .lux-sort-wrap { display: block; }
    .lux-sort { width: 100%; }
  }
  @media (max-width: 768px) {
    .lux-hero { padding: 5.5rem 1.25rem 5rem; }
    .lux-hero__eyebrow::before,
    .lux-hero__eyebrow::after { width: 1.75rem; }
    .lux-body { padding: 4rem 1rem 4rem; }
    .lux-intro { margin-bottom: 3rem; font-size: 1rem; }
    .lux-filter { padding: 1.5rem; margin-bottom: 2.5rem; }
    .lux-chip { font-size: 0.65rem; padding: 0.65rem 1rem; letter-spacing: 0.13em; }
    .lux-brand { margin-bottom: 6rem; }
    .lux-brand__header { margin-bottom: 3rem; padding-bottom: 1.75rem; }
    .lux-brand__story { font-size: 1.05rem; }
    .lux-grid {
      grid-template-columns: 1fr;
      gap: 5rem;
    }
    .lux-card__image-wrapper { margin-bottom: 1.5rem; }
    .lux-card__title { font-size: 1.55rem; }
    .lux-card__price { font-size: 1.05rem; }
    .lux-card__cta { font-size: 0.65rem; letter-spacing: 0.32em; }
  }
  @media (max-width: 480px) {
    .lux-grid { gap: 4rem; }
  }
  @media (max-width: 600px) {
    .lux-pagination { gap: 1.5rem; margin-top: 4rem; padding-top: 2.5rem; }
    .lux-pagination__pages { gap: 0.85rem; }
    .lux-pagination__page { font-size: 1.05rem; }
    .lux-pagination__page--current { font-size: 1.25rem; }
  }
</style>

<div class="lux-catalog" data-lux-catalog>

  {%- comment -%} ============ HERO ============ {%- endcomment -%}
  <section class="lux-hero">
    <div class="lux-hero__inner">
      <span class="lux-hero__eyebrow">{{ section.settings.eyebrow_text | default: 'Medical-Grade Skincare' }}</span>
      <h1 class="lux-hero__title">{{ collection.title | default: 'Our Curated Collection' }}</h1>
      {%- if section.settings.subtitle_text != blank -%}
        <p class="lux-hero__subtitle">{{ section.settings.subtitle_text }}</p>
      {%- endif -%}
      <div class="lux-hero__divider" aria-hidden="true">
        <span class="lux-hero__divider-dot"></span>
      </div>
      <p class="lux-hero__count">
        Explore {{ collection.products_count | default: 0 }} {% if collection.products_count == 1 %}Selection{% else %}Selections{% endif %}
      </p>
    </div>
  </section>

  {%- comment -%} ============ BODY ============ {%- endcomment -%}
  <div class="lux-body">

    {%- if section.settings.intro_text != blank -%}
      <p class="lux-intro">{{ section.settings.intro_text }}</p>
    {%- endif -%}

    <div class="lux-filter" data-lux-filter>
      <div class="lux-filter__main">
        <div class="lux-filter__group">
          <span class="lux-filter__label">Filter by skin concern</span>
          <div class="lux-chip-row">
            {%- for concern in available_concerns_list -%}
              {%- if concern == blank -%}{% continue %}{%- endif -%}
              {%- assign concern_label = concern | replace: '-', ' ' | capitalize -%}
              {%- assign is_active = false -%}
              {%- if current_concerns_list contains concern -%}{%- assign is_active = true -%}{%- endif -%}

              {%- if is_active -%}
                {%- assign other_concerns = '' -%}
                {%- for c in current_concerns_list -%}
                  {%- unless c == concern -%}
                    {%- if other_concerns == '' -%}{%- assign other_concerns = c -%}
                    {%- else -%}{%- assign other_concerns = other_concerns | append: ',' | append: c -%}{%- endif -%}
                  {%- endunless -%}
                {%- endfor -%}
                {%- if other_concerns != '' -%}
                  <a href="?concerns={{ other_concerns }}{{ sort_fragment }}" class="lux-chip lux-chip--active" data-concern="{{ concern }}">{{ concern_label }}</a>
                {%- else -%}
                  <a href="?{% if current_sort != 'manual' and current_sort != blank %}sort_by={{ current_sort }}{% endif %}" class="lux-chip lux-chip--active" data-concern="{{ concern }}">{{ concern_label }}</a>
                {%- endif -%}
              {%- else -%}
                {%- assign joined = current_concerns_list | join: ',' -%}
                {%- if joined != '' -%}
                  {%- assign new_concerns = joined | append: ',' | append: concern -%}
                {%- else -%}
                  {%- assign new_concerns = concern -%}
                {%- endif -%}
                <a href="?concerns={{ new_concerns }}{{ sort_fragment }}" class="lux-chip" data-concern="{{ concern }}">{{ concern_label }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <div class="lux-filter__group lux-sort-group">
          <span class="lux-filter__label">Sort by</span>
          <div class="lux-sort-wrap">
            <select class="lux-sort" data-lux-sort aria-label="Sort products">
              <option value="manual"{% if current_sort == 'manual' %} selected{% endif %}>Featured</option>
              <option value="best-selling"{% if current_sort == 'best-selling' %} selected{% endif %}>Best Selling</option>
              <option value="price-ascending"{% if current_sort == 'price-ascending' %} selected{% endif %}>Price: Low to High</option>
              <option value="price-descending"{% if current_sort == 'price-descending' %} selected{% endif %}>Price: High to Low</option>
              <option value="title-ascending"{% if current_sort == 'title-ascending' %} selected{% endif %}>Name: A–Z</option>
              <option value="title-descending"{% if current_sort == 'title-descending' %} selected{% endif %}>Name: Z–A</option>
              <option value="created-descending"{% if current_sort == 'created-descending' %} selected{% endif %}>Newest</option>
            </select>
            <span class="lux-sort-caret" aria-hidden="true">▾</span>
          </div>
        </div>
      </div>
    </div>

    <div class="lux-active-row">
      <div class="lux-active-row__left">
        <span class="lux-result-count" data-total-count>
          {{ collection.products_count | default: 0 }} {% if collection.products_count == 1 %}selection{% else %}selections{% endif %}
        </span>
        {%- if current_concerns != '' -%}
          {%- for concern in current_concerns_list -%}
            {%- if concern == blank -%}{% continue %}{%- endif -%}
            {%- assign concern_label = concern | replace: '-', ' ' | capitalize -%}
            {%- assign other_concerns = '' -%}
            {%- for c in current_concerns_list -%}
              {%- unless c == concern -%}
                {%- if other_concerns == '' -%}{%- assign other_concerns = c -%}
                {%- else -%}{%- assign other_concerns = other_concerns | append: ',' | append: c -%}{%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
            <a href="?{% if other_concerns != '' %}concerns={{ other_concerns }}{{ sort_fragment }}{% else %}{% if current_sort != 'manual' and current_sort != blank %}sort_by={{ current_sort }}{% endif %}{% endif %}" class="lux-active-pill">
              <span>{{ concern_label }}</span>
              <span class="lux-active-pill__x">×</span>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
      {%- if current_concerns != '' -%}
        <a href="{% if current_sort != 'manual' and current_sort != blank %}?sort_by={{ current_sort }}{% else %}{{ canonical_url | default: request.path }}{% endif %}" class="lux-clear-all">Clear all filters</a>
      {%- endif -%}
    </div>

    {%- comment -%} ===== BRAND SECTIONS ===== {%- endcomment -%}
    {% paginate collection.products by 48 %}
      {%- assign vendor_buf = '' -%}
      {%- for product in collection.products -%}
        {%- assign v = product.vendor | default: 'Other' -%}
        {%- unless vendor_buf contains v -%}
          {%- assign vendor_buf = vendor_buf | append: v | append: '|||' -%}
        {%- endunless -%}
      {%- endfor -%}
      {%- assign vendors_on_page = vendor_buf | split: '|||' | sort_natural -%}

      {%- for vendor_name in vendors_on_page -%}
        {%- if vendor_name == blank -%}{% continue %}{%- endif -%}
        {%- assign vendor_products = collection.products | where: 'vendor', vendor_name -%}
        {%- if vendor_products.size == 0 -%}{% continue %}{%- endif -%}

        {%- assign brand_story = '' -%}
        {%- case vendor_name -%}
          {%- when 'Alastin Skincare' -%}
            {%- assign brand_story = "Aesthetic-physician-led skincare engineered to pair with in-clinic procedures. Alastin's patented TriHex Technology supports the skin's natural ability to clear damaged proteins and rebuild healthier collagen and elastin." -%}
          {%- when 'Colorescience' -%}
            {%- assign brand_story = 'Mineral-only sun and skin protection developed for the most sensitive complexions. The Sunforgettable line is among the most-reapplied SPF formulas in North American dermatology offices.' -%}
          {%- when 'EltaMD' -%}
            {%- assign brand_story = 'The gold standard of dermatologist-recommended sunscreen. Transparent zinc oxide engineered to feel like nothing on the skin—elegant enough for daily wear, rigorous enough for clinical use.' -%}
          {%- when 'Hydrinity' -%}
            {%- assign brand_story = "Supercharged hyaluronic acid bioidentical to the body's own. Clinically proven to penetrate deeper than standard HA, delivering hydration where conventional serums plateau." -%}
          {%- when 'Omnilux' -%}
            {%- assign brand_story = 'Medical-grade, FDA-cleared red and near-infrared light therapy. The same wavelengths used in dermatology offices—backed by 40+ peer-reviewed studies, now engineered for at-home use.' -%}
          {%- when 'Skinbetter Science' -%}
            {%- assign brand_story = "More than a decade of clinical research distilled into a single molecule. Skinbetter's patented AlphaRet delivers retinoid-grade results with markedly improved tolerability. Available only through licensed providers." -%}
          {%- when 'SkinCeuticals' -%}
            {%- assign brand_story = "The brand that defined daytime antioxidant protection. SkinCeuticals' L-ascorbic acid serums—anchored by the iconic C E Ferulic—set the global standard for vitamin C in aesthetic dermatology." -%}
          {%- when 'SkinMedica' -%}
            {%- assign brand_story = "An Allergan Aesthetics brand pioneering growth factor and peptide complexes. The TNS lineup leverages a proprietary fibroblast-conditioned media to support the skin's own renewal capacity." -%}
          {%- when 'ZO Skin Health' -%}
            {%- assign brand_story = 'Founded by Dr. Zein Obagi, ZO Skin Health is built around a philosophy of total skin restoration—pairing high-actives with barrier support for visible, lasting change.' -%}
        {%- endcase -%}

        <section class="lux-brand" data-vendor="{{ vendor_name | escape }}">
          <div class="lux-brand__header">
            <div class="lux-brand__header-top">
              <h2 class="lux-brand__name">{{ vendor_name }}</h2>
              <span class="lux-brand__count">
                <span data-visible-count>{{ vendor_products.size }}</span> {% if vendor_products.size == 1 %}Selection{% else %}Selections{% endif %}
              </span>
            </div>
            {%- if brand_story != '' -%}
              <p class="lux-brand__story">{{ brand_story }}</p>
            {%- endif -%}
          </div>

          <div class="lux-grid">
            {% for product in vendor_products %}
              {%- assign on_sale = false -%}
              {%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}

              {%- assign product_concerns = '' -%}
              {%- for tag in product.tags -%}
                {%- if tag contains 'concern:' -%}
                  {%- assign cslug = tag | remove: 'concern:' -%}
                  {%- assign product_concerns = product_concerns | append: cslug | append: ' ' -%}
                {%- endif -%}
              {%- endfor -%}

              <a href="{{ product.url }}" class="lux-card" data-concerns="{{ product_concerns | strip }}">
                <div class="lux-card__image-wrapper">
                  {%- if on_sale -%}
                    <span class="lux-card__sale">Sale</span>
                  {%- endif -%}
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | img_url: '900x' }}"
                      alt="{{ product.title | escape }}"
                      class="lux-card__image"
                      loading="lazy"
                      width="900"
                      height="1125"
                    >
                  {% endif %}
                </div>

                <div class="lux-card__body">
                  {%- if product.type != blank -%}
                    <span class="lux-card__type">{{ product.type }}</span>
                  {%- endif -%}

                  <h3 class="lux-card__title">{{ product.title }}</h3>

                  <div class="lux-card__price{% if on_sale %} lux-card__price--on-sale{% endif %}">
                    {%- if on_sale -%}
                      <span class="lux-card__price-current">{{ product.price | money }}</span>
                      <span class="lux-card__price-compare">{{ product.compare_at_price | money }}</span>
                      {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                      <span class="lux-card__price-save">−{{ savings }}%</span>
                    {%- else -%}
                      {% if product.price_varies %}
                        <span class="lux-card__price-from">From</span>
                      {% endif %}
                      <span class="lux-card__price-current">{{ product.price | money }}</span>
                    {%- endif -%}
                  </div>

                  <span class="lux-card__cta">
                    <span>View Product</span>
                    <span class="lux-card__cta-arrow" aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            {% endfor %}
          </div>
        </section>
      {%- endfor -%}

      {%- if collection.products.size == 0 -%}
        <p class="lux-empty">No products found in this collection.</p>
      {%- endif -%}

      <p class="lux-no-matches" data-no-matches>
        No products match the selected concerns on this page. Try clearing filters or visiting another page.
      </p>

      {% if paginate.pages > 1 %}
        <nav class="lux-pagination" aria-label="Pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="lux-pagination__nav">&larr; Previous</a>
          {% else %}
            <span class="lux-pagination__nav lux-pagination__nav--disabled">&larr; Previous</span>
          {% endif %}

          <div class="lux-pagination__pages">
            {% for part in paginate.parts %}
              {% if part.is_link %}
                <a href="{{ part.url }}" class="lux-pagination__page">{{ part.title }}</a>
              {% else %}
                {% if part.title == paginate.current_page %}
                  <span class="lux-pagination__page lux-pagination__page--current" aria-current="page">{{ part.title }}</span>
                {% else %}
                  <span class="lux-pagination__page lux-pagination__page--ellipsis">{{ part.title }}</span>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="lux-pagination__nav">Next &rarr;</a>
          {% else %}
            <span class="lux-pagination__nav lux-pagination__nav--disabled">Next &rarr;</span>
          {% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}

  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-lux-catalog]');
    if (!root) return;

    var sortEl = root.querySelector('[data-lux-sort]');
    if (sortEl) {
      sortEl.addEventListener('change', function (e) {
        var url = new URL(window.location.href);
        url.searchParams.set('sort_by', e.target.value);
        url.searchParams.delete('page');
        window.location.href = url.toString();
      });
    }

    function applyFilter() {
      var params = new URLSearchParams(window.location.search);
      var concernsParam = params.get('concerns') || '';
      var active = concernsParam
        ? concernsParam.split(',').map(function (c) { return c.trim(); }).filter(Boolean)
        : [];

      var totalVisible = 0;

      root.querySelectorAll('.lux-brand').forEach(function (group) {
        var visibleInGroup = 0;
        group.querySelectorAll('.lux-card').forEach(function (card) {
          var matches = true;
          if (active.length > 0) {
            var concerns = (card.dataset.concerns || '').split(/\s+/).filter(Boolean);
            matches = active.some(function (c) { return concerns.indexOf(c) !== -1; });
          }
          card.classList.toggle('lux-card--hidden', !matches);
          if (matches) visibleInGroup++;
        });
        group.classList.toggle('lux-brand--hidden', visibleInGroup === 0);
        var countEl = group.querySelector('[data-visible-count]');
        if (countEl) countEl.textContent = visibleInGroup;
        totalVisible += visibleInGroup;
      });

      var noMatch = root.querySelector('[data-no-matches]');
      if (noMatch) {
        noMatch.classList.toggle('lux-no-matches--visible', totalVisible === 0 && active.length > 0);
      }

      var totalEl = root.querySelector('[data-total-count]');
      if (totalEl && active.length > 0) {
        totalEl.textContent = totalVisible + (totalVisible === 1 ? ' selection' : ' selections') + ' matched';
      }
    }

    applyFilter();
  })();
</script>

{% schema %}
{
  "name": "Luxury Catalog Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Hero eyebrow",
      "default": "Medical-Grade Skincare"
    },
    {
      "type": "textarea",
      "id": "subtitle_text",
      "label": "Hero subtitle",
      "default": "A curated edit of the world's most clinically rigorous skincare — hand-selected for proven results and prescribed for your skin."
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Editorial intro",
      "default": "Every product on this page is sourced direct from authorized distributors and personally vetted for clinical efficacy. Filter by your skin concern, or explore by brand below."
    }
  ],
  "presets": [
    {
      "name": "Luxury Catalog Grid",
      "category": "Collection"
    }
  ]
}
{% endschema %}
