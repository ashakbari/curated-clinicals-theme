<div class="cc-sig" data-cc-sig data-vals="{{ h }},{{ b }},{{ f }},{{ r }},{{ c }},{{ d }}">
  <div class="cc-sig__head">
    <div class="cc-sig__head-left">
      <span class="cc-sig__kicker">Formulation Signature</span>
      <span class="cc-sig__sub">Where this formula concentrates</span>
    </div>
    <span class="cc-sig__seal" aria-hidden="true">CC</span>
  </div>

  <div class="cc-sig__grid">
    <div class="cc-sig__radar">
      <svg class="cc-sig__svg" viewBox="0 0 300 280" role="img" aria-label="Formulation profile chart"></svg>
    </div>
    <ul class="cc-sig__axes" role="list">
      <li class="cc-sig__ax" data-axis="0" style="--v: {{ h }}"><span class="cc-sig__ax-dot"></span><span class="cc-sig__ax-name">Hydration</span><span class="cc-sig__ax-bar"><i></i></span><span class="cc-sig__ax-val" data-v="{{ h }}">0</span></li>
      <li class="cc-sig__ax" data-axis="1" style="--v: {{ b }}"><span class="cc-sig__ax-dot"></span><span class="cc-sig__ax-name">Brightening</span><span class="cc-sig__ax-bar"><i></i></span><span class="cc-sig__ax-val" data-v="{{ b }}">0</span></li>
      <li class="cc-sig__ax" data-axis="2" style="--v: {{ f }}"><span class="cc-sig__ax-dot"></span><span class="cc-sig__ax-name">Firming</span><span class="cc-sig__ax-bar"><i></i></span><span class="cc-sig__ax-val" data-v="{{ f }}">0</span></li>
      <li class="cc-sig__ax" data-axis="3" style="--v: {{ r }}"><span class="cc-sig__ax-dot"></span><span class="cc-sig__ax-name">Renewal</span><span class="cc-sig__ax-bar"><i></i></span><span class="cc-sig__ax-val" data-v="{{ r }}">0</span></li>
      <li class="cc-sig__ax" data-axis="4" style="--v: {{ c }}"><span class="cc-sig__ax-dot"></span><span class="cc-sig__ax-name">Calming</span><span class="cc-sig__ax-bar"><i></i></span><span class="cc-sig__ax-val" data-v="{{ c }}">0</span></li>
      <li class="cc-sig__ax" data-axis="5" style="--v: {{ d }}"><span class="cc-sig__ax-dot"></span><span class="cc-sig__ax-name">Defense</span><span class="cc-sig__ax-bar"><i></i></span><span class="cc-sig__ax-val" data-v="{{ d }}">0</span></li>
    </ul>
  </div>

  <div class="cc-sig__meta">
    <div class="cc-sig__meta-cell">
      <span class="cc-sig__meta-label">Strength</span>
      <div class="cc-sig__gauge">
        <span class="cc-sig__pips">{% for i in (1..5) %}<span class="cc-sig__pip{% if i <= intensity %} is-on{% endif %}"></span>{% endfor %}</span>
        <span class="cc-sig__gauge-word">{{ int_word }}</span>
      </div>
    </div>
    <div class="cc-sig__meta-cell">
      <span class="cc-sig__meta-label">Best used</span>
      <span class="cc-sig__timing">{% if timing == 'AM' %}<span aria-hidden="true">☀</span> Morning{% elsif timing == 'PM' %}<span aria-hidden="true">☾</span> Night{% else %}<span aria-hidden="true">☀</span><span aria-hidden="true">☾</span> AM + PM{% endif %}</span>
    </div>
  </div>

  {%- if actives_list.size > 0 -%}
  <div class="cc-sig__actives">
    <span class="cc-sig__meta-label">Key actives</span>
    <div class="cc-sig__chips">
      {%- for a in actives_list limit: 3 -%}<span class="cc-sig__chip">{{ a }}</span>{%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  <p class="cc-sig__note">Curated Clinicals' editorial read of where this formula concentrates — a guide to help you choose, not a medical or clinical claim.</p>
</div>

<style>
  .cc-sig {
    --g: #d8b865; --g2: #c19a3d; --g-deep: #8a6c1e;
    position: relative; margin: 1.75rem 0 2rem; padding: 1.5rem 1.5rem 1.35rem;
    background: radial-gradient(120% 140% at 15% 0%, #241d13 0%, #17130d 45%, #100c07 100%);
    border: 1px solid rgba(216,184,101,0.28); border-radius: 20px; color: #efe6d2;
    box-shadow: 0 26px 60px -30px rgba(0,0,0,0.9), inset 0 1px 0 rgba(255,236,190,0.06);
    overflow: hidden; box-sizing: border-box; font-family: 'DM Sans', system-ui, sans-serif;
  }
  .cc-sig * { box-sizing: border-box; }
  .cc-sig::before { content: ''; position: absolute; inset: 0; background: radial-gradient(60% 60% at 85% 15%, rgba(216,184,101,0.12), transparent 70%); pointer-events: none; }
  .cc-sig__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; position: relative; z-index: 1; margin-bottom: 0.5rem; }
  .cc-sig__kicker { display: block; font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; font-weight: 600; letter-spacing: 0.01em; color: #f6ecd4; line-height: 1.05; }
  .cc-sig__sub { display: block; font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--g-deep); margin-top: 0.28rem; font-weight: 600; }
  .cc-sig__seal { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; border: 1px solid rgba(216,184,101,0.5); color: var(--g); font-family: 'Cormorant Garamond', serif; font-size: 0.82rem; letter-spacing: 0.04em; flex: 0 0 auto; }
  .cc-sig__grid { display: grid; grid-template-columns: minmax(180px, 46%) 1fr; gap: 0.75rem 1.4rem; align-items: center; position: relative; z-index: 1; }
  .cc-sig__radar { min-width: 0; }
  .cc-sig__svg { width: 100%; height: auto; display: block; overflow: visible; }
  .cc-sig__axes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .cc-sig__ax { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.55rem; cursor: default; }
  .cc-sig__ax-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--g); box-shadow: 0 0 0 0 rgba(216,184,101,0.5); transition: box-shadow 0.3s ease, transform 0.3s ease; grid-row: 1; }
  .cc-sig__ax-name { grid-column: 2; grid-row: 1; font-size: 0.8rem; color: #d8ceb8; letter-spacing: 0.01em; }
  .cc-sig__ax-val { grid-column: 3; grid-row: 1; font-family: 'Cormorant Garamond', serif; font-size: 1.02rem; font-weight: 600; color: var(--g); font-variant-numeric: tabular-nums; min-width: 1.7em; text-align: right; }
  .cc-sig__ax-bar { grid-column: 2 / 4; grid-row: 2; height: 4px; border-radius: 999px; background: rgba(216,184,101,0.13); overflow: hidden; }
  .cc-sig__ax-bar i { display: block; height: 100%; width: 0; border-radius: 999px; background: linear-gradient(90deg, var(--g-deep), var(--g)); transition: width 1s cubic-bezier(0.22,1,0.36,1); }
  .cc-sig.in .cc-sig__ax-bar i { width: calc(var(--v) * 1%); }
  .cc-sig__ax.is-hot .cc-sig__ax-dot { box-shadow: 0 0 0 5px rgba(216,184,101,0.18); transform: scale(1.25); }
  .cc-sig__ax.is-hot .cc-sig__ax-name { color: #fff; }
  .cc-sig__meta { display: flex; gap: 0.75rem; margin-top: 1.15rem; position: relative; z-index: 1; }
  .cc-sig__meta-cell { flex: 1; background: rgba(255,255,255,0.03); border: 1px solid rgba(216,184,101,0.16); border-radius: 12px; padding: 0.6rem 0.8rem; }
  .cc-sig__meta-label { display: block; font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--g-deep); font-weight: 700; margin-bottom: 0.4rem; }
  .cc-sig__gauge { display: flex; align-items: center; gap: 0.55rem; }
  .cc-sig__pips { display: inline-flex; gap: 4px; }
  .cc-sig__pip { width: 15px; height: 5px; border-radius: 999px; background: rgba(216,184,101,0.18); transition: background 0.4s ease, box-shadow 0.4s ease; }
  .cc-sig.in .cc-sig__pip.is-on { background: linear-gradient(90deg, var(--g-deep), var(--g)); box-shadow: 0 0 8px rgba(216,184,101,0.45); }
  .cc-sig__gauge-word { font-family: 'Cormorant Garamond', serif; font-size: 1.02rem; color: #f0e6cf; }
  .cc-sig__timing { font-family: 'Cormorant Garamond', serif; font-size: 1.08rem; color: #f0e6cf; letter-spacing: 0.02em; }
  .cc-sig__timing span { color: var(--g); }
  .cc-sig__actives { margin-top: 1rem; position: relative; z-index: 1; }
  .cc-sig__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem; }
  .cc-sig__chip { font-size: 0.72rem; letter-spacing: 0.01em; color: #e8dcc0; background: rgba(216,184,101,0.1); border: 1px solid rgba(216,184,101,0.28); border-radius: 999px; padding: 0.32rem 0.7rem; }
  .cc-sig__note { margin: 1rem 0 0; font-size: 0.62rem; line-height: 1.5; color: #8c8069; position: relative; z-index: 1; }
  @media (max-width: 560px) {
    .cc-sig__grid { grid-template-columns: 1fr; }
    .cc-sig__radar { max-width: 300px; margin: 0 auto 0.5rem; }
  }
</style>

<script>
(function(){
  if (window.__ccSigInit) { window.__ccSigInit(); return; }
  var AX = ['Hydration','Brightening','Firming','Renewal','Calming','Defense'];
  var SVGNS = 'http://www.w3.org/2000/svg';
  function el(n, attrs){ var e = document.createElementNS(SVGNS, n); for (var k in attrs) e.setAttribute(k, attrs[k]); return e; }
  function pt(cx, cy, R, i, frac){ var a = (-90 + i*60) * Math.PI/180; return [cx + R*frac*Math.cos(a), cy + R*frac*Math.sin(a)]; }
  function ease(t){ return 1 - Math.pow(1 - t, 3); }

  function draw(root){
    if (root.__done) return; root.__done = true;
    var svg = root.querySelector('.cc-sig__svg');
    var vals = (root.getAttribute('data-vals')||'').split(',').map(function(x){ return parseFloat(x)||0; });
    var cx = 150, cy = 138, R = 104;
    while (svg.firstChild) svg.removeChild(svg.firstChild);
    // defs: gradient + glow
    var defs = el('defs', {});
    var grad = el('radialGradient', { id: 'ccSigGrad', cx: '50%', cy: '50%', r: '65%' });
    grad.appendChild(el('stop', { offset: '0%', 'stop-color': '#f4dd98', 'stop-opacity': '0.55' }));
    grad.appendChild(el('stop', { offset: '100%', 'stop-color': '#b8912f', 'stop-opacity': '0.28' }));
    defs.appendChild(grad);
    var fil = el('filter', { id: 'ccSigGlow', x: '-40%', y: '-40%', width: '180%', height: '180%' });
    fil.appendChild(el('feGaussianBlur', { stdDeviation: '3.4', result: 'b' }));
    var mrg = el('feMerge', {}); mrg.appendChild(el('feMergeNode', { in: 'b' })); mrg.appendChild(el('feMergeNode', { in: 'SourceGraphic' }));
    fil.appendChild(mrg); defs.appendChild(fil); svg.appendChild(defs);
    // grid rings
    [0.25, 0.5, 0.75, 1].forEach(function(fr){
      var pts = []; for (var i=0;i<6;i++){ var p = pt(cx,cy,R,i,fr); pts.push(p[0].toFixed(1)+','+p[1].toFixed(1)); }
      svg.appendChild(el('polygon', { points: pts.join(' '), fill: 'none', stroke: 'rgba(216,184,101,0.16)', 'stroke-width': fr===1?'1.1':'0.8' }));
    });
    // spokes + axis letters + dots holders
    var dots = [];
    for (var i=0;i<6;i++){
      var edge = pt(cx,cy,R,i,1);
      svg.appendChild(el('line', { x1: cx, y1: cy, x2: edge[0].toFixed(1), y2: edge[1].toFixed(1), stroke: 'rgba(216,184,101,0.12)', 'stroke-width': '0.8' }));
      var lp = pt(cx,cy,R+15,i,1);
      var t = el('text', { x: lp[0].toFixed(1), y: (lp[1]+3.5).toFixed(1), 'text-anchor': 'middle', fill: 'rgba(216,184,101,0.72)', 'font-size': '10', 'font-family': 'DM Sans, sans-serif', 'font-weight': '600' });
      t.textContent = AX[i].charAt(0);
      svg.appendChild(t);
    }
    // data polygon (animated) + vertex dots
    var poly = el('polygon', { points: '', fill: 'url(#ccSigGrad)', stroke: '#e8c86a', 'stroke-width': '1.8', 'stroke-linejoin': 'round', filter: 'url(#ccSigGlow)' });
    svg.appendChild(poly);
    for (var j=0;j<6;j++){ var dt = el('circle', { r: '2.6', fill: '#f6e4a6', stroke: '#8a6c1e', 'stroke-width': '0.8' }); svg.appendChild(dt); dots.push(dt); }
    root.__dots = dots;
    // animate bloom
    var start = null, DUR = 1150;
    function frame(ts){
      if (!start) start = ts;
      var t = Math.min(1, (ts - start)/DUR), e = ease(t);
      var pts = [];
      for (var i=0;i<6;i++){
        var p = pt(cx, cy, R, i, (vals[i]/100)*e);
        pts.push(p[0].toFixed(2)+','+p[1].toFixed(2));
        dots[i].setAttribute('cx', p[0].toFixed(2)); dots[i].setAttribute('cy', p[1].toFixed(2));
      }
      poly.setAttribute('points', pts.join(' '));
      if (t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
    // count-up axis values
    root.querySelectorAll('.cc-sig__ax-val').forEach(function(sp){
      var target = parseFloat(sp.getAttribute('data-v'))||0, s2 = null;
      function cu(ts){ if(!s2) s2 = ts; var t = Math.min(1,(ts-s2)/900); sp.textContent = Math.round(target*ease(t)); if(t<1) requestAnimationFrame(cu); }
      requestAnimationFrame(cu);
    });
    // cross-highlight list <-> dots
    root.querySelectorAll('.cc-sig__ax').forEach(function(li){
      var idx = parseInt(li.getAttribute('data-axis'),10);
      function on(){ li.classList.add('is-hot'); if(root.__dots&&root.__dots[idx]){ root.__dots[idx].setAttribute('r','4.2'); } }
      function off(){ li.classList.remove('is-hot'); if(root.__dots&&root.__dots[idx]){ root.__dots[idx].setAttribute('r','2.6'); } }
      li.addEventListener('mouseenter', on); li.addEventListener('mouseleave', off);
      li.addEventListener('focus', on); li.addEventListener('blur', off);
    });
  }

  function reveal(root){ root.classList.add('in'); draw(root); }

  function init(){
    var nodes = document.querySelectorAll('[data-cc-sig]');
    if (!nodes.length) return;
    if (!('IntersectionObserver' in window)){ nodes.forEach(reveal); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if (en.isIntersecting){ reveal(en.target); io.unobserve(en.target); } });
    }, { threshold: 0.35 });
    nodes.forEach(function(n){ if (!n.__watched){ n.__watched = true; io.observe(n); } });
  }
  window.__ccSigInit = init;
  if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
})();
</script>
{%- endif -%}
