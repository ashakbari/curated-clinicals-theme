{%- if display == 'summary' -%}
<div class="ccr-sum">
  <div class="ccr-sum__left">
    <span class="ccr-sum__avg">{{ ccr_avg }}</span>
    <span class="ccr-st ccr-st--lg" aria-hidden="true"><span class="ccr-st__f" style="width:{{ ccr_pct }}%">&#9733;&#9733;&#9733;&#9733;&#9733;</span>&#9733;&#9733;&#9733;&#9733;&#9733;</span>
    <span class="ccr-sum__count">Based on {{ ccr_count }} reviews</span>
  </div>
  <div class="ccr-sum__bars">
    {%- assign ccr_h = ccr_hist | split: '|' -%}
    {%- for i in (1..5) -%}
      {%- assign ccr_star = 6 | minus: i -%}
      {%- assign ccr_hc = ccr_h[forloop.index0] | plus: 0 -%}
      {%- assign ccr_hw = ccr_hc | times: 100.0 | divided_by: ccr_count | round -%}
      <div class="ccr-bar" data-ccr-filter="{{ ccr_star }}" role="button" tabindex="0" aria-label="Show {{ ccr_star }} star reviews ({{ ccr_hc }})">
        <span class="ccr-bar__lbl">{{ ccr_star }}&#9733;</span>
        <span class="ccr-bar__track"><span class="ccr-bar__fill" style="width:{{ ccr_hw }}%"></span></span>
        <span class="ccr-bar__n">{{ ccr_hc }}</span>
      </div>
    {%- endfor -%}
  </div>
</div>
{%- elsif display == 'rowlink' -%}
<a class="ccr-row ccr-row--link" href="#cc-reviews" aria-label="Rated {{ ccr_avg }} out of 5 from {{ ccr_count }} reviews">
  <span class="ccr-st" aria-hidden="true"><span class="ccr-st__f" style="width:{{ ccr_pct }}%">&#9733;&#9733;&#9733;&#9733;&#9733;</span>&#9733;&#9733;&#9733;&#9733;&#9733;</span>
  <span class="ccr-row__val">{{ ccr_avg }}</span>
  <span class="ccr-row__count">{{ ccr_count }} reviews</span>
</a>
{%- else -%}
<div class="lux-card__rating" aria-label="Rated {{ ccr_avg }} out of 5 from {{ ccr_count }} reviews">
  <span class="ccr-st" aria-hidden="true"><span class="ccr-st__f" style="width:{{ ccr_pct }}%">&#9733;&#9733;&#9733;&#9733;&#9733;</span>&#9733;&#9733;&#9733;&#9733;&#9733;</span>
  <span class="lux-card__rating-value">{{ ccr_avg }}</span>
