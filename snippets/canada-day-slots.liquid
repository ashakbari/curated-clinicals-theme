<script>
(function(){
  var root=document.getElementById('mps'),tab=document.getElementById('mps-tab');if(!root||!tab)return;
  var GAME_END=new Date('2026-07-08T06:59:59Z').getTime();
  if(Date.now()>GAME_END){tab.style.display='none';return;}
  function dec(s){try{return atob(s);}catch(e){return '';}}
  /* rank: higher = better; m5 legacy (not on board) for old wallet entries */
  var TIERS={
    m5:  {k:'m5',  c:'TUFQTEU1LUo3TA==',     rank:0, val:5,  pct:true,  short:'5%',   name:'a BONUS PAYOUT — 5% off everything', sub:'An extra 5% on your whole order, stacked on the 20% sale.', stack:'Stacked: 25%+ off retail on anything you grab'},
    m10: {k:'m10', c:'TUFQTEUxMC1YNFQ=',     rank:1, val:10, pct:false, short:'$10',  name:'a $10 CASH DROP',                     sub:'On orders of just $75 or more. Stacks with the 20% sale.', stack:'Stacked: $28+ off retail on a $75 order'},
    ship:{k:'ship',c:'TUFQTEVTSElQLVEyTg==', rank:2, val:15, pct:false, short:'SHIP', name:'FREE EXPRESS SHIPPING',               sub:'On orders of just $50 or more. Stacks with the sale.',      stack:'Stacked: $25+ in savings on a $50 order'},
    m15: {k:'m15', c:'TUFQTEUxNS1COFc=',     rank:3, val:15, pct:false, short:'$15',  name:'a $15 CASH DROP',                     sub:'On orders of $125 or more. Stacks with the 20% sale.',      stack:'Stacked: $45+ off retail on a $125 order'},
    m25: {k:'m25', c:'TUFQTEUyNS1SM0s=',     rank:4, val:25, pct:false, short:'$25',  name:'a BIG WIN — $25 off',                 sub:'On orders of $175 or more. Stacks with the 20% sale.',      stack:'Stacked: $65+ off retail on a $175 order'},
    m40: {k:'m40', c:'TUFQTEU0MC1aOUY=',     rank:5, val:40, pct:false, short:'$40',  name:'the $40 MEGA JACKPOT',                sub:'On orders of $250 or more. The top bucket, eh!',            stack:'Stacked: $100+ off retail on a $250 order'}
  };
  for(var tk in TIERS){if(TIERS.hasOwnProperty(tk))TIERS[tk].code=dec(TIERS[tk].c);}
  /* board buckets left->right; edges = jackpot, classic plinko */
  var BUCKETS=['m40','m25','m15','ship','m10','ship','m15','m25','m40'];
  var BCOLORS={m40:'#e01936',m25:'#d4ba6a',m15:'#b89234',ship:'#7fa8d4',m10:'#8fbf7f'};
  function rnd(){try{var a=new Uint32Array(1);(window.crypto||window.msCrypto).getRandomValues(a);return a[0]/4294967296;}catch(e){return (new Date().getTime()%997)/997;}}
  /* --- sound --- */
  var muted=false;try{muted=localStorage.getItem('ccSlotsMute')==='1';}catch(e){}
  var actx=null;
  function ac(){if(!actx){try{actx=new (window.AudioContext||window.webkitAudioContext)();}catch(e){}}return actx;}
  function beep(freq,dur,delay,type,vol){
    if(muted)return;var c=ac();if(!c)return;
    try{
      var t0=c.currentTime+(delay||0);
      var o=c.createOscillator(),g=c.createGain();
      o.type=type||'square';o.frequency.value=freq;
      g.gain.setValueAtTime(0.0001,t0);g.gain.exponentialRampToValueAtTime(vol||0.05,t0+0.01);g.gain.exponentialRampToValueAtTime(0.0001,t0+(dur||0.09));
      o.connect(g);g.connect(c.destination);o.start(t0);o.stop(t0+(dur||0.09)+0.02);
    }catch(e){}
  }
  var lastTick=0;
  function sndPeg(){var n=Date.now();if(n-lastTick<45)return;lastTick=n;beep(900+rnd()*500,0.03,0,'square',0.03);}
  function sndBucket(){beep(880,0.07,0,'triangle',0.06);beep(1174,0.09,0.08,'triangle',0.06);}
  function sndWin(){var n=[660,830,990,1320];for(var i=0;i<n.length;i++)beep(n[i],0.12,i*0.09,'triangle',0.06);}
  function sndJackpot(){var n=[523,659,784,1046,1318,1568,2093];for(var i=0;i<n.length;i++)beep(n[i],0.16,i*0.09,'triangle',0.07);for(var j=0;j<5;j++)beep(2093,0.05,0.7+j*0.07,'square',0.04);}
  var sndBtn=document.getElementById('mps-snd');
  function sndIcon(){sndBtn.innerHTML=muted?'&#128263;':'&#128266;';}
  sndIcon();
  sndBtn.addEventListener('click',function(){muted=!muted;try{localStorage.setItem('ccSlotsMute',muted?'1':'0');}catch(e){}sndIcon();});
  /* --- storage --- */
  function store(){try{return JSON.parse(localStorage.getItem('ccSlots')||'{}');}catch(e){return {};}}
  function save(o){try{localStorage.setItem('ccSlots',JSON.stringify(o));}catch(e){}}
  function today(){var d=new Date();return d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2);}
  function playedToday(){var s=store();return !!(s.plays&&s.plays[today()]);}
  function tierByCode(c){for(var tk in TIERS){if(TIERS.hasOwnProperty(tk)&&TIERS[tk].code===c)return TIERS[tk];}return null;}
  function bestOf(keys){var b=null;for(var i=0;i<keys.length;i++){var t=TIERS[keys[i]];if(t&&(!b||t.rank>b.rank))b=t;}return b;}
  function streak(){var s=store();if(!s.plays)return 0;var n=0,d=new Date();for(;;){var k=d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2);if(s.plays[k]){n++;d.setDate(d.getDate()-1);}else break;}return n;}
  var openedAt=0,nextTimer=null,gateTimer=null,msgTimer=null,expTimer=null;
  var MODE='idle'; /* idle | aiming | dropping | scoring | done */
  var practice=false;
  var run={drops:[]}; /* tier keys landed this run */
  function msg(t){var m=document.getElementById('mps-msg');if(!m)return;if(msgTimer){clearTimeout(msgTimer);msgTimer=null;}m.style.color='';m.textContent=t||'';}
  function clearErr(){var e=document.getElementById('mps-em');if(e)e.style.borderColor='';msg('');}
  function warn(el,text){el.focus();el.style.borderColor='#e01936';msg(text||'');}
  /* --- plinko engine (canvas) --- */
  var cv=document.getElementById('mps-cv'),ctx=cv.getContext('2d');
  var W=352,H=430,BW=W/9,BUCKET_Y=372;
  var PEGS=[];
  (function(){
    var rows=9,y0=78,dy=30;
    for(var r=0;r<rows;r++){
      var off=(r%2===0)?0:16,n=Math.floor((W-24)/32)+1;
      for(var i=0;i<n;i++){
        var x=12+off+i*32;
        if(x>10&&x<W-10)PEGS.push({x:x,y:y0+r*dy,glow:0});
      }
    }
  })();
  var ball=null; /* {x,y,vx,vy} */
  var hintT=0,drawRaf=null,drawing=false;
  function tierAtBucket(i){return TIERS[BUCKETS[Math.max(0,Math.min(8,i))]];}
  function draw(ts){
    if(!drawing)return;
    hintT=ts||0;
    ctx.clearRect(0,0,W,H);
    /* drop zone hint */
    if(MODE==='aiming'){
      ctx.save();
      ctx.globalAlpha=0.75+0.25*Math.sin(hintT/300);
      ctx.fillStyle='#ffd76a';
      ctx.font='700 13px sans-serif';ctx.textAlign='center';
      ctx.fillText('TAP ANYWHERE TO DROP',W/2,26);
      var ax=W/2+Math.sin(hintT/500)*100;
      ctx.font='20px sans-serif';
      ctx.fillText('🍁',ax,52);
      ctx.font='700 14px sans-serif';
      ctx.fillText('▼',ax,66);
      ctx.restore();
    }
    /* pegs */
    for(var p=0;p<PEGS.length;p++){
      var pg=PEGS[p];
      ctx.beginPath();ctx.arc(pg.x,pg.y,4,0,6.2832);
      if(pg.glow>0){ctx.fillStyle='#ffd76a';pg.glow-=0.06;}else{ctx.fillStyle='#6b5a3e';}
      ctx.fill();
    }
    /* buckets */
    for(var b=0;b<9;b++){
      var t=tierAtBucket(b),x0=b*BW;
      ctx.fillStyle='rgba(15,12,9,.9)';
      ctx.fillRect(x0+1,BUCKET_Y,BW-2,H-BUCKET_Y-2);
      ctx.strokeStyle=BCOLORS[t.k];ctx.lineWidth=1.5;
      ctx.strokeRect(x0+1,BUCKET_Y,BW-2,H-BUCKET_Y-2);
      ctx.fillStyle=BCOLORS[t.k];
      ctx.font=(t.k==='m40'?'800 12px':'800 11px')+' sans-serif';ctx.textAlign='center';
      ctx.fillText(t.short,x0+BW/2,BUCKET_Y+22);
      if(t.k==='m40'){ctx.font='10px sans-serif';ctx.fillText('🍁',x0+BW/2,BUCKET_Y+38);}
      else{ctx.fillStyle='#7d715f';ctx.font='800 8px sans-serif';ctx.fillText(t.k==='ship'?'FREE':'OFF',x0+BW/2,BUCKET_Y+36);}
    }
    /* ball */
    if(ball){
      ctx.font='20px sans-serif';ctx.textAlign='center';
      ctx.fillText('🍁',ball.x,ball.y+7);
    }
    drawRaf=requestAnimationFrame(draw);
  }
  function startDrawing(){if(!drawing){drawing=true;drawRaf=requestAnimationFrame(draw);}}
  function stopDrawing(){drawing=false;if(drawRaf)cancelAnimationFrame(drawRaf);}
  var physLast=0,physRaf=null,dropT=0;
  function simulate(ts){
    if(!ball){return;}
    if(Date.now()-dropT>15000){var wb=Math.max(0,Math.min(8,Math.floor(ball.x/BW)));ball=null;landDrop(wb);return;}
    if(!physLast)physLast=ts;
    var dt=Math.min(32,ts-physLast)/1000;physLast=ts;
    var steps=4,sdt=dt/steps;
    for(var s=0;s<steps;s++){
      ball.vy+=1500*sdt;
      ball.x+=ball.vx*sdt;ball.y+=ball.vy*sdt;
      if(ball.x<8){ball.x=8;ball.vx=Math.abs(ball.vx)*0.6;}
      if(ball.x>W-8){ball.x=W-8;ball.vx=-Math.abs(ball.vx)*0.6;}
      for(var p=0;p<PEGS.length;p++){
        var pg=PEGS[p],dx=ball.x-pg.x,dy2=ball.y-pg.y,d2=dx*dx+dy2*dy2,minD=11;
        if(d2<minD*minD&&d2>0.01){
          var d=Math.sqrt(d2),nx=dx/d,ny=dy2/d;
          ball.x=pg.x+nx*minD;ball.y=pg.y+ny*minD;
          var dot=ball.vx*nx+ball.vy*ny;
          ball.vx=(ball.vx-2*dot*nx)*0.55+(rnd()-0.5)*70;
          ball.vy=(ball.vy-2*dot*ny)*0.55;
          if(ball.vy<40)ball.vy=40;
          pg.glow=1;sndPeg();
        }
      }
      if(ball.y>=BUCKET_Y-8){
        var bi=Math.max(0,Math.min(8,Math.floor(ball.x/BW)));
        ball=null;landDrop(bi);
        return;
      }
    }
    physRaf=requestAnimationFrame(simulate);
  }
  function dropAt(x){
    if(MODE!=='aiming')return;
    MODE='dropping';
    var c=ac();if(c&&c.state==='suspended'){try{c.resume();}catch(e){}}
    if(!practice){var sp=store();sp.runDay=today();sp.run={drops:run.drops.slice(0),pend:1};save(sp);}
    ball={x:Math.max(20,Math.min(W-20,x)),y:14,vx:(rnd()-0.5)*30,vy:60};
    physLast=0;dropT=Date.now();physRaf=requestAnimationFrame(simulate);
    updHud();
  }
  function landDrop(bi){
    MODE='scoring';
    var t=tierAtBucket(bi);
    run.drops.push(t.k);
    if(!practice){var s=store();s.run={drops:run.drops.slice(0)};s.runDay=today();save(s);}
    var board=document.getElementById('mps-board');
    board.className='mps-board '+(t.k==='m40'?'megashake':'shake');
    setTimeout(function(){board.className='mps-board';},700);
    var sp2=document.getElementById('mps-scorepop');
    sp2.textContent=(t.k==='ship'?'FREE SHIP!':(t.k==='m40'?'🍁 $40 JACKPOT!':t.short+' OFF!'));
    sp2.className='mps-scorepop';void sp2.offsetHeight;sp2.className='mps-scorepop go';
    if(!root.hasAttribute('hidden')){if(t.k==='m40'){sndJackpot();shower(true);}else{sndBucket();}}
    updHud();
    setTimeout(function(){
      if(run.drops.length>=3){
        if(practice){
          MODE='idle';
          var b=bestOf(run.drops);
          var m=document.getElementById('mps-msg');
          msg('');m.style.color='#ffd76a';
          m.textContent='Practice: best bucket '+(b?b.short:'—')+'. Endless retries, eh!';
          msgTimer=setTimeout(function(){m.style.color='';m.textContent='';msgTimer=null;},6000);
          run={drops:[]};updHud();
          MODE='aiming';
          setBtn('&#127919; PRACTICE — TAP THE BOARD',true,true);
        }else{finishRun();}
      }
      else{MODE='aiming';setBtn(practice?'&#127919; PRACTICE — TAP TO DROP':'&#127809; TAP THE BOARD — DROP '+(run.drops.length+1)+' OF 3',true,true);}
    },1100);
  }
  function updHud(){
    document.getElementById('mps-drops').textContent=Math.max(0,3-run.drops.length);
    var b=bestOf(run.drops);
    document.getElementById('mps-best').textContent=b?(b.k==='ship'?'FREE SHIP':b.short+' OFF'):'–';
  }
  function finishRun(){
    MODE='done';
    var t=bestOf(run.drops)||TIERS.m10;
    var s=store();
    s.plays=s.plays||{};s.plays[today()]=t.code;s.lastPullAt=Date.now();
    delete s.run;delete s.runDay;
    save(s);
    setBtn('&#10003; DONE FOR TODAY',false,true);
    runWinSequence(t);
  }
  /* --- celebration + payout (shared shell) --- */
  function shower(big){
    if(root.hasAttribute('hidden'))return;
    var n=big?80:44;
    for(var i=0;i<n;i++){(function(){
      var s=document.createElement('div');s.className='mps-conf';
      var r=rnd();s.innerHTML=r<0.55?'🍁':(r<0.85?'🪙':'🎉');
      s.style.left=(rnd()*100)+'vw';
      var dur=2000+rnd()*2600,x=(rnd()*200-100);
      s.style.transition='transform '+dur+'ms linear, opacity '+dur+'ms linear';
      document.body.appendChild(s);
      requestAnimationFrame(function(){s.style.transform='translate('+x+'px,'+(window.innerHeight+90)+'px) rotate('+(rnd()*720-360)+'deg)';s.style.opacity='0';});
      setTimeout(function(){if(s.parentNode)s.parentNode.removeChild(s);},dur+90);
    })();}
  }
  function fmtHMS(ms){var s=Math.max(0,Math.floor(ms/1000));var h=Math.floor(s/3600);s-=h*3600;var m=Math.floor(s/60);s-=m*60;function p(n){return(n<10?'0':'')+n;}return p(h)+':'+p(m)+':'+p(s);}
  function fmtDHMS(ms){var s=Math.max(0,Math.floor(ms/1000));var d=Math.floor(s/86400);s-=d*86400;return (d>0?d+'d ':'')+fmtHMS(s*1000);}
  function runWinSequence(t){
    var jack=(t.k==='m40');
    if(root.hasAttribute('hidden')){showWin(t,false);return;}
    if(jack){sndJackpot();}else{sndWin();}
    setTimeout(function(){
      if(root.hasAttribute('hidden')){showWin(t,false);return;}
      var burst=document.getElementById('mps-burst');
      var bv=document.getElementById('mps-bv'),bn=document.getElementById('mps-bn');
      bn.innerHTML='YOUR BEST DROP — YOU WON '+(t.pct?'A 5% BONUS':(t.k==='ship'?'FREE EXPRESS SHIPPING':t.name.replace('a ','').replace('the ','').toUpperCase()));
      burst.style.display='flex';
      var t0=null,DUR=900,target=t.pct?5:t.val;
      function step(ts){
        if(!t0)t0=ts;
        var f=Math.min(1,(ts-t0)/DUR);
        var eased=1-Math.pow(1-f,3);
        var v=target*eased;
        bv.textContent=t.pct?(v.toFixed(1)+'%'):('$'+v.toFixed(2));
        if(f<1){requestAnimationFrame(step);}
        else{bv.textContent=t.pct?(target+'%'):('$'+target.toFixed(2));}
      }
      requestAnimationFrame(step);
      shower(jack);
      setTimeout(function(){
        burst.style.display='none';
        showWin(t,false);
      },1900);
    },700);
  }
  function resetToPlay(){
    root.querySelector('.mps-play').style.display='';
    root.querySelector('.mps-win').style.display='none';
    document.getElementById('mps-burst').style.display='none';
    if(nextTimer){clearInterval(nextTimer);nextTimer=null;}
    if(expTimer){clearInterval(expTimer);expTimer=null;}
    clearErr();
    document.getElementById('mps-practflag').style.display=practice?'block':'none';
    updHud();startDrawing();
  }
  function setBtn(label,dropmode,disabled){pullBtn.innerHTML=label;pullBtn.className='mps-pull'+(dropmode?' dropmode':'');pullBtn.disabled=!!disabled;}
  var pullBtn=document.getElementById('mps-pull');
  function armPull(label){
    if(gateTimer){clearTimeout(gateTimer);gateTimer=null;}
    setBtn(label||'&#127809; START MY 3 FREE DROPS',false,true);
    gateTimer=setTimeout(function(){
      if(Date.now()>GAME_END){setBtn('GAME OVER',false,true);return;}
      if(MODE==='idle'&&(!playedToday()||practice)){pullBtn.disabled=false;}
    },1550);
  }
  function open(){
    root.removeAttribute('hidden');openedAt=Date.now();
    if(Date.now()>GAME_END){setBtn('GAME OVER',false,true);return;}
    if(MODE==='aiming'||MODE==='dropping'||MODE==='scoring'){startDrawing();return;}
    if(playedToday())practice=false;
    var tp=playedToday()?tierByCode(store().plays[today()]):null;
    if(tp&&!practice){showWin(tp,true);}
    else{
      var s=store();
      if(!practice&&s.run&&s.runDay===today()){
        run={drops:(s.run.drops||[]).slice(0)};
        if(s.run.pend){
          run.drops.push('forfeit');
          var s3=store();s3.run={drops:run.drops.slice(0)};save(s3);
        }
        MODE='idle';resetToPlay();
        if(run.drops.length>=3){finishRun();return;}
        armPull('&#127809; RESUME — DROP '+(run.drops.length+1)+' OF 3');
      }
      else{run={drops:[]};MODE='idle';resetToPlay();armPull(practice?'&#127919; START PRACTICE':undefined);}
    }
  }
  function close(){root.setAttribute('hidden','');stopDrawing();}
  var BADDOM=['mailinator.com','guerrillamail.com','10minutemail.com','tempmail.com','temp-mail.org','yopmail.com','trashmail.com','sharklasers.com','getnada.com','dispostable.com','maildrop.cc','fakeinbox.com','throwawaymail.com','mailnesia.com','tempmailo.com','moakt.com','emailondeck.com','mohmal.com','tempr.email','discard.email'];
  function postEmail(em){try{var b='form_type=customer&utf8=%E2%9C%93&contact%5Btags%5D=maple-slots&contact%5Bemail%5D='+encodeURIComponent(em);fetch('/contact',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:b}).catch(function(){});}catch(e){}}
  function showWin(t,replayView){
    if(!t)return;
    practice=false;
    if(expTimer){clearInterval(expTimer);expTimer=null;}
    stopDrawing();
    root.querySelector('.mps-play').style.display='none';
    root.querySelector('.mps-win').style.display='block';
    document.getElementById('mps-burst').style.display='none';
    document.getElementById('mps-we').innerHTML=t.k==='m40'?'🏆':'🎉';
    document.getElementById('mps-wt').textContent=(replayView?'Today you won ':'You won ')+t.name+'!';
    document.getElementById('mps-ws').textContent=t.sub;
    var stack=document.getElementById('mps-stack');
    stack.innerHTML=
      "<div class='mps-srow'><span class='se'>🍁</span><span>WIN #1 — <b>20% OFF EVERYTHING</b> storewide</span><span class='tag'>ACTIVE</span></div>"+
      "<div class='mps-srow'><span class='se'>🎯</span><span>WIN #2 — your drop: <b>"+(t.pct?'extra 5% off':(t.k==='ship'?'free express shipping':'$'+t.val+' off'))+"</b></span><span class='tag'>LOCKED IN</span></div>"+
      "<div class='mps-srow'><span class='se'>🚚</span><span>WIN #3 — <b>FREE EXPRESS SHIPPING</b> over $150</span><span class='tag'>ACTIVE</span></div>";
    var rows=stack.querySelectorAll('.mps-srow');
    for(var ri=0;ri<rows.length;ri++){(function(r,d){setTimeout(function(){r.className='mps-srow in';},replayView?10:(220+d*260));})(rows[ri],ri);}
    document.getElementById('mps-total').textContent='💰 '+t.stack;
    document.getElementById('mps-codeval').value=t.code;
    document.getElementById('mps-go').href='/discount/'+t.code+'?redirect=/collections/all';
    var exp=document.getElementById('mps-exp');
    var expFn=function(){var left=GAME_END-Date.now();if(left<=0){exp.textContent='Code expired.';clearInterval(expTimer);expTimer=null;return;}exp.innerHTML='⏳ Your code is live now and expires in <b>'+fmtDHMS(left)+'</b>';};
    expFn();expTimer=setInterval(expFn,1000);
    document.getElementById('mps-tease').textContent=t.k==='m40'?'You hit the edge bucket. Absolute legend.':'The 🍁 $40 JACKPOT lives in the edge buckets — tomorrow’s 3 free drops could land it.';
    var st=streak();
    document.getElementById('mps-streakbox').innerHTML=st>1?"<span class='mps-streak'>🔥 "+st+"-day streak</span>":'';
    var nx=document.getElementById('mps-next');
    var end=new Date();end.setHours(24,0,0,0);
    var lastDay=Date.now()>GAME_END-86400000;
    if(nextTimer){clearInterval(nextTimer);nextTimer=null;}
    if(lastDay){nx.innerHTML='That was the final day &mdash; thanks for playing Maple Drop! 🍁';}
    else{
      var tickFn=function(){
        var left=end.getTime()-Date.now();
        if(left<=0){
          clearInterval(nextTimer);nextTimer=null;
          MODE='idle';run={drops:[]};
          resetToPlay();armPull();
          var m=document.getElementById('mps-msg');if(m){msg('');m.style.color='#ffd76a';m.textContent='🍁 A new day — 3 fresh drops are ready!';msgTimer=setTimeout(function(){m.style.color='';m.textContent='';msgTimer=null;},6000);}
          return;
        }
        nx.innerHTML='3 more free drops in <b>'+fmtHMS(left)+'</b> &mdash; practice now, jackpot tomorrow';
      };
      tickFn();if(nextTimer===null&&root.querySelector('.mps-win').style.display==='block'){nextTimer=setInterval(tickFn,1000);}
    }
    var s=store(),w=document.getElementById('mps-wallet'),h='';
    if(s.plays){var days=[];for(var k in s.plays)if(s.plays.hasOwnProperty(k))days.push(k);days.sort();
      if(days.length>1){
        var banked=0;
        h="<p class='wl-t'>Your winnings this week</p>";
        for(var i=0;i<days.length;i++){var pp=tierByCode(s.plays[days[i]]);if(pp){banked+=pp.val;h+="<div class='mps-wrow'><span>"+days[i].slice(5).replace('-','/')+" &middot; "+pp.name+"</span><b>"+pp.code+"</b></div>";}}
        h+="<div class='mps-wrow' style='border-color:#d4ba6a'><span>💰 Codes banked this week</span><b>~$"+banked+" of value</b></div>";
      }
    }
    w.innerHTML=h;
  }
  /* --- main button: only used to START (drops happen by tapping the board) --- */
  function onMainBtn(){
    if(Date.now()>GAME_END){setBtn('GAME OVER',false,true);msg('Maple Drop has ended — thanks for playing!');return;}
    if(MODE!=='idle')return;
    if(practice){run={drops:[]};updHud();MODE='aiming';setBtn('&#127919; PRACTICE — TAP THE BOARD',true,true);return;}
    if(playedToday()){var pz=tierByCode(store().plays[today()]);if(pz){showWin(pz,true);return;}}
    var emEl=document.getElementById('mps-em');
    var hp=document.getElementById('mps-hp');if(hp&&hp.value)return;
    if(Date.now()-openedAt<1500){return;}
    var t=today();
    if(t<'2026-07-01'||t>'2026-07-07'){warn(emEl,'Maple Drop runs July 1 to 7 only');return;}
    var s=store();
    var em=(emEl.value||'').trim().toLowerCase();
    if(!em&&s.email)em=s.email;
    if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em)){warn(emEl,'Enter your email to unlock your drops');return;}
    if(BADDOM.indexOf(em.split('@')[1])>-1){warn(emEl,'Please use a real email');return;}
    var resuming=(s.run&&s.runDay===t);
    if(!resuming&&s.lastPullAt){
      if(Date.now()<s.lastPullAt-3600000){warn(emEl,'Device clock looks off — drops unavailable');return;}
      if(Date.now()-s.lastPullAt<600000){var wm=Math.max(1,Math.ceil((600000-(Date.now()-s.lastPullAt))/60000));warn(emEl,'Easy there, eh! Try again in '+wm+' min'+(wm>1?'utes':'ute')+'.');return;}
    }
    try{if(!resuming&&document.cookie.indexOf('ccSlots'+t.replace(/-/g,'')+'=1')>-1){warn(emEl,'You already dropped today — come back tomorrow, eh!');return;}}catch(e){}
    clearErr();
    var c=ac();if(c&&c.state==='suspended'){try{c.resume();}catch(e){}}
    if(!s.email){postEmail(em);}
    try{document.cookie='ccSlots'+t.replace(/-/g,'')+'=1;path=/;max-age=172800';}catch(e){}
    s.email=em;if(!resuming){s.runDay=t;s.run={drops:[]};}
    save(s);
    if(resuming){run={drops:(s.run.drops||[]).slice(0)};}
    updHud();
    MODE='aiming';
    setBtn('&#127809; TAP THE BOARD — DROP '+(run.drops.length+1)+' OF 3',true,true);
  }
  pullBtn.addEventListener('click',onMainBtn);
  function cvTap(e){
    if(MODE!=='aiming')return;
    var r=cv.getBoundingClientRect();
    var cx=(e.touches&&e.touches[0]?e.touches[0].clientX:e.clientX);
    var x=(cx-r.left)*(W/r.width);
    dropAt(x);
    if(e.cancelable)e.preventDefault();
  }
  cv.addEventListener('mousedown',cvTap);
  cv.addEventListener('touchstart',cvTap,{passive:false});
  document.getElementById('mps-pract').addEventListener('click',function(){
    practice=true;MODE='idle';run={drops:[]};
    resetToPlay();
    setBtn('&#127919; START PRACTICE',false,false);
  });
  document.getElementById('mps-em').addEventListener('input',clearErr);
  document.getElementById('mps-copy').addEventListener('click',function(){var v=document.getElementById('mps-codeval');try{v.select();document.execCommand('copy');}catch(e){}try{navigator.clipboard.writeText(v.value);}catch(e){}var b=this;b.textContent='Copied!';setTimeout(function(){b.textContent='Copy';},1600);});
  var cs=root.querySelectorAll('[data-close]');
  function doClose(){
    /* closing mid-fall: the ball finishes falling off-screen and that drop scores wherever it lands (sim continues), no re-rolls */
    close();
  }
  for(var i=0;i<cs.length;i++)cs[i].addEventListener('click',doClose);
  document.addEventListener('keydown',function(e){if(e.key==='Escape')doClose();});
  tab.addEventListener('click',open);
  document.addEventListener('ccOpenSlots',open);
  var s0=store();
  if(s0.email){document.getElementById('mps-em').value=s0.email;}
  updHud();
  try{if(!sessionStorage.getItem('mpsSeen')){sessionStorage.setItem('mpsSeen','1');setTimeout(open,3200);}}catch(e){}
})();
</script>
