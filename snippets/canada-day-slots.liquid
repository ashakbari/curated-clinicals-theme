<script>
(function(){
  var root=document.getElementById('mps'),tab=document.getElementById('mps-tab');if(!root||!tab)return;
  var GAME_END=new Date('2026-07-08T06:59:59Z').getTime();
  if(Date.now()>GAME_END){tab.style.display='none';return;}
  function dec(s){try{return atob(s);}catch(e){return '';}}
  var PRIZES=[
    {k:'m5',  c:'TUFQTEU1LUo3TA==',     combo:['🎁','⭐','🚚'], w:32, name:'5% off anything',       sub:'Applies to your whole order, on top of the 20% sale.'},
    {k:'ship',c:'TUFQTEVTSElQLVEyTg==', combo:['🚚','🚚','⭐'], w:22, name:'Free Express Shipping', sub:'On orders of $75 or more. Stacks with the sale.'},
    {k:'m10', c:'TUFQTEUxMC1YNFQ=',     combo:['💎','💎','⭐'], w:20, name:'$10 off',               sub:'On orders of $125 or more. Stacks with the sale.'},
    {k:'m15', c:'TUFQTEUxNS1COFc=',     combo:['⭐','⭐','⭐'], w:13, name:'$15 off',               sub:'On orders of $175 or more. Stacks with the sale.'},
    {k:'m25', c:'TUFQTEUyNS1SM0s=',     combo:['💎','💎','💎'], w:9,  name:'$25 off',               sub:'On orders of $250 or more. Stacks with the sale.'},
    {k:'m40', c:'TUFQTEU0MC1aOUY=',     combo:['🍁','🍁','🍁'], w:4,  name:'the $40 JACKPOT',       sub:'On orders of $300 or more. Our top prize, eh!'}
  ];
  for(var pi=0;pi<PRIZES.length;pi++){PRIZES[pi].code=dec(PRIZES[pi].c);}
  var SYMS=['🍁','💎','⭐','🚚','🎁','🧴'];
  var CELL=84,STRIPN=24;
  var reels=[document.getElementById('mps-r0'),document.getElementById('mps-r1'),document.getElementById('mps-r2')];
  var pullBtn=document.getElementById('mps-pull');
  function rnd(){try{var a=new Uint32Array(1);(window.crypto||window.msCrypto).getRandomValues(a);return a[0]/4294967296;}catch(e){return (new Date().getTime()%997)/997;}}
  function pick(){var t=0,i;for(i=0;i<PRIZES.length;i++)t+=PRIZES[i].w;var r=rnd()*t,acc=0;for(i=0;i<PRIZES.length;i++){acc+=PRIZES[i].w;if(r<acc)return PRIZES[i];}return PRIZES[0];}
  function buildStrip(el,target){
    var h='';
    for(var i=0;i<STRIPN;i++){
      var s;
      if(i===STRIPN-1){s=target;}
      else if(i===STRIPN-2){s='🍁';if(target==='🍁')s='💎';}
      else{s=SYMS[Math.floor(rnd()*SYMS.length)];}
      h+="<div class='mps-cell'>"+s+"</div>";
    }
    el.innerHTML=h;el.style.transition='none';el.style.transform='translateY(0px)';
  }
  function initIdle(){for(var i=0;i<3;i++){buildStrip(reels[i],SYMS[i]);reels[i].style.transform='translateY(-'+((STRIPN-1)*CELL)+'px)';}}
  initIdle();
  function store(){try{return JSON.parse(localStorage.getItem('ccSlots')||'{}');}catch(e){return {};}}
  function save(o){try{localStorage.setItem('ccSlots',JSON.stringify(o));}catch(e){}}
  function today(){var d=new Date();return d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2);}
  function playedToday(){var s=store();return !!(s.plays&&s.plays[today()]);}
  function prizeByCode(c){for(var i=0;i<PRIZES.length;i++)if(PRIZES[i].code===c)return PRIZES[i];return null;}
  function streak(){var s=store();if(!s.plays)return 0;var n=0,d=new Date();for(;;){var k=d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2);if(s.plays[k]){n++;d.setDate(d.getDate()-1);}else break;}return n;}
  var spinning=false,openedAt=0,nextTimer=null,gateTimer=null,msgTimer=null;
  function msg(t){var m=document.getElementById('mps-msg');if(!m)return;if(msgTimer){clearTimeout(msgTimer);msgTimer=null;}m.style.color='';m.textContent=t||'';}
  function clearErr(){var e=document.getElementById('mps-em');if(e)e.style.borderColor='';msg('');}
  function warn(el,text){el.focus();el.style.borderColor='#e01936';msg(text||'');}
  function resetToPlay(){
    root.querySelector('.mps-play').style.display='';
    root.querySelector('.mps-win').style.display='none';
    if(nextTimer){clearInterval(nextTimer);nextTimer=null;}
    initIdle();clearErr();
    var rows=document.querySelectorAll('#mps .mps-lrow');
    for(var j=0;j<rows.length;j++){rows[j].className='mps-lrow'+(rows[j].getAttribute('data-k')==='m40'?' hot':'');}
  }
  function armPull(){
    if(gateTimer){clearTimeout(gateTimer);gateTimer=null;}
    pullBtn.disabled=true;pullBtn.textContent='READY…';
    gateTimer=setTimeout(function(){
      if(Date.now()>GAME_END){pullBtn.disabled=true;pullBtn.textContent='GAME OVER';return;}
      if(!playedToday()&&!spinning){pullBtn.disabled=false;pullBtn.innerHTML='🍁 PULL';}
    },1550);
  }
  function open(){
    root.removeAttribute('hidden');openedAt=Date.now();
    if(Date.now()>GAME_END){pullBtn.disabled=true;pullBtn.textContent='GAME OVER';return;}
    var tp=playedToday()?prizeByCode(store().plays[today()]):null;
    if(tp){showWin(tp,true);}
    else{resetToPlay();armPull();}
  }
  function close(){root.setAttribute('hidden','');}
  var BADDOM=['mailinator.com','guerrillamail.com','10minutemail.com','tempmail.com','temp-mail.org','yopmail.com','trashmail.com','sharklasers.com','getnada.com','dispostable.com','maildrop.cc','fakeinbox.com','throwawaymail.com','mailnesia.com','tempmailo.com','moakt.com','emailondeck.com','mohmal.com','tempr.email','discard.email'];
  function postEmail(em){try{var b='form_type=customer&utf8=%E2%9C%93&contact%5Btags%5D=maple-slots&contact%5Bemail%5D='+encodeURIComponent(em);fetch('/contact',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:b}).catch(function(){});}catch(e){}}
  function confetti(){for(var i=0;i<44;i++){(function(){var s=document.createElement('div');s.className='mps-conf';s.innerHTML=rnd()<0.8?'🍁':'🎉';s.style.left=(rnd()*100)+'vw';var dur=2200+rnd()*2400,x=(rnd()*180-90);s.style.transition='transform '+dur+'ms linear, opacity '+dur+'ms linear';document.body.appendChild(s);requestAnimationFrame(function(){s.style.transform='translate('+x+'px,'+(window.innerHeight+90)+'px) rotate('+(rnd()*720-360)+'deg)';s.style.opacity='0';});setTimeout(function(){if(s.parentNode)s.parentNode.removeChild(s);},dur+90);})();}}
  function fmtHMS(ms){var s=Math.max(0,Math.floor(ms/1000));var h=Math.floor(s/3600);s-=h*3600;var m=Math.floor(s/60);s-=m*60;function p(n){return(n<10?'0':'')+n;}return p(h)+':'+p(m)+':'+p(s);}
  function showWin(p,replayView){
    if(!p)return;
    root.querySelector('.mps-play').style.display='none';
    root.querySelector('.mps-win').style.display='block';
    document.getElementById('mps-we').innerHTML=p.k==='m40'?'🏆':'🎉';
    document.getElementById('mps-wt').textContent=(replayView?'Today you won ':'You won ')+p.name+'!';
    document.getElementById('mps-ws').textContent=p.sub;
    document.getElementById('mps-codeval').value=p.code;
    document.getElementById('mps-go').href='/discount/'+p.code+'?redirect=/collections/all';
    var st=streak();
    document.getElementById('mps-streakbox').innerHTML=st>1?"<span class='mps-streak'>🔥 "+st+"-day streak</span>":'';
    var nx=document.getElementById('mps-next');
    var end=new Date();end.setHours(24,0,0,0);
    var lastDay=Date.now()>GAME_END-86400000;
    if(nextTimer){clearInterval(nextTimer);nextTimer=null;}
    if(lastDay){nx.innerHTML='That was the final day &mdash; thanks for playing Maple Slots! 🍁';}
    else{
      var tickFn=function(){
        var left=end.getTime()-Date.now();
        if(left<=0){
          clearInterval(nextTimer);nextTimer=null;
          resetToPlay();armPull();
          var m=document.getElementById('mps-msg');if(m){msg('');m.style.color='#ffd76a';m.textContent='🍁 A new day, a new free pull — go!';msgTimer=setTimeout(function(){m.style.color='';m.textContent='';msgTimer=null;},6000);}
          return;
        }
        nx.innerHTML='Next free pull in <b>'+fmtHMS(left)+'</b> &mdash; come back tomorrow, a bigger prize might be waiting';
      };
      tickFn();if(nextTimer===null&&root.querySelector('.mps-win').style.display==='block'){nextTimer=setInterval(tickFn,1000);}
    }
    var s=store(),w=document.getElementById('mps-wallet'),h='';
    if(s.plays){var days=[];for(var k in s.plays)if(s.plays.hasOwnProperty(k))days.push(k);days.sort();
      if(days.length>1){h="<p class='wl-t'>Your prize wallet</p>";for(var i=0;i<days.length;i++){var pp=prizeByCode(s.plays[days[i]]);if(pp)h+="<div class='mps-wrow'><span>"+days[i].slice(5).replace('-','/')+" &middot; "+pp.name+"</span><b>"+pp.code+"</b></div>";}}
    }
    w.innerHTML=h;
    var rows=document.querySelectorAll('#mps .mps-lrow');for(var j=0;j<rows.length;j++){rows[j].className='mps-lrow'+(rows[j].getAttribute('data-k')===p.k?' won':(rows[j].getAttribute('data-k')==='m40'?' hot':''));}
  }
  function spinReel(el,target,loopMs,done){
    buildStrip(el,SYMS[Math.floor(rnd()*SYMS.length)]);
    void el.offsetHeight;
    el.style.transition='transform '+loopMs+'ms linear';
    el.style.transform='translateY(-'+((STRIPN-1)*CELL)+'px)';
    setTimeout(function(){
      var h='',i;
      for(i=0;i<4;i++){h+="<div class='mps-cell'>"+SYMS[Math.floor(rnd()*SYMS.length)]+"</div>";}
      var near=(target==='🍁')?'💎':'🍁';
      h+="<div class='mps-cell'>"+near+"</div><div class='mps-cell'>"+target+"</div><div class='mps-cell'>"+SYMS[Math.floor(rnd()*SYMS.length)]+"</div>";
      el.style.transition='none';el.innerHTML=h;el.style.transform='translateY(0px)';
      void el.offsetHeight;
      el.style.transition='transform 640ms cubic-bezier(.22,.9,.35,1.12)';
      el.style.transform='translateY(-'+(5*CELL)+'px)';
      setTimeout(done,720);
    },loopMs);
  }
  function spinTo(p,done){
    var loops=[700,1350,2100],remaining=3;
    for(var i=0;i<3;i++){
      (function(i){
        spinReel(reels[i],p.combo[i],loops[i],function(){
          remaining--;
          if(i===2){var cab=document.getElementById('mps-cab');cab.className='mps-cab shake';setTimeout(function(){cab.className='mps-cab';},450);}
          if(remaining===0)done();
        });
      })(i);
    }
  }
  function doPull(){
    if(spinning)return;
    if(playedToday()){var pz=prizeByCode(store().plays[today()]);if(pz){showWin(pz,true);return;}}
    var emEl=document.getElementById('mps-em');
    if(Date.now()>GAME_END){pullBtn.disabled=true;pullBtn.textContent='GAME OVER';msg('Maple Slots has ended — thanks for playing!');return;}
    var hp=document.getElementById('mps-hp');if(hp&&hp.value)return;
    if(Date.now()-openedAt<1500){return;}
    var t=today();
    if(t<'2026-07-01'||t>'2026-07-07'){warn(emEl,'Maple Slots runs July 1 to 7 only');return;}
    var s=store();
    var em=(emEl.value||'').trim().toLowerCase();
    if(!em&&s.email)em=s.email;
    if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em)){warn(emEl,'Enter your email to pull');return;}
    if(BADDOM.indexOf(em.split('@')[1])>-1){warn(emEl,'Please use a real email');return;}
    if(s.lastPullAt){
      if(Date.now()<s.lastPullAt-3600000){warn(emEl,'Device clock looks off — pull unavailable');return;}
      if(Date.now()-s.lastPullAt<600000){var wm=Math.max(1,Math.ceil((600000-(Date.now()-s.lastPullAt))/60000));warn(emEl,'Easy there, eh! Try again in '+wm+' min'+(wm>1?'utes':'ute')+'.');return;}
    }
    try{if(document.cookie.indexOf('ccSlots'+t.replace(/-/g,'')+'=1')>-1){warn(emEl,'You already pulled today — come back tomorrow, eh!');return;}}catch(e){}
    spinning=true;clearErr();
    pullBtn.disabled=true;pullBtn.textContent='SPINNING…';
    if(!s.email){postEmail(em);}
    try{document.cookie='ccSlots'+t.replace(/-/g,'')+'=1;path=/;max-age=172800';}catch(e){}
    var p=pick();
    s.email=em;s.plays=s.plays||{};s.plays[t]=p.code;s.lastPullAt=Date.now();save(s);
    spinTo(p,function(){
      spinning=false;pullBtn.disabled=true;pullBtn.textContent='✓ PULLED TODAY';
      confetti();showWin(p,false);
    });
  }
  pullBtn.addEventListener('click',doPull);
  document.getElementById('mps-em').addEventListener('input',clearErr);
  document.getElementById('mps-copy').addEventListener('click',function(){var v=document.getElementById('mps-codeval');try{v.select();document.execCommand('copy');}catch(e){}try{navigator.clipboard.writeText(v.value);}catch(e){}var b=this;b.textContent='Copied!';setTimeout(function(){b.textContent='Copy';},1600);});
  var cs=root.querySelectorAll('[data-close]');for(var i=0;i<cs.length;i++)cs[i].addEventListener('click',close);
  document.addEventListener('keydown',function(e){if(e.key==='Escape')close();});
  tab.addEventListener('click',open);
  document.addEventListener('ccOpenSlots',open);
  var s0=store();
  if(s0.email){document.getElementById('mps-em').value=s0.email;}
  try{if(!sessionStorage.getItem('mpsSeen')){sessionStorage.setItem('mpsSeen','1');setTimeout(open,3200);}}catch(e){}
})();
</script>
