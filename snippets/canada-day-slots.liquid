    for(var r=0;r<2;r++){for(var j=0;j<NSTRIP;j++){h+="<div class='mps-cell'>"+this.syms[j]+"</div>";}}
    this.el.innerHTML=h;this.off=Math.floor(rnd()*NSTRIP)*CELL;this.paint();
  };
  Reel.prototype.paint=function(){this.el.style.transform='translateY(-'+this.off+'px)';};
  Reel.prototype.start=function(){
    if(this.running)return;this.running=true;this.last=0;this.lockIdx=null;
    var self=this;
    function frame(ts){
      if(!self.running)return;
      if(!self.last)self.last=ts;
      var dt=Math.min(50,ts-self.last);self.last=ts;
      self.off+=self.speed*dt/1000;
      if(self.off>=NSTRIP*CELL)self.off-=NSTRIP*CELL;
      self.paint();
      self.raf=requestAnimationFrame(frame);
    }
