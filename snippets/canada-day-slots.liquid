#mps .mps-pull.spinning{background:linear-gradient(180deg,#ff5a70,#e01936 45%,#8f0618);color:#fff;border-bottom-color:#5c0410;opacity:1;cursor:default;animation:mpsGlow 1s ease-in-out infinite}
#mps .mps-fine{font-size:10px;color:#7d715f;margin:8px 0 0;line-height:1.6}
#mps .mps-fine b{color:#c9a26a}
#mps-burst{position:absolute;inset:0;background:rgba(15,10,6,.92);border-radius:22px;display:none;align-items:center;justify-content:center;flex-direction:column;z-index:5;animation:mpsIn .25s ease}
#mps-burst .bw{font-size:15px;letter-spacing:5px;color:#ffd76a;font-weight:800;animation:mpsBlink .35s step-end infinite}
@keyframes mpsBlink{50%{opacity:.35}}
#mps-burst .bv{font-family:Georgia,serif;font-size:60px;color:#fff;font-weight:700;line-height:1.05;margin:8px 0 4px;text-shadow:0 0 24px rgba(255,215,106,.55);font-variant-numeric:tabular-nums}
#mps-burst .bn{font-size:14px;color:#d4ba6a;font-weight:800;letter-spacing:1px;padding:0 14px;line-height:1.4}
