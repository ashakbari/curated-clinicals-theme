      var f=Math.min(1,(ts-t0)/DUR);
      var e=1-Math.pow(1-f,2);
      self.off=startOff+dist*e;self.paint();
      if(f<1){self.raf=requestAnimationFrame(settle);}
      else{
        if(self.off>=NSTRIP*CELL){self.off-=NSTRIP*CELL;self.paint();}
        self.wrap.className='mps-reel pop';
        (function(w){setTimeout(function(){if(w.className==='mps-reel pop'){w.className='mps-reel';}},380);})(self.wrap);
