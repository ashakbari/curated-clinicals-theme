#mps .mps-win .we{font-size:52px;line-height:1}
#mps .mps-win .wt{font-family:Georgia,serif;font-size:24px;font-weight:700;margin:8px 0 4px;color:#ffd76a;line-height:1.2}
#mps .mps-win .ws{font-size:13px;color:#cbbfa8;margin:0 0 14px;line-height:1.5}
#mps .mps-code{display:flex;gap:8px;align-items:stretch;margin:0 0 6px}
#mps .mps-code input{flex:1;min-width:0;border:2px dashed #d4ba6a;border-radius:12px;background:#241c10;color:#ffd76a;font-weight:800;font-size:18px;text-align:center;letter-spacing:2px;padding:13px;font-family:inherit}
#mps .mps-code button{background:#d4ba6a;color:#241800;border:0;border-radius:12px;padding:0 16px;font-weight:800;cursor:pointer;font-size:13px}
#mps .mps-terms{font-size:10.5px;color:#7d715f;margin:0 0 12px;line-height:1.5}
#mps .mps-go{display:block;background:linear-gradient(90deg,#e01936,#b3081f);color:#fff;text-decoration:none;font-weight:800;padding:16px;border-radius:999px;font-size:16px;letter-spacing:.8px;box-shadow:0 5px 16px rgba(224,25,54,.35);animation:mpsGlow 1.6s ease-in-out infinite}
@keyframes mpsGlow{0%,100%{box-shadow:0 5px 16px rgba(224,25,54,.35)}50%{box-shadow:0 5px 26px rgba(224,25,54,.65)}}
#mps .mps-next{margin:12px 0 0;background:#0f0c09;border:1px dashed #4a3c28;border-radius:12px;padding:10px 12px;font-size:12.5px;color:#cbbfa8}
#mps .mps-next b{color:#d4ba6a;font-variant-numeric:tabular-nums;font-size:14px}
.mps-conf{position:fixed;top:-40px;z-index:100000;pointer-events:none;font-size:22px;will-change:transform,opacity}
</style>
<button id='mps-tab' type='button' aria-label='Spin the Maple Wheel'>
  <span class='g1'>&#127905;</span><span class='g2'>Maple Wheel</span><span class='g3'>WIN</span>
</button>
<div id='mps' hidden>
  <div class='mps-ov' data-close></div>
  <div class='mps-card' role='dialog' aria-modal='true' aria-label='The Maple Wheel — Canada Day game'>
    <button class='mps-x' type='button' data-close aria-label='Close'>&times;</button>
    <button class='mps-snd' type='button' id='mps-snd' aria-label='Toggle sound'>&#128266;</button>
